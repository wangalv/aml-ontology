# Copy this file to demo/.env and fill in what you use. demo/.env is git-ignored; never commit a real key.
#
# LLM_PROVIDER picks the model: mock (canned answers, the default), ollama (a model on this machine), zai (GLM API).
# The --llm option of run_demo.py overrides it for one run.
LLM_PROVIDER=mock

# ollama: the default model is qwen3.5:9b at http://localhost:11434
# OLLAMA_URL=http://localhost:11434
# LLM_MODEL=qwen3.5:9b

# zai (Z.ai / Zhipu GLM): same variable names as the AML Triage Demo
# Z_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Z_AI_API_KEY=
# Z_AI_CHAT_MODEL=

# Scenario 3 reads the transaction database of AML Triage Demo, read-only and never copied.
# AML_DB=/path/to/AML Triage Demo/data/features.duckdb
# The duckdb installed here may be older than the one that wrote that file; then name a Python that can read it:
# AML_DB_PYTHON=/path/to/AML Triage Demo/.venv/bin/python
