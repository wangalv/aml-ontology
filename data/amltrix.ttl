        amx:T0092,
        amx:T0143,
        amx:T0145.003 ;
    amlo:shortDescription "Cash-for-Gold Services enable customers to convert gold items into cash based on weight and purity, presenting a potential avenue for money laundering and illicit transactions due to the ease of liquidating valuable assets while bypassing traditional financial oversight."@en ;
    amlo:stixId "products-service--5fb24c14-a507-4f7e-85a8-61eb4671e94b" .

