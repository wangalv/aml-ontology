    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Unusual pattern of chip buy-ins and cash-outs predominantly during off-peak hours (e.g., early morning or late night), suggesting covert attempts to avoid scrutiny."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01207" ;
    skos:prefLabel "IND01207"@en ;
    amlo:stixId "x-amltrix-indicator--bfb84b47-a8e6-4fea-8eb7-fe552d40ba27" .

