    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Unauthorized or unexplained access by a public official or employee to critical financial systems or records beyond their typical job scope."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02537" ;
    skos:prefLabel "IND02537"@en ;
    amlo:stixId "x-amltrix-indicator--c25df133-29c3-433c-b84f-a0bb8413dcdf" .

