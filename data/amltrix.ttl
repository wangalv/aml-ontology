    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "All transactions are routed solely through professional intermediaries providing minimal due diligence documentation and invoking confidentiality clauses, obscuring beneficial ownership information."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02229" ;
    skos:prefLabel "IND02229"@en ;
    amlo:stixId "x-amltrix-indicator--5e0c5b08-685c-4f97-bb07-be7ac42a3b89" .

