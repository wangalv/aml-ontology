    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Excessive or unexplained intermediary service fees without a plausible business justification or service detail."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01077" ;
    skos:prefLabel "IND01077"@en ;
    amlo:stixId "x-amltrix-indicator--5f762ed7-a79c-4f54-a474-0b5944e492ef" .

