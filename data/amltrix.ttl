    dct:modified "2025-05-13T07:47:21.807873+00:00"^^xsd:dateTime ;
    skos:definition "Multiple merger or acquisition transactions occurring in rapid succession without clear operational integration or evidence of genuine business restructuring."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01975" ;
    skos:prefLabel "IND01975"@en ;
    amlo:stixId "x-amltrix-indicator--ae1533e3-b1af-425d-b6a7-09dcc60320a2" .

