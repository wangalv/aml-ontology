    amlo:mitigation amx:M0005 ;
    amlo:technique amx:T0143.002 .

<https://example.org/amltrix/link/79eaf6c5-8f9a-48ba-8c32-71ef8237fad6> a amlo:ProductServiceLink ;
    dct:description """- Enable rapid conversion between fiat and various cryptocurrencies, allowing criminals to exploit multiple currency pairs for layering.  
- Provide pseudonymous trading features that obscure the source and destination of illicit proceeds by cycling funds through different digital assets."""@en ;
