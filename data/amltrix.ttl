    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01406" ;
    skos:prefLabel "IND01406"@en ;
    amlo:stixId "x-amltrix-indicator--b99f4df2-ab8d-4429-9080-71659c231b79" .

