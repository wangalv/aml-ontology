    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02134" ;
    skos:prefLabel "IND02134"@en ;
    amlo:stixId "x-amltrix-indicator--42a263ad-1b96-4c06-89e3-d039d18aab9d" .

