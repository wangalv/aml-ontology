    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Large volumes of payments are recorded solely under the aggregator’s name with no itemized sub-agent or final customer details, hindering beneficial ownership transparency."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02132" ;
    skos:prefLabel "IND02132"@en ;
    amlo:stixId "x-amltrix-indicator--9e3928a1-c6ef-4ac2-a8bf-0952595bac9a" .

