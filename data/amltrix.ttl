    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Frequent logins from multiple inconsistent or proxy-assigned IP addresses are observed when accessing mining platforms, challenging the geographic consistency of the operations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01334" ;
    skos:prefLabel "IND01334"@en ;
    amlo:stixId "x-amltrix-indicator--465be904-bfc0-49cf-bb66-573f03521bde" .

