    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Repeated cash or deposit transactions consistently structured below official reporting thresholds in rapid succession, bypassing mandatory reporting triggers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01341" ;
    skos:prefLabel "IND01341"@en ;
    amlo:stixId "x-amltrix-indicator--db4d4bf3-a9ba-4dda-8580-fd55e4eb0e42" .

