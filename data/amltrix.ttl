    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00051" ;
    skos:prefLabel "IND00051"@en ;
    amlo:stixId "x-amltrix-indicator--ff1822aa-efcb-40ff-8428-7fbac13e670f" .

