    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00504" ;
    skos:prefLabel "IND00504"@en ;
    amlo:stixId "x-amltrix-indicator--ff3da6c3-19f5-414e-84e6-69b530fa80ae" .

