    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Invoices with values significantly higher or lower than the known market value for similar goods."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02599" ;
    skos:prefLabel "IND02599"@en ;
    amlo:stixId "x-amltrix-indicator--15966d4a-1507-49b6-9797-41255f1d7461" .

