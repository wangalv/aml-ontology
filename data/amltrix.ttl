    amlo:dataSource amx:DS0020 ;
    amlo:technique amx:T0090 .

<https://example.org/amltrix/link/77321f98-072f-4c72-ad25-74de5dc6e3c9> a amlo:ProductServiceLink ;
    dct:description """- Criminals with covert control of a bank can rapidly approve or overlook compliance checks for new business accounts.  
