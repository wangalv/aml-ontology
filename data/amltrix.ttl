    amlo:productService amx:PS0005 ;
    amlo:technique amx:T0086 .

<https://example.org/amltrix/link/5e476d29-293a-444c-a577-8c8f71ac70d3> a amlo:DataSourceLink ;
    dct:description "Validates the authenticity and integrity of digital identification documents submitted during account setup or ownership changes. Identifying forged or inconsistent documentation helps expose fictitious owners and online-only corporate setups."@en ;
    amlo:dataSource amx:DS0027 ;
    amlo:technique amx:T0127 .

<https://example.org/amltrix/link/5e5023b1-132e-474b-8df8-619240ca780d> a amlo:DataSourceLink ;
    dct:description "Aggregated records from media sources and official legal documents (e.g., court filings, lawsuits) highlight potential controversies or suspicious arbitration cases. These sources help detect repeated questionable settlements, verify inconsistencies in claimed disputes, and uncover negative patterns associated with arbitration participants, indicating possible manipulation of awards for money laundering."@en ;
    amlo:dataSource amx:DS0003 ;
    amlo:technique amx:T0046 .

<https://example.org/amltrix/link/5e5b2046-5b6e-445c-a079-e70e551fcb4a> a amlo:ProductServiceLink ;
    dct:description """- Enable criminals to receive and store proceeds from counterfeit medicine sales under pseudonymous or weakly verified accounts. 
