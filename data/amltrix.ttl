    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Adverse media reports or public records linking the professional or firm to alleged criminal or regulatory violations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02224" ;
    skos:prefLabel "IND02224"@en ;
    amlo:stixId "x-amltrix-indicator--d3123e94-9f39-4ab0-8f0b-6423e4d42dcf" .

