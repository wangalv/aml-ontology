    rdfs:seeAlso <https://framework.amltrix.com/actors/AT0064> ;
    skos:definition "Individuals or services that physically transport currency or monetary instruments on behalf of clients, often across borders or between locations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "AT0064" ;
    skos:prefLabel "Cash Courier"@en ;
