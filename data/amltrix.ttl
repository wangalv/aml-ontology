    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "A cluster of newly created wallet addresses, each with minimal or no prior history, is used solely to redirect small portions of the funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01032" ;
    skos:prefLabel "IND01032"@en ;
    amlo:stixId "x-amltrix-indicator--e8c6ca25-09ab-4a57-8d90-2162ffaacdf2" .

amx:IND01033 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Following multiple layering steps with micro-transactions, funds are consolidated and eventually transferred to an exchange, mixer, or fiat onramp."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01033" ;
    skos:prefLabel "IND01033"@en ;
    amlo:stixId "x-amltrix-indicator--8f3565fe-a92b-4eb0-b300-a9f212079e98" .

amx:IND01034 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "The initial deposit is traced to a compromised exchange or otherwise illicit source, indicating the potential involvement of stolen or fraudulent funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01034" ;
    skos:prefLabel "IND01034"@en ;
    amlo:stixId "x-amltrix-indicator--a7808e64-5bc5-4012-a996-aab3eff53d04" .

