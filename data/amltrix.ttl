    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Abrupt shifts in intermediary usage, including engagement of unverified or lesser-known brokers without a clear commercial justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01083" ;
    skos:prefLabel "IND01083"@en ;
    amlo:stixId "x-amltrix-indicator--6f2ed614-ad0b-447a-814b-9e968e5a2338" .

