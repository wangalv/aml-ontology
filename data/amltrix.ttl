    skos:definition "Investment vehicles that pool funds from multiple investors to invest in a diversified portfolio of assets. Managed by professional fund managers, these schemes include mutual funds, unit trusts, and closed-end funds, offering diversification and professional expertise."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "PS0126" ;
