    rdfs:seeAlso <https://framework.amltrix.com/services-products/PS0088> ;
    skos:definition "A financial service that provides funding to businesses to optimize their supply chain operations. It involves leveraging technology and financial processes to improve cash flow by enabling extended payment terms for buyers and offering suppliers the option for early payment."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "PS0088" ;
    skos:prefLabel "Supply Chain Financing"@en ;
