    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "The company routes funds through offshore jurisdictions with limited transparency or regulatory oversight."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01054" ;
    skos:prefLabel "IND01054"@en ;
    amlo:stixId "x-amltrix-indicator--d321cef3-28cb-4517-8976-28c6e9759784" .

