    skos:definition "Company representatives provide incomplete or inconsistent documentation when asked to substantiate listed liabilities to purported creditors."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00771" ;
    skos:prefLabel "IND00771"@en ;
    amlo:stixId "x-amltrix-indicator--84a6ea14-6b3b-4862-8449-c1666c090e6c" .

