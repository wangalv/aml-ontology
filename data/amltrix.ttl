    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or high-value advanced payment clauses (e.g., red or green clause LCs) that surpass typical pre-shipment costs without supporting production or purchase documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02100" ;
    skos:prefLabel "IND02100"@en ;
    amlo:stixId "x-amltrix-indicator--594687d3-fc20-4891-b336-9ab20da88402" .

