    amlo:shortDescription "Cryptocurrency ATMs are self-service kiosks enabling rapid conversion between fiat currency and digital assets, making them a potential conduit for illicit fund movement if not appropriately monitored and controlled."@en ;
    amlo:stixId "products-service--7c41da84-e751-4648-ad10-08e1353e03a2" .

amx:PS0121 a amlo:ProductService ;
    dct:created "2025-05-13T07:47:20.080536+00:00"^^xsd:dateTime ;
