    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Network analysis revealing clusters of interlinked blockchain addresses consistently engaging in cross-chain wrapping, indicating a systematic layering or obfuscation scheme."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
