    amlo:stixId "x-amltrix-indicator--8b5b93dc-f38b-468d-8007-b38624648c39" .

amx:IND02054 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.808486+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.808486+00:00"^^xsd:dateTime ;
    skos:definition "Frequent discrepancies between declared shipping routes or quantities in letters of credit and independently sourced logistics or customs data."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02054" ;
    skos:prefLabel "IND02054"@en ;
    amlo:stixId "x-amltrix-indicator--44d13c88-5deb-4d25-a773-7b24f267ec04" .

amx:IND02055 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.808486+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.808486+00:00"^^xsd:dateTime ;
    skos:definition "Reliance on financial instruments issued by poorly regulated offshore institutions lacking transparent history or publicly verifiable records of operation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02055" ;
    skos:prefLabel "IND02055"@en ;
    amlo:stixId "x-amltrix-indicator--0175404f-7474-41dd-bfc9-d6003074ba52" .

amx:IND02056 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.808486+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.808486+00:00"^^xsd:dateTime ;
    skos:definition "Physical checks or promissory notes exhibit visible alterations such as overwritten amounts or changed payee details that conflict with official issuance records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02056" ;
    skos:prefLabel "IND02056"@en ;
    amlo:stixId "x-amltrix-indicator--0a55134f-e39e-41a2-85b8-25949d46da06" .

amx:IND02057 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.808486+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.808486+00:00"^^xsd:dateTime ;
    skos:definition "Involvement of jurisdictions known for weak AML regulations or secrecy laws in transaction chains."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02057" ;
    skos:prefLabel "IND02057"@en ;
    amlo:stixId "x-amltrix-indicator--d3be5d79-ade5-464b-9902-bf4d2fa1dc84" .

amx:IND02058 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.808486+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.808486+00:00"^^xsd:dateTime ;
    skos:definition "Transactions involving jurisdictions with no apparent business relationship or customer presence."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02058" ;
    skos:prefLabel "IND02058"@en ;
    amlo:stixId "x-amltrix-indicator--7187d07d-11bd-4f71-8433-8bf7813c616f" .

amx:IND02059 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Sudden changes in transaction patterns, such as increased international activity, without clear rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02059" ;
    skos:prefLabel "IND02059"@en ;
    amlo:stixId "x-amltrix-indicator--4ea33630-10a7-4bdd-8ac7-3c12012537d4" .

amx:IND02060 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Frequent cross-asset bridging or 'chain hopping' of digital assets across multiple blockchain networks within short intervals."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02060" ;
    skos:prefLabel "IND02060"@en ;
    amlo:stixId "x-amltrix-indicator--060289a7-cbb9-4687-ac5a-c30d957d770f" .

amx:IND02061 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Use of off-chain or Layer 2 solutions (e.g., Lightning Network) to facilitate high-volume micro-transactions that are not visible on main blockchain ledgers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02061" ;
    skos:prefLabel "IND02061"@en ;
    amlo:stixId "x-amltrix-indicator--cc130937-c8a3-4cbf-9eea-5e529f0c67b1" .

amx:IND02062 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Splitting large sums into multiple small ‘peel chain’ transactions across several digital wallets to avoid detection thresholds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02062" ;
    skos:prefLabel "IND02062"@en ;
    amlo:stixId "x-amltrix-indicator--60917602-d22c-41e2-9276-070560b2f86f" .

amx:IND02063 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Large or irregular payments classified as lobbying fees or campaign donations that significantly deviate from standard industry norms or the organization’s historical spending patterns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02063" ;
    skos:prefLabel "IND02063"@en ;
    amlo:stixId "x-amltrix-indicator--d3c95579-d161-41bb-9ecc-c79905150460" .

amx:IND02064 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Transactions routed through intermediaries or shell entities purportedly for lobbying services, with no evidence of legitimate lobbying activity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02064" ;
    skos:prefLabel "IND02064"@en ;
    amlo:stixId "x-amltrix-indicator--6aebda8e-18d4-425b-bdf4-3ec6cb9f3033" .

amx:IND02065 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "A sudden surge in lobbying-related financial transactions by an entity with no prior history of government or political advocacy."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02065" ;
    skos:prefLabel "IND02065"@en ;
    amlo:stixId "x-amltrix-indicator--5c889c78-77e8-4a4b-943b-0c98dcc7eb08" .

amx:IND02066 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Inconsistencies between lobbying expense documentation and measurable evidence of lobbying activities, such as attendance at governmental meetings or hearings."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02066" ;
    skos:prefLabel "IND02066"@en ;
    amlo:stixId "x-amltrix-indicator--3958dd66-505c-415f-940a-4a8e8a578e44" .

amx:IND02067 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Frequent switching of lobbying service providers, particularly to newly established or atypical firms with minimal verifiable track records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02067" ;
    skos:prefLabel "IND02067"@en ;
    amlo:stixId "x-amltrix-indicator--85d0172f-d4e5-4724-a1a0-89cc25af0c07" .

amx:IND02068 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Lobbying fees or campaign donations that are disproportionately high relative to the organization's size or operational scope, lacking credible documentation to justify such expenses."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02068" ;
    skos:prefLabel "IND02068"@en ;
    amlo:stixId "x-amltrix-indicator--1c575e67-baeb-4077-9b1c-9e0b0c71b594" .

amx:IND02069 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Multiple campaign donations made by individuals affiliated with the same organization, correlated with reimbursements from a single source, lacking legitimate explanation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02069" ;
    skos:prefLabel "IND02069"@en ;
    amlo:stixId "x-amltrix-indicator--69b4fb7e-dd8f-4b92-92d4-1390cb764596" .

amx:IND02070 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "A pattern of short holding periods in investor accounts with swift withdrawals or reinvestments, indicating artificially maintained liquidity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02070" ;
    skos:prefLabel "IND02070"@en ;
    amlo:stixId "x-amltrix-indicator--2e9c9fd0-52b3-4ac6-9a26-1a1b11f41080" .

amx:IND02071 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Customer due diligence reveals investor profiles with large, unexplained investments that do not match their verified income sources or financial backgrounds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02071" ;
    skos:prefLabel "IND02071"@en ;
    amlo:stixId "x-amltrix-indicator--8ae134e7-5009-472b-9033-bac2a806c5cf" .

amx:IND02072 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Inadequate or unverifiable source of funds in investor documentation, particularly when large sums are involved in schemes promising unusually high returns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02072" ;
    skos:prefLabel "IND02072"@en ;
    amlo:stixId "x-amltrix-indicator--433b7afe-a841-4dae-89c0-a6221f7397f0" .

amx:IND02073 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "A heavy reliance on investor referrals and continuous recruitment, as evidenced by linked accounts and network marketing patterns, to sustain the payout cycle."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02073" ;
    skos:prefLabel "IND02073"@en ;
    amlo:stixId "x-amltrix-indicator--0bdc761b-5f49-42d3-9591-0f9702f3f2e4" .

amx:IND02074 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Lack of transparent, audited financial statements or documented investment plans during the customer onboarding process, with no reasonable justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02074" ;
    skos:prefLabel "IND02074"@en ;
    amlo:stixId "x-amltrix-indicator--0ba63e98-9a27-4143-b798-dc55093b377c" .

amx:IND02075 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Frequent inter-account transfers or movement of funds to shell or unverified entities, indicating layering to obscure ultimate beneficiaries."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02075" ;
    skos:prefLabel "IND02075"@en ;
    amlo:stixId "x-amltrix-indicator--53f3eb83-44fe-459c-9710-5f0ffe4dd357" .

amx:IND02076 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Premium payments originate from multiple high-risk or secrecy jurisdictions with minimal regulatory oversight."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02076" ;
    skos:prefLabel "IND02076"@en ;
    amlo:stixId "x-amltrix-indicator--4bfb6f10-6cc8-4964-ad08-4e04b88c5baa" .

amx:IND02077 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Inconsistent or difficult-to-verify identification documents or personal information for the policyholder."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02077" ;
    skos:prefLabel "IND02077"@en ;
    amlo:stixId "x-amltrix-indicator--67a40c73-19da-4f95-b980-36cccd07b1cc" .

amx:IND02078 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "The policy is surrendered or matures shortly after purchase, especially if the payout significantly exceeds the premiums paid or if initial premiums were made by third parties."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02078" ;
    skos:prefLabel "IND02078"@en ;
    amlo:stixId "x-amltrix-indicator--a462fd7e-362c-4580-ae88-069cce5be32a" .

amx:IND02079 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Use of complex or layered ownership structures or multiple intermediaries for premium payments without a transparent legitimate reason."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02079" ;
    skos:prefLabel "IND02079"@en ;
    amlo:stixId "x-amltrix-indicator--04b0d4cd-e15d-4ef6-bb3a-9011ddd14d65" .

amx:IND02080 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Unusual or unexplained involvement of intermediaries in the payment process, such as brokers or agents not typically associated with the policyholder."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02080" ;
    skos:prefLabel "IND02080"@en ;
    amlo:stixId "x-amltrix-indicator--deb0d195-8a3a-47ea-b7fa-cf5167011aed" .

amx:IND02081 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Large lump-sum premium payments that exceed the policyholder's known financial capacity or stated profile."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02081" ;
    skos:prefLabel "IND02081"@en ;
    amlo:stixId "x-amltrix-indicator--2a7ff6d1-ab6c-44b7-add0-13f9a3875c8e" .

amx:IND02082 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Frequent changes in the payer of insurance premiums during the policy term, especially involving unrelated third parties or lacking a legitimate business rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02082" ;
    skos:prefLabel "IND02082"@en ;
    amlo:stixId "x-amltrix-indicator--5199be9e-a9cb-439e-a435-908f6cb23638" .

amx:IND02083 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Submission of trade finance applications with minimal or no supporting shipment details such as bills of lading or cargo insurance."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02083" ;
    skos:prefLabel "IND02083"@en ;
    amlo:stixId "x-amltrix-indicator--af93b08c-9820-43c3-81d2-c63dc066c9be" .

amx:IND02084 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Insurance policy payouts directed to accounts in jurisdictions different from where the premiums were originally paid."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02084" ;
    skos:prefLabel "IND02084"@en ;
    amlo:stixId "x-amltrix-indicator--0876b6fb-e0fa-4bb8-8f27-c6b015df237b" .

amx:IND02085 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Documents submitted for trade finance that appear fictitious or inconsistent with the claimed trade transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02085" ;
    skos:prefLabel "IND02085"@en ;
    amlo:stixId "x-amltrix-indicator--90b26e5e-cee4-4180-9d5b-d90df70621cd" .

amx:IND02086 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Use of multiple intermediaries or jurisdictions to process insurance premium payments, complicating the traceability of funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02086" ;
    skos:prefLabel "IND02086"@en ;
    amlo:stixId "x-amltrix-indicator--3742cbe2-28de-415c-b6e9-cc56bf20e7a7" .

amx:IND02087 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Frequent amendments to letters of credit or changes in beneficiaries without clear commercial reasons."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02087" ;
    skos:prefLabel "IND02087"@en ;
    amlo:stixId "x-amltrix-indicator--f10485e2-859c-4e03-9bbc-3c801a301c54" .

amx:IND02088 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Absence of a clear and legitimate source of funds for premium payments, especially when made by third parties."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02088" ;
    skos:prefLabel "IND02088"@en ;
    amlo:stixId "x-amltrix-indicator--b129e563-0881-4c30-b608-5983616b692c" .

amx:IND02089 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Funds from trade finance facilities are quickly moved between accounts or banks without payments to legitimate suppliers or shipping lines."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02089" ;
    skos:prefLabel "IND02089"@en ;
    amlo:stixId "x-amltrix-indicator--d2ef4e0a-a0dd-4dd3-af8f-28f18055672c" .

amx:IND02090 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Repayments to the financing bank originate from entities unrelated to the declared buyer or seller in the trade transaction."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02090" ;
