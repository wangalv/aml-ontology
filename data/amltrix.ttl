    amlo:dataSource amx:DS0011 ;
    amlo:technique amx:T0061.003 .

<https://example.org/amltrix/link/0aaa3b87-53c9-4cde-b889-6e85078b4781> a amlo:MitigationLink ;
    dct:description "Enforce strong authentication, such as multi-factor authentication or biometrics, combined with continuous IP monitoring to flag repeated usage of anonymizing networks. Users connecting from Tor or VPN endpoints should trigger an immediate challenge-response or step-up verification to ensure genuine account control despite IP masking."@en ;
    amlo:mitigation amx:M0008 ;
    amlo:technique amx:T0015.005 .

<https://example.org/amltrix/link/0acbfd4c-3b9f-4092-99ba-a72da8911a69> a amlo:ActorLink ;
    dct:description """Corrupt facilitators in government expedite fraudulent subsidy approvals by:

