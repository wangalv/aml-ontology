    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Significant escalation in personal wealth or lifestyle of a public official or PEP, not aligned with their officially declared income sources."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02531" ;
    skos:prefLabel "IND02531"@en ;
    amlo:stixId "x-amltrix-indicator--4974fd51-24cb-49e1-b9a3-5f2cc0957432" .

amx:IND02532 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Deliberate alteration or falsification of official financial records or statements by a public official or employee with budgetary responsibilities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02532" ;
    skos:prefLabel "IND02532"@en ;
    amlo:stixId "x-amltrix-indicator--08b323dd-61c7-442c-a1e7-e282e9575929" .

amx:IND02533 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Use of multiple personal or third-party accounts by a public official or PEP to transfer or receive public funds, particularly if the accounts are opened at different institutions or under varied identities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02533" ;
    skos:prefLabel "IND02533"@en ;
    amlo:stixId "x-amltrix-indicator--8aa7b021-67d0-4f2f-bd7e-7d08f4dc15de" .

amx:IND02534 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Concentration of authority over large or sensitive public fund transactions in a single official or employee, circumventing standard oversight protocols."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02534" ;
    skos:prefLabel "IND02534"@en ;
    amlo:stixId "x-amltrix-indicator--8d64b63e-7ad5-4be3-9d23-ac96dc291368" .

