<https://example.org/amltrix/link/7f350555-51cf-4bb6-9899-ab72ba918767> a amlo:DataSourceLink ;
    dct:description "Consolidates negative news articles, legal actions, and court documents, revealing known or alleged involvement in counterfeit trade, relevant criminal proceedings, or regulatory violations."@en ;
    amlo:dataSource amx:DS0003 ;
    amlo:technique amx:T0143.003 .

<https://example.org/amltrix/link/7f38c03d-a6ba-4b71-b444-f29b74be7f5f> a amlo:MitigationLink ;
    dct:description "Review and validate shipping records, invoices, and declared values for cultural artifacts by comparing them against industry references and recognized market data to identify inconsistencies or grossly inflated or deflated valuations. This includes scrutinizing shipping routes, free trade zones, and multiple intermediary transactions for signs of trade-based money laundering, such as misdeclared origins or multiple abrupt changes in ownership."@en ;
    amlo:mitigation amx:M0026 ;
    amlo:technique amx:T0007.001 .

<https://example.org/amltrix/link/7f3e135d-580e-461b-8ff5-135ff6eb36f1> a amlo:RiskLink ;
