    dct:modified "2025-05-13T07:47:21.800681+00:00"^^xsd:dateTime ;
    skos:definition "Campaigns that provide vague or inconsistent narratives and minimal supporting documentation, lacking evidence of a legitimate cause or beneficiary."@en ;
