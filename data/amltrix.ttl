    dct:modified "2025-05-13T07:47:21.790245+00:00"^^xsd:dateTime ;
    skos:definition "Frequent short-selling and share-lending transactions executed immediately before dividend record dates, followed by rapid liquidation upon dividend receipt."@en ;
