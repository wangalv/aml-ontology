    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Discrepancies between the value of goods declared in documents and typical market prices for those goods."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00747" ;
    skos:prefLabel "IND00747"@en ;
    amlo:stixId "x-amltrix-indicator--e4299e1d-6ef9-49db-8552-12802a93ce13" .

