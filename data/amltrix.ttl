    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Reported revenues or agricultural yields deviate significantly from local or regional benchmarks, or exhibit profit swings not explained by typical weather patterns or market conditions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00732" ;
    skos:prefLabel "IND00732"@en ;
    amlo:stixId "x-amltrix-indicator--db10061c-c74a-41b7-b24f-0f7f4219cc27" .

amx:IND00733 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Repeated inbound transfers from payers referencing social media job offers or quick-income opportunities in payment details, followed by immediate onward transfers to unrelated recipients."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00733" ;
    skos:prefLabel "IND00733"@en ;
    amlo:stixId "x-amltrix-indicator--e877177e-cf55-4151-b138-f2a39845a6f6" .

amx:IND00734 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Account holder claims to have been recruited via a social media contact to receive and forward funds yet cannot provide legitimate employment or contract documentation supporting these transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00734" ;
    skos:prefLabel "IND00734"@en ;
    amlo:stixId "x-amltrix-indicator--c24a3e14-c0ef-451a-986b-3699ac6e2eca" .

amx:IND00735 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Agribusiness locations are established in remote or unproductive areas with minimal evidence of actual farming, or use 'virtual offices' lacking real farmland presence."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00735" ;
    skos:prefLabel "IND00735"@en ;
    amlo:stixId "x-amltrix-indicator--25723ea0-08f3-4fa4-9519-dd987d565dbc" .

amx:IND00736 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Inadequate or non-existent due diligence for newly introduced high-value customers or business partners following ownership changes."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00736" ;
    skos:prefLabel "IND00736"@en ;
    amlo:stixId "x-amltrix-indicator--cafd37be-9bb5-47af-974e-9548ef4425ac" .

amx:IND00737 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Multiple inbound payments labeled as 'timeshare resale', 'exit fee', or 'marketing fee' received from different individuals, with no matching outflows to legitimate real estate or closing services."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00737" ;
    skos:prefLabel "IND00737"@en ;
    amlo:stixId "x-amltrix-indicator--e5dca38a-3908-4d2f-8511-fe73b1a973e9" .

amx:IND00738 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Discrepancies in shipping documents (e.g., bills of lading, declared routes, quantity, product type) that conflict with standard agricultural logistics or trade practices."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00738" ;
    skos:prefLabel "IND00738"@en ;
    amlo:stixId "x-amltrix-indicator--7ac5dece-6855-4c0f-b5b9-8217b5b2456c" .

amx:IND00739 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Complex, layered ownership structures across multiple companies or beneficial owners in high-risk or secrecy jurisdictions, obscuring ultimate beneficial ownership."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00739" ;
    skos:prefLabel "IND00739"@en ;
    amlo:stixId "x-amltrix-indicator--9085b33c-43cb-4b2f-ac0c-9bc1a7d3c055" .

amx:IND00740 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or large government subsidy payments incongruent with actual agribusiness activity, often followed by large outgoing transfers from subsidy-related accounts."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00740" ;
    skos:prefLabel "IND00740"@en ;
    amlo:stixId "x-amltrix-indicator--8b9968a0-c5ad-4318-89d0-790edfb8e875" .

amx:IND00741 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Complex transaction structures with multiple layers of transfers that lack economic justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00741" ;
    skos:prefLabel "IND00741"@en ;
    amlo:stixId "x-amltrix-indicator--a1046e2a-eddf-4ade-9863-a2080b10cceb" .

amx:IND00742 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or high-volume cash deposits into agribusiness accounts that are not aligned with typical local agricultural sales or revenue flows."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00742" ;
    skos:prefLabel "IND00742"@en ;
    amlo:stixId "x-amltrix-indicator--da0fc964-b44f-435b-adc4-3f812f28e13d" .

amx:IND00743 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Frequent gaps, contradictions, or missing documentation in financial audits or production reports, hindering verification of actual farming activities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00743" ;
    skos:prefLabel "IND00743"@en ;
    amlo:stixId "x-amltrix-indicator--a1907442-4150-4804-accd-2e162420829c" .

