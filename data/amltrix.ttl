    skos:definition "Fundraising efforts are conducted on social media platforms with minimal identity verification, allowing the rapid creation of multiple donation campaigns under various aliases for the same beneficiary."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
