    amlo:productService amx:PS0014 ;
    amlo:technique amx:T0145 .

<https://example.org/amltrix/link/8c994859-fec1-4213-8fa0-1042ea699b3a> a amlo:DataSourceLink ;
    dct:description """- Lists licensed money remitters, exchange houses, and payment service providers, including licensing status and operational details.
- Reveals whether agents in multiple jurisdictions operate under valid MSB licenses or function illegally.
- Supports investigations by cross-referencing suspicious remittance patterns with noncompliant or unregistered MSB entities."""@en ;
    amlo:dataSource amx:DS0029 ;
    amlo:technique amx:T0121.001 .

<https://example.org/amltrix/link/8ca0bb7a-d8d9-4546-af2c-eb4b153d3911> a amlo:MitigationLink ;
    dct:description "Scrutinize trade documentation, invoices, and shipping details for inconsistencies in declared goods, unusual or manipulated pricing, mislabeling of commodities, or transit through high-risk jurisdictions known for smuggling. By applying anomaly detection to invoice values and shipping routes, financial institutions can identify trade-based money laundering tactics commonly used in commodity trafficking."@en ;
    amlo:mitigation amx:M0026 ;
    amlo:technique amx:T0143 .

<https://example.org/amltrix/link/8ca18d69-80a9-4bff-8b7c-4761c2f4c147> a amlo:DataSourceLink ;
    dct:description """- Presents formal ownership data for legal entities and beneficial owners.
