    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Transactions involving counterparties in high-risk jurisdictions or with mismatched business addresses where invoiced values are inconsistent with the economic substance of the trade."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01020" ;
    skos:prefLabel "IND01020"@en ;
    amlo:stixId "x-amltrix-indicator--e656b051-3941-40e8-9d1c-e1e782e99fbb" .

