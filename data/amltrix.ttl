    amlo:technique amx:T0061.001 .

<https://example.org/amltrix/link/b5803c11-d152-4269-81b0-b1922cd1f966> a amlo:InstrumentLink ;
    dct:description """- Criminals establish merchant or business bank accounts linked to their e-commerce storefronts to receive proceeds from sham sales, inflated refunds, or fabricated orders.
