    rdfs:seeAlso <https://framework.amltrix.com/actors/AT0014> ;
    skos:definition "An individual or group engaged in illegal cyber activities primarily for financial gain, which can involve targeting financial institutions or their customers to obtain or launder illicit funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "AT0014" ;
