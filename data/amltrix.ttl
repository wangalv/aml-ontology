    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Frequent involvement of newly formed or non-operational legal entities with undisclosed beneficial ownership in trade transactions featuring questionable invoices."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01019" ;
    skos:prefLabel "IND01019"@en ;
    amlo:stixId "x-amltrix-indicator--c1fa09fb-c5f4-4e2f-baa9-5627b95a8bbd" .

