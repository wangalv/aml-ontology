    amlo:tactic amx:ML.TA0009 ;
    amlo:technique amx:T0087 .

<https://example.org/amltrix/link/26f5f0a9-9f11-4708-a875-249f37cbf532> a amlo:ProductServiceLink ;
    dct:description """- Local couriers or transportation professionals physically ferry currency and valuables across borders, bypassing formal banking channels.  
