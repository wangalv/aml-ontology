    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "High-volume utility token transfers with no use of the token’s platform features or functionality, suggesting purely transactional layering rather than legitimate utility usage."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
