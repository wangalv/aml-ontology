    dct:modified "2025-05-13T07:47:21.797699+00:00"^^xsd:dateTime ;
    skos:definition "Newly established legal entities that exhibit frequent or rapid changes in management or beneficial owners without a clear operational rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01180" ;
    skos:prefLabel "IND01180"@en ;
