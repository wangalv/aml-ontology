    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Rapid initiation of high-value or high-frequency transactions from newly opened accounts established with questionable identity documents that conflict with the customer’s apparent background."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
