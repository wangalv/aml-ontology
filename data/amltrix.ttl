    amlo:productService amx:PS0051 ;
    amlo:technique amx:T0011.002 .

<https://example.org/amltrix/link/6d602222-13c4-4357-84e4-a6cd524acfe6> a amlo:DataSourceLink ;
    dct:description """- Contains verified customer identities, stated business activities, and beneficial ownership information.
