    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Minimal legitimate gaming activity, unusual chip movement at tables, or a single individual collecting chips from multiple patrons."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01209" ;
    skos:prefLabel "IND01209"@en ;
    amlo:stixId "x-amltrix-indicator--e79bc13a-5b61-47ee-8e8a-b0596f8fd3fc" .

