    dct:modified "2025-05-13T07:47:21.816822+00:00"^^xsd:dateTime ;
    skos:definition "Frequent revisions or resubmissions of grant applications that do not align with known business operations, suggesting misrepresentation of corporate activities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02773" ;
    skos:prefLabel "IND02773"@en ;
    amlo:stixId "x-amltrix-indicator--c900ae01-bb16-44cc-af28-9b2568e11238" .

