    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Adverse media coverage or credible negative news associating the entity or key individuals with criminal organizations or illicit activities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01089" ;
    skos:prefLabel "IND01089"@en ;
    amlo:stixId "x-amltrix-indicator--4d722388-e543-4ee5-b98c-0c5a5d33d8de" .

