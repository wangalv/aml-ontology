<https://example.org/amltrix/link/7abdc195-b8ab-475d-89c9-368e060e9789> a amlo:MitigationLink ;
    dct:description "Use escrow arrangements for high-value antiquities transactions to withhold fund disbursement until the artifact’s provenance and valuation are independently verified. Escrow agents can confirm authenticity and ownership records, preventing criminals from layering illicit proceeds through swift sales or artificially inflated valuations."@en ;
    amlo:mitigation amx:M0020 ;
