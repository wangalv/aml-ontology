    dct:modified "2025-05-13T07:47:21.794970+00:00"^^xsd:dateTime ;
    skos:definition "Submission of forged or rapidly altered auditor and third-party due diligence reports to validate the legitimacy of the merger or acquisition."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01979" ;
    skos:prefLabel "IND01979"@en ;
    amlo:stixId "x-amltrix-indicator--494b7754-5d24-4cd1-9334-512337681f41" .

