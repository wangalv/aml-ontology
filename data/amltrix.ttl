    rdfs:seeAlso <https://framework.amltrix.com/instruments/IN0048> ;
    skos:definition "A specialized financial account managed by a designated trustee or fiduciary to hold client funds for specific purposes, such as real estate transactions or estate planning. It serves as a distinct means of storing and transferring value within a legal oversight framework."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IN0048" ;
    skos:prefLabel "Trust Account"@en ;
