    dct:modified "2025-05-13T07:47:21.811953+00:00"^^xsd:dateTime ;
    skos:definition "Use of language in communications that blurs personal relationships with financial transactions, such as combining romantic or friendship elements with investment solicitations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02398" ;
    skos:prefLabel "IND02398"@en ;
