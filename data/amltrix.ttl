    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01250" ;
    skos:prefLabel "IND01250"@en ;
    amlo:stixId "x-amltrix-indicator--bac47692-b046-44de-b85b-db312fb3308c" .

