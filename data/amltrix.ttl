    dct:created "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Frequent detection of ephemeral blockchain addresses unlinked to any known wallet or customer record, repeatedly used for sub-threshold transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01340" ;
    skos:prefLabel "IND01340"@en ;
    amlo:stixId "x-amltrix-indicator--60c04e2e-ce0c-4971-a844-c81245d32be4" .

