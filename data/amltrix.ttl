    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Invoices approved and processed without rigorous cross-verification against delivery or goods receipt documents reflect bypassed controls in handling fake vendor transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01351" ;
    skos:prefLabel "IND01351"@en ;
    amlo:stixId "x-amltrix-indicator--8d66d861-6330-47b1-87dd-d26a98c2124d" .

