    skos:definition "Specialized systems or services that authenticate and validate official identification documents—such as passports or IDs—detecting potential forgeries, inconsistencies, or tampering."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "DS0027" ;
    skos:prefLabel "Document Verification"@en ;
    amlo:shortDescription "Document Verification services confirm the legitimacy of official identification documents, detecting forgeries and inconsistencies to mitigate identity fraud risk. Integrating these checks into AML/CFT frameworks fortifies KYC processes and compliance efforts against illicit finance."@en ;
    amlo:stixId "x-amltrix-data-source--67d6ba28-9421-4346-a418-8c969a16e884" .

