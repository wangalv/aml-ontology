    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Addition of ambiguous 'service fees' or 'facilitation charges' that elevate total invoiced amounts well above prevailing industry benchmarks."@en ;
