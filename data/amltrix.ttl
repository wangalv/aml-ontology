    dct:modified "2025-05-13T07:47:21.801291+00:00"^^xsd:dateTime ;
    skos:definition "Unverified or rapid changes in beneficial ownership or board membership immediately preceding the merger or acquisition, indicating an attempt to obscure true control."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01976" ;
    skos:prefLabel "IND01976"@en ;
    amlo:stixId "x-amltrix-indicator--c1e35517-a570-4fff-8598-8ef48c8af42b" .

