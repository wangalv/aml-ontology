    dct:modified "2025-05-13T07:47:19.850841+00:00"^^xsd:dateTime ;
    rdfs:seeAlso <https://framework.amltrix.com/actors/AT0035> ;
    skos:definition "Professionals or firms that provide services associated with the formation, administration, and management of companies, trusts, or similar structures on behalf of clients. Their offerings can include company formation, registered office provision, directorship or nominee services, trust administration, accounting, tax compliance, and other administrative or fiduciary duties, often operating across multiple jurisdictions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "AT0035" ;
    skos:prefLabel "Trust and Company Service Providers (TCSPs)"@en ;
    amlo:engagesIn amx:T0001.001,
        amx:T0001.002,
        amx:T0001.003,
        amx:T0010,
        amx:T0010.003,
