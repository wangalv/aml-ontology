    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Significant increase in the frequency of low-value ATM deposits within a short time frame."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01074" ;
    skos:prefLabel "IND01074"@en ;
    amlo:stixId "x-amltrix-indicator--83444239-bd14-44d3-97af-2c1dc5d0da63" .

