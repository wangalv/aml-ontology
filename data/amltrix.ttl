    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Sub-agents in offshore or high-risk jurisdictions handle disproportionately large transaction flows with minimal evidence of principal institution oversight."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02133" ;
    skos:prefLabel "IND02133"@en ;
    amlo:stixId "x-amltrix-indicator--3a8e21bc-9ff7-4c92-89fd-5cbce763a374" .

