    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Multiple digital wallet addresses are used to receive and redistribute mining rewards in frequent inter-wallet transfers, complicating the traceability of the funds flow."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01327" ;
    skos:prefLabel "IND01327"@en ;
    amlo:stixId "x-amltrix-indicator--aa07fdc1-b3a3-4cde-898e-42b615f49cfa" .

