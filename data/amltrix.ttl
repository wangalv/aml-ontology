    dct:created "2025-05-13T07:47:21.801291+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.801291+00:00"^^xsd:dateTime ;
    skos:definition "Multiple sub-agents share identical contact details or beneficial owners with no legitimate business rationale for overlapping operations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02131" ;
    skos:prefLabel "IND02131"@en ;
    amlo:stixId "x-amltrix-indicator--972cf5d0-bb50-4f12-be08-2c1f3bfdda79" .

