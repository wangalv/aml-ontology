    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Multiple individuals making near-threshold buy-ins or deposits in short intervals or in sequence at the same cage, suggesting structuring or collusion to evade detection."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01210" ;
    skos:prefLabel "IND01210"@en ;
    amlo:stixId "x-amltrix-indicator--5ba62580-50dc-47c4-8e71-572d6b72398a" .

