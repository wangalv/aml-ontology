    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Frequent cross-chain transfer events in which assets are wrapped, moved, and unwrapped across multiple blockchains with no apparent economic rationale, indicating a structured layering scheme."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01243" ;
    skos:prefLabel "IND01243"@en ;
    amlo:stixId "x-amltrix-indicator--529ecfee-7765-4d45-8fc8-438fac3428bd" .

