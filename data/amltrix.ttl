    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Financial records show significant inconsistencies between declared earnings and actual transaction activity, including absent or falsified supporting invoices for large transfers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01087" ;
    skos:prefLabel "IND01087"@en ;
    amlo:stixId "x-amltrix-indicator--00959e81-11c7-4411-8cd7-385f64b0e6d0" .

