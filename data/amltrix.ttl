    amlo:dataSource amx:DS0027 ;
    amlo:technique amx:T0135 .

<https://example.org/amltrix/link/0df9ce88-299b-4bce-b18b-ffe37f60a3e0> a amlo:InstrumentLink ;
    dct:description """- Fictitious vendor entities open or register business bank accounts to receive payments for sham invoices.
