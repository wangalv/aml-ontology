    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Delays or outright refusals to provide complete client identification and transaction details during due diligence, citing professional privilege to withhold information."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00766" ;
    skos:prefLabel "IND00766"@en ;
    amlo:stixId "x-amltrix-indicator--4ef27c91-45ce-40a3-a29d-04fee7db17da" .

