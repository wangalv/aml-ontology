    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Frequent turnover of directorship or beneficial ownership in corporate records without commercial justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00760" ;
    skos:prefLabel "IND00760"@en ;
    amlo:stixId "x-amltrix-indicator--df01c77f-3edb-4676-a257-9db8d9357df1" .

