    amlo:mitigation amx:M0004 ;
    amlo:technique amx:T0048.002 .

<https://example.org/amltrix/link/90caee68-66d6-4508-a233-7908c8ebf849> a amlo:ProductServiceLink ;
    dct:description """- Criminals exploit P2P features by rotating funds among multiple accounts or third-party wallets, making transaction patterns difficult to trace.  
