    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Use of addresses or premises lacking actual operational presence (e.g., virtual offices, PO boxes, or shared offices) inconsistent with declared active commercial operations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01086" ;
    skos:prefLabel "IND01086"@en ;
    amlo:stixId "x-amltrix-indicator--eab022c0-0cb1-4eb7-93a7-33f69ae37837" .

