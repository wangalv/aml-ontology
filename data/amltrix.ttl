    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Immediate resignation or dismissal of a public official or financial staff upon detection of anomalous or fraudulent transactions within government accounts."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02544" ;
    skos:prefLabel "IND02544"@en ;
    amlo:stixId "x-amltrix-indicator--90e3fc33-22ec-44cf-9b3b-2f9ae5054e24" .

