    dct:modified "2025-05-13T07:47:21.816822+00:00"^^xsd:dateTime ;
    skos:definition "Contradictory or incomplete details in supporting documents, such as tax records or payroll data, submitted to justify the relief program eligibility."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02771" ;
    skos:prefLabel "IND02771"@en ;
    amlo:stixId "x-amltrix-indicator--2012023b-7af3-4146-8fd2-bcb335a3a306" .

