    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02546" ;
    skos:prefLabel "IND02546"@en ;
    amlo:stixId "x-amltrix-indicator--9040f0a8-9b8d-4840-a23e-6c68ef767191" .

