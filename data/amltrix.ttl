    dct:created "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Unauthorized or undocumented accounting entries (e.g., write-offs, credits) made in public sector financial records without legitimate supporting documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02540" ;
    skos:prefLabel "IND02540"@en ;
    amlo:stixId "x-amltrix-indicator--dded9189-b1ab-4be8-a431-02da118c7711" .

