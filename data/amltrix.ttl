    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Businesses conducting large volumes of international wire transfers through a personal bank account rather than a company account."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01061" ;
    skos:prefLabel "IND01061"@en ;
    amlo:stixId "x-amltrix-indicator--41a15e26-c96d-405f-af56-2724bf6ea8b0" .

amx:IND01062 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Customer accounts with a pattern of disputing transactions without providing sufficient evidence."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01062" ;
    skos:prefLabel "IND01062"@en ;
    amlo:stixId "x-amltrix-indicator--763fc100-88c3-4fe8-a146-de04db0afd9d" .

