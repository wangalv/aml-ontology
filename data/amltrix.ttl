        amx:T0134,
        amx:T0142,
        amx:T0144.009,
        amx:T0144.013 ;
    amlo:shortDescription "Virtual Asset Service Providers (VASPs) facilitate the exchange, transfer, custody, and issuance of digital assets across centralized, peer-to-peer, and decentralized platforms, exposing them to heightened AML/CFT vulnerabilities due to potential anonymity and rapid cross-border movement of funds. As critical gatekeepers within the crypto ecosystem, VASPs must implement robust compliance measures to mitigate illicit finance risks."@en ;
    amlo:stixId "x-amltrix-actor--fc733622-43b4-469a-94f5-d470b9fda467" .

amx:DS0015 a amlo:DataSource ;
    dct:created "2025-05-13T07:47:20.014988+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:20.014988+00:00"^^xsd:dateTime ;
    rdfs:seeAlso <https://framework.amltrix.com/data-sources/DS0015> ;
    skos:definition "Official data on goods and financial assets seized by customs or enforcement authorities, including details about the items seized, parties involved, and any associated legal proceedings."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "DS0015" ;
    skos:prefLabel "Customs and Asset Seizure Records"@en ;
    amlo:shortDescription "Customs and Asset Seizure Records provide official details on confiscated goods, financial assets, and the parties involved, enhancing visibility into cross-border illicit flows or suspicious activities. This information is crucial for identifying high-risk networks and potential legal or regulatory actions within AML/CFT adversarial threat modelling."@en ;
    amlo:stixId "x-amltrix-data-source--2a81a527-0811-4d60-8814-abcf5a58d6c1" .

amx:DS0026 a amlo:DataSource ;
    dct:created "2025-05-13T07:47:20.015597+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:20.015597+00:00"^^xsd:dateTime ;
    rdfs:seeAlso <https://framework.amltrix.com/data-sources/DS0026> ;
    skos:definition "Records from online fundraising platforms and associated donation logs, including donor identities, amounts, contribution dates, and intended purposes."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "DS0026" ;
    skos:prefLabel "Donation Platforms & Donor Records"@en ;
    amlo:shortDescription "Donation platform and donor records offer detailed insights into individual contributions, including donor identities, amounts, dates, and intended purposes, which help detect suspicious patterns, fund flows, or potential misuse in support of illicit activities."@en ;
    amlo:stixId "x-amltrix-data-source--dd24375e-8ca6-45b5-9a7c-4e8878b38fb6" .

amx:DS0037 a amlo:DataSource ;
