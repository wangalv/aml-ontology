    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Multiple personal and business accounts—none officially registered—share a single beneficial owner, funneling unverified cash inflows with no apparent legitimate business structure."@en ;
