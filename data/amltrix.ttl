    skos:definition "Emails containing payment instructions have slight spelling or grammatical errors atypical for the vendor."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02505" ;
    skos:prefLabel "IND02505"@en ;
    amlo:stixId "x-amltrix-indicator--a75fbe81-dd09-4000-ad15-b7afe5cff596" .

