    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Funds pass through a long sequence of intermediary wallets—multiple hops—before eventually reaching an exchange, mixer, or other exit point."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01031" ;
    skos:prefLabel "IND01031"@en ;
    amlo:stixId "x-amltrix-indicator--0c897838-2a38-473f-81ee-091704f8c3c6" .

