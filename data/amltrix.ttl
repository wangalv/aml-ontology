    skos:definition "Frequent or sudden changes in corporate structure, such as rapid updates in directors or beneficial ownership following the adoption of VAT-exempt status."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02561" ;
    skos:prefLabel "IND02561"@en ;
    amlo:stixId "x-amltrix-indicator--7a750242-9863-44f2-a130-761b19ea2757" .

