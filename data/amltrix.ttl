    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Cash delivered by individuals claiming to act on behalf of an unlicensed or undocumented 'remittance agent'."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01067" ;
    skos:prefLabel "IND01067"@en ;
    amlo:stixId "x-amltrix-indicator--175529f1-3821-4048-b7e4-595aeab19ee2" .

