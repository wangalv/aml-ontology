    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Unjustifiably high or low royalty or management fees charged between related entities, misaligned with the group's overall financial performance or operational scale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
