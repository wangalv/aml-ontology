    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Use of multiple non-operational corporate vehicles or trusts through intermediaries to conceal the true beneficial owner."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01079" ;
    skos:prefLabel "IND01079"@en ;
    amlo:stixId "x-amltrix-indicator--53ae07b7-4e10-4e90-9069-68ef58da5a3e" .

