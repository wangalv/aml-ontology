    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Trade documentation showing discrepancies between the quantity, quality, or type of goods described in the invoice and the actual goods shipped or received."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
