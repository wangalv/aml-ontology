    amlo:productService amx:PS0007 ;
    amlo:technique amx:T0144.012 .

<https://example.org/amltrix/link/7da1e5d2-16be-4188-8cf3-8f7e2709cdf1> a amlo:ProductServiceLink ;
    dct:description """- Criminals leverage lax identity requirements or offshore secrecy laws to open accounts using fake or stolen personal data.
