    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Sudden increases in international transfer volume or value to or from regions with no apparent personal or business connection to the account holder."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01057" ;
    skos:prefLabel "IND01057"@en ;
    amlo:stixId "x-amltrix-indicator--7a5e64aa-ed7d-436b-9339-a380b718f939" .

