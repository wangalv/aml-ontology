    amlo:productService amx:PS0008 ;
    amlo:technique amx:T0144.013 .

<https://example.org/amltrix/link/7f020491-5907-4eae-bcda-6dee57857b15> a amlo:InstrumentLink ;
    dct:description """- Criminals use property holdings, often under shell companies or nominee ownership, to create fictitious or inflated leases and record illicit funds as rent. 
