    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01251" ;
    skos:prefLabel "IND01251"@en ;
    amlo:stixId "x-amltrix-indicator--ec9d70be-eff6-420a-85ee-4e7ca8072ce1" .

