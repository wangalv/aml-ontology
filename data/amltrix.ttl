    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Regular advertising and promotion of unregistered or lightly regulated P2P trading services on social media or online forums, potentially targeting illicit clientele."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01359" ;
    skos:prefLabel "IND01359"@en ;
    amlo:stixId "x-amltrix-indicator--b1ce82c8-2e42-4a15-9bce-e66f9b156178" .

