    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "A circular pattern of token movements, such as round-trip transfers among multiple wallets, lacking any legitimate economic purpose, often associated with layering or integration of illicit funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
