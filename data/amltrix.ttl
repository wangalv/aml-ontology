    dct:modified "2025-05-13T07:47:21.816822+00:00"^^xsd:dateTime ;
    skos:definition "Significant mismatches between the stated purpose of the state subsidies and the actual end-use of those funds based on outgoing transaction patterns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
