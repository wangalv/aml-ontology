    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Noticeable pattern of partial expense claims just below internal review thresholds, filed multiple times over short intervals."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02105" ;
    skos:prefLabel "IND02105"@en ;
    amlo:stixId "x-amltrix-indicator--e306eee6-5719-4c82-8675-7858b0e6f036" .

