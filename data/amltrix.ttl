    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "High volume currency conversion transactions from U.S. dollars to pesos executed at unofficial or parallel exchange rates that significantly diverge from official market rates."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01095" ;
    skos:prefLabel "IND01095"@en ;
    amlo:stixId "x-amltrix-indicator--3dde23d1-2dfc-4652-afcc-2d79d02fb5e1" .

