    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Transactions initiated through privacy wallets employing built-in mixing or anonymizing features (e.g., CoinJoin)."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01035" ;
    skos:prefLabel "IND01035"@en ;
    amlo:stixId "x-amltrix-indicator--95271cbd-bddf-4a9b-9c01-5d5489b4501c" .

amx:IND01036 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "A layering pattern emerges where transaction amounts decrease progressively at each hop, reflecting a peel chain structure."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01036" ;
    skos:prefLabel "IND01036"@en ;
    amlo:stixId "x-amltrix-indicator--54f2bb48-f97b-4e37-9740-632b1d9dc6db" .

amx:IND01037 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Cryptoassets from newly generated addresses are transferred into multiple accounts with no clear relationship to the original depositor."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01037" ;
    skos:prefLabel "IND01037"@en ;
    amlo:stixId "x-amltrix-indicator--52d52317-6b2c-4d03-947c-6f16cf194d3f" .

amx:IND01038 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Transaction amounts, intervals, or frequency appear systematically uniform, suggesting automated peeling processes across multiple addresses."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01038" ;
    skos:prefLabel "IND01038"@en ;
    amlo:stixId "x-amltrix-indicator--417f690f-b5df-4a19-931a-30789544b9f0" .

amx:IND01039 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Rapid successive transactions using cross-chain bridges within short timeframes that deviate from the customer's regular trading patterns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01039" ;
    skos:prefLabel "IND01039"@en ;
    amlo:stixId "x-amltrix-indicator--faf9f2ce-65de-4765-a919-ac77ba39ad6a" .

amx:IND01040 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Chain-hopping patterns where assets are sequentially transferred across multiple blockchain networks via one or more bridge services, lacking a clear business rationale or explanation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01040" ;
    skos:prefLabel "IND01040"@en ;
    amlo:stixId "x-amltrix-indicator--cf964310-17ee-4832-ac74-ea512f8b6725" .

amx:IND01041 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Bridging transactions involving unusually large sums or multiple structured amounts at or below reporting thresholds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01041" ;
    skos:prefLabel "IND01041"@en ;
    amlo:stixId "x-amltrix-indicator--6900d88c-001d-42c6-a17f-22ad816b2c09" .

amx:IND01042 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Engagement with decentralized cross-chain bridge services that lack robust customer identification and verification protocols, especially when such behavior is new for the client."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01042" ;
    skos:prefLabel "IND01042"@en ;
    amlo:stixId "x-amltrix-indicator--cfc810d6-28e0-4a17-84dc-a6b21c185f86" .

amx:IND01043 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Sudden deviation in asset management behavior, such as shifting funds from a traditionally used blockchain to another via a bridge without any clear economic or business rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01043" ;
    skos:prefLabel "IND01043"@en ;
    amlo:stixId "x-amltrix-indicator--e1b8e2a0-a713-4f73-93e1-b0941b9cd627" .

amx:IND01044 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Transactions linked to blockchain addresses that have been flagged or associated with known illicit activities, particularly when these addresses serve as either source or destination in bridge transfers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01044" ;
    skos:prefLabel "IND01044"@en ;
    amlo:stixId "x-amltrix-indicator--6b4c5afb-f10e-4a59-92f9-c17f2100a50d" .

amx:IND01045 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Multiple layers of fund transfers where assets are bridged across several blockchains in a complex sequence that complicates tracking and attribution."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01045" ;
    skos:prefLabel "IND01045"@en ;
    amlo:stixId "x-amltrix-indicator--8e73ad32-7572-4ba3-8d3a-f8b303064b5c" .

amx:IND01046 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Use of aggregated or clustered wallet addresses to execute sequential cross-chain bridge transactions, especially when such behavior is inconsistent with the customer's known activity profile."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01046" ;
    skos:prefLabel "IND01046"@en ;
    amlo:stixId "x-amltrix-indicator--92bed501-1d02-44ee-8846-b0c19b997667" .

amx:IND01047 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Transactions where the destination tokens on a different blockchain do not align with the client's declared source or type of wealth, as revealed by cross-chain ledger analysis."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01047" ;
    skos:prefLabel "IND01047"@en ;
    amlo:stixId "x-amltrix-indicator--146e199e-f3fe-4980-b93b-71d6cecc5847" .

amx:IND01048 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Frequent bridging to privacy-focused or anonymity-enhancing blockchain networks with short holding periods and no identified economic rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01048" ;
    skos:prefLabel "IND01048"@en ;
    amlo:stixId "x-amltrix-indicator--f48d2da8-ab8d-456c-a985-2c244a4d104a" .

amx:IND01049 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Official corporate records show no evidence of actual operations, such as missing invoices, contracts, or supplier payments."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01049" ;
    skos:prefLabel "IND01049"@en ;
    amlo:stixId "x-amltrix-indicator--48853c9f-9c9f-4bb0-91ee-72ca532ffd06" .

amx:IND01050 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "The company’s registration date is significantly older than any verifiable evidence of business operations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01050" ;
    skos:prefLabel "IND01050"@en ;
    amlo:stixId "x-amltrix-indicator--48c7a03a-d662-4991-a60b-60e054a93018" .

amx:IND01051 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Frequent changes in beneficial ownership or the appointment of nominee directors shortly after the company’s acquisition."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01051" ;
    skos:prefLabel "IND01051"@en ;
    amlo:stixId "x-amltrix-indicator--b648d64e-a0d3-414d-a2d0-0af23204f711" .

amx:IND01052 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Dormant accounts are suddenly reactivated for large, irregular financial transactions that do not align with any declared business purpose."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01052" ;
    skos:prefLabel "IND01052"@en ;
    amlo:stixId "x-amltrix-indicator--96d8409e-bd03-4b11-bfb2-c1a827032168" .

amx:IND01053 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Bank accounts linked to the company show minimal routine transactions with sudden high-value deposits or transfers, inconsistent with normal business activity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01053" ;
    skos:prefLabel "IND01053"@en ;
    amlo:stixId "x-amltrix-indicator--7974b6c6-85a9-4efc-9c1f-148e5a794368" .

