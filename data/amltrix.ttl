    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Professional service providers consistently refuse or fail to provide requested details about the origin or destination of funds under due diligence processes."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
