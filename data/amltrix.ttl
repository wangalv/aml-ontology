    amlo:instrument amx:IN0055 ;
    amlo:technique amx:T0058.002 .

<https://example.org/amltrix/link/3d57e5c6-0cdf-4198-b90f-e853a2b9d423> a amlo:ProductServiceLink ;
    dct:description """- Offers specialized business or financial advice that may include structuring inter-company pricing strategies.  
