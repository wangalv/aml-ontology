    dct:modified "2025-05-13T07:47:21.789941+00:00"^^xsd:dateTime ;
    skos:definition "The fund flow pattern is circular, with funds eventually returning to or connecting back to the original account, reflecting a closed-loop structure without economic substance."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00485" ;
    skos:prefLabel "IND00485"@en ;
    amlo:stixId "x-amltrix-indicator--0d182960-3e29-4024-ab75-a80c9373e42b" .

