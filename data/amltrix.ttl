    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "A high frequency of small incremental currency conversion transactions that, while individually below reporting thresholds, cumulatively involve significant sums."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02135" ;
    skos:prefLabel "IND02135"@en ;
    amlo:stixId "x-amltrix-indicator--d62d7592-b334-419c-ad39-d1ec8542e747" .

