    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Intermediaries submit incomplete, inconsistent, or unverifiable identification documents during due diligence reviews."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01080" ;
    skos:prefLabel "IND01080"@en ;
    amlo:stixId "x-amltrix-indicator--425d4344-688d-42ab-ac22-2e8a7c4cb944" .

