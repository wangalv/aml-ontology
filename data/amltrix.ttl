    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Repeated issuance of invoices without matching shipping or goods receipts in trade or logistics documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02587" ;
    skos:prefLabel "IND02587"@en ;
    amlo:stixId "x-amltrix-indicator--4c148192-7c16-4f92-9115-247eed843d8d" .

