    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "The firm repeatedly initiates short-term consulting engagements with unusual frequency, unaligned with typical industry practices, suggesting fabricated project generation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
