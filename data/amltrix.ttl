    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Multiple accounts or money service businesses used by the same beneficial owner to execute sub-threshold transfers that collectively exceed reporting thresholds when aggregated."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01342" ;
    skos:prefLabel "IND01342"@en ;
    amlo:stixId "x-amltrix-indicator--082b084d-66bb-4030-b6a7-739486ede926" .

amx:IND01343 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Vendor account registrations with unverifiable details, such as non-existent addresses, generic phone numbers, or invalid business registration data, consistent with a fictitious supplier setup."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01343" ;
    skos:prefLabel "IND01343"@en ;
    amlo:stixId "x-amltrix-indicator--542b13b4-d2e4-4a36-b992-23a6ac2d13ee" .

