    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Documented discrepancies between reported revenue figures and independent market data on jewelry sales, revealing artificially inflated or deflated revenues."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02595" ;
    skos:prefLabel "IND02595"@en ;
    amlo:stixId "x-amltrix-indicator--3e70d216-ddc9-4ddc-b27d-e2e3371d721c" .

