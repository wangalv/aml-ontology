    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "New customers providing identical or nearly identical identification documents (e.g., passports, driver’s licenses, selfies), indicative of standardized KYC data usage in money mule schemes."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01111" ;
    skos:prefLabel "IND01111"@en ;
    amlo:stixId "x-amltrix-indicator--4f69ef83-5af5-42c8-ac8f-062437f20871" .

