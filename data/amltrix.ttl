    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Ongoing use of public funds for personal expenses disguised as legitimate government expenditures, lacking supporting documentation or official approval."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02541" ;
    skos:prefLabel "IND02541"@en ;
    amlo:stixId "x-amltrix-indicator--84eeb899-f6ab-4713-9b43-b28ed3a9accd" .

