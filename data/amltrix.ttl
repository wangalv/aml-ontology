    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Misrepresentation of jewelry item origin or authenticity, for example labeling overseas-produced pieces as local or specialty products, identified through contradictory hallmark or import records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02596" ;
    skos:prefLabel "IND02596"@en ;
    amlo:stixId "x-amltrix-indicator--24243d57-961c-4a0f-be1e-9af23f53a278" .

