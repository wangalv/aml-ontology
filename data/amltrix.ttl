    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Multiple employees submitting nearly identical receipts or invoice references for travel or entertainment expenses within overlapping date ranges."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02103" ;
    skos:prefLabel "IND02103"@en ;
    amlo:stixId "x-amltrix-indicator--dde32642-2e00-4f58-ac0b-bc4ad614826e" .

amx:IND02104 a amlo:Indicator ;
