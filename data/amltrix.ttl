    amlo:productService amx:PS0109 ;
    amlo:technique amx:T0147 .

<https://example.org/amltrix/link/6d50a4db-c560-402d-83e4-34d7c73d7fba> a amlo:ActorLink ;
    dct:description """Unwittingly provides and services the business accounts used for depositing purported jewelry sales:

