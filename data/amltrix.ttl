    amlo:instrument amx:IN0008 ;
    amlo:technique amx:T0016.001 .

<https://example.org/amltrix/link/31b54df7-63ef-46c7-ad52-a522fc6a7209> a amlo:MitigationLink ;
    dct:description "During onboarding and periodic reviews, request detailed payroll structures from businesses operating in cash-intensive sectors. Compare officially reported staff rosters or wage statements against the frequency and volume of cash withdrawals to identify hidden or under-the-table wage payments."@en ;
    amlo:mitigation amx:M0003 ;
    amlo:technique amx:T0052 .

<https://example.org/amltrix/link/31b620aa-d27b-4638-bca0-f397e5846ce0> a amlo:ProductServiceLink ;
