    amlo:dataSource amx:DS0011 ;
    amlo:technique amx:T0011 .

<https://example.org/amltrix/link/90719fb5-11ba-479b-aebb-ccc8dc3c262f> a amlo:DataSourceLink ;
    dct:description """- Provides official records on the movement of goods and related permits required at border checkpoints.
