    skos:definition "Repeated unauthorized modifications to AML or compliance controls—such as lowering risk scores or removing transaction alerts—by a single individual without proper authorization or justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01186" ;
    skos:prefLabel "IND01186"@en ;
