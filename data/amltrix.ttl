    amlo:productService amx:PS0049 ;
    amlo:technique amx:T0067.003 .

<https://example.org/amltrix/link/8cb1bb8e-bbda-43c8-9cf2-f52874fbb4ad> a amlo:DataSourceLink ;
    dct:description """- Offers public blockchain ledger information, such as transaction IDs, timestamps, wallet addresses, transaction amounts, and potential mixer addresses.
- Facilitates the tracing of layered transfers, chain-hopping, and rapid multi-wallet movements used to obscure ransomware proceeds.
- Supplies advanced analytics that highlight clusters of related wallets and detect anomalous patterns consistent with ransomware layering strategies."""@en ;
    amlo:dataSource amx:DS0045 ;
    amlo:technique amx:T0049.001 .

<https://example.org/amltrix/link/8cb793f0-d843-4884-95ff-b8024d3c5120> a amlo:DataSourceLink ;
    dct:description """- Records cross-border cash or monetary instrument declarations and seizures at entry or exit points.
