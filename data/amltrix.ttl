    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Frequent high-value transactions involving commodities associated with illicit trade (e.g., precious metals, wildlife products, counterfeit pharmaceuticals) lacking corresponding purchase or sales records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02982" ;
    skos:prefLabel "IND02982"@en ;
    amlo:stixId "x-amltrix-indicator--61a67931-8414-49ff-8677-e913fa57a08d" .

