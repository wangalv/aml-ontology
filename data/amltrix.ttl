    amlo:actor amx:AT0052 ;
    amlo:technique amx:T0092 .

<https://example.org/amltrix/link/ec5d2a36-b5dd-4d94-844d-fb1af0dc8356> a amlo:ProductServiceLink ;
    dct:description """- Adversaries target remote gambling platforms with insufficient or lax ID checks, registering multiple accounts using misleading or stolen credentials. 
