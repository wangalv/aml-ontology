    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or cyclical transfers of real estate ownership among offshore entities with minimal proof of a legitimate business or personal rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01203" ;
    skos:prefLabel "IND01203"@en ;
    amlo:stixId "x-amltrix-indicator--642e7fa6-2171-4200-bf97-f51e93e18f13" .

