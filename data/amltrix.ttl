    amlo:dataSource amx:DS0029 ;
    amlo:technique amx:T0113.001 .

<https://example.org/amltrix/link/6d417218-b928-4e9b-ab27-c49ff322b391> a amlo:ProductServiceLink ;
    dct:description """- Criminals use credit cards (often with stolen or synthetic identities) to file fraudulent disputes, claiming non-delivery or defective goods.  
