    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Rapid circular inter-company transactions among related entities with minimal time gaps and no substantiated commercial rationale, suggesting artificial shifting of funds or profits."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
