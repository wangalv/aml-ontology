        amx:T0121.001,
        amx:T0122,
        amx:T0141,
        amx:T0143,
        amx:T0144,
        amx:T0147.001 ;
    amlo:shortDescription "Money Services Businesses (MSBs) facilitate currency exchange, money transmission, and other financial services outside formal banking channels, often catering to underserved or underbanked populations. Their flexible service models and broader customer reach can present increased AML/CFT vulnerabilities, necessitating enhanced regulatory oversight and comprehensive risk mitigation strategies."@en ;
    amlo:stixId "x-amltrix-actor--7bed9c9c-aaa9-456e-a8ef-c864b283088f" .

amx:IN0006 a amlo:ValueInstrument ;
