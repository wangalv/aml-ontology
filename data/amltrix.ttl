    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Frequent currency exchanges in small denominations performed specifically during peak operating hours or high-traffic periods, deviating from typical usage patterns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
