    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Regular transfers of digital assets among multiple personal or external wallets without an identifiable economic purpose, effectively layering funds to obscure their source."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
