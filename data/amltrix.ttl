    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Multiple small deposits from various unrelated wallets into a single mixer address followed by rapid, fragmented withdrawals to diverse wallets."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00759" ;
    skos:prefLabel "IND00759"@en ;
    amlo:stixId "x-amltrix-indicator--bc8fdb45-3a94-4d84-a0f2-3ef81f366e11" .

