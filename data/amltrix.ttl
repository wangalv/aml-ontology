    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "The company maintains minimal real business presence (e.g., virtual office, P.O. box) but processes high transaction volumes, inconsistent with legitimate consulting operations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
