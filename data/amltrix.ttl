    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01401" ;
    skos:prefLabel "IND01401"@en ;
    amlo:stixId "x-amltrix-indicator--ea5c780f-b263-4539-b658-11f0f21a1557" .

