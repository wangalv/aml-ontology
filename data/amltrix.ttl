    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "A legitimate inbound payment from an expected sender is replaced or partially substituted by a deposit from an unrelated source, with no record of the original remittance arriving in full."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
