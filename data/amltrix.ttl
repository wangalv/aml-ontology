    dct:modified "2025-05-13T07:47:21.816822+00:00"^^xsd:dateTime ;
    skos:definition "Ongoing pattern of short-term securities trades generating returns consistently exceeding typical market performance around key corporate disclosures, followed by rapid transfers of proceeds to multiple external accounts."@en ;
