    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Discrepancies between the declared source of wealth and observed transaction volumes or frequencies in newly opened accounts, indicating personal accounts used for illicit funds processing."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01116" ;
    skos:prefLabel "IND01116"@en ;
    amlo:stixId "x-amltrix-indicator--099f3dd3-fa29-458f-8a54-015f4f6d1a24" .

