    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Pricing anomalies in sell orders, such as significant overpricing or discounting relative to market rates, used to facilitate rapid fund movement."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01363" ;
    skos:prefLabel "IND01363"@en ;
    amlo:stixId "x-amltrix-indicator--61cfb73b-4352-4f30-b030-87934c75c517" .

