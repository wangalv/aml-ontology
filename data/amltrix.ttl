    dct:modified "2025-05-13T07:47:21.815052+00:00"^^xsd:dateTime ;
    skos:definition "Use of multiple intermediaries or shell companies in different jurisdictions that do not add any apparent value to the trade process."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02601" ;
    skos:prefLabel "IND02601"@en ;
