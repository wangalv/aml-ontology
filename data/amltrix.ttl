    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Irregular transaction flows where funds frequently enter through one payment channel (like bank transfers) and quickly exit via another (e.g., instant transfers), indicating potential layering."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01364" ;
    skos:prefLabel "IND01364"@en ;
    amlo:stixId "x-amltrix-indicator--7989a1e0-e26e-46ec-9e49-33ba1a6ad59b" .

amx:IND01365 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Frequent cross-chain conversions or bridging transactions through multiple pseudonymous wallets shortly after receiving P2P funds, obscuring transaction trails."@en ;
