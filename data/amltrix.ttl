    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "A high volume of consecutive micro-transactions occurs in a short timeframe, exceeding typical user behavior norms."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01027" ;
    skos:prefLabel "IND01027"@en ;
    amlo:stixId "x-amltrix-indicator--13aa6212-7ee9-41bc-87a8-30ffc423c9b7" .

