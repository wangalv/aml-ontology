    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Customers who remain intentionally vague about the source of funds or their business activities, or refuse to provide further details upon request."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
