    skos:definition "An entity or business that offers services for exchanging, transferring, safekeeping, managing, or issuing digital assets. This category includes centralized and peer-to-peer trading platforms, decentralized finance protocols, wallet providers, and other digital asset platforms."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "AT0093" ;
