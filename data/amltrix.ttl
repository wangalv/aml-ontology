    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Behavioral patterns where an individual shows minimal gambling engagement—short or nonexistent betting sessions—despite repeated chip-to-cash redemption cycles."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01206" ;
    skos:prefLabel "IND01206"@en ;
    amlo:stixId "x-amltrix-indicator--e19b3aa2-1a9a-4fe8-a589-e62cba28703e" .

