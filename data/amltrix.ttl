    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Frequent use of multiple shipping addresses or varying beneficiary names linked to the same account, complicating identification of actual recipients or final destinations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00763" ;
    skos:prefLabel "IND00763"@en ;
    amlo:stixId "x-amltrix-indicator--31b6ca53-5256-41e4-a2fe-e3798a80555b" .

