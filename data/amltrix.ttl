    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Use of newly established or low-activity companies to conduct high-volume import/export of commodities without visible operational infrastructure (no warehouse, minimal staff)."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
