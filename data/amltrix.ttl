    dct:modified "2025-05-13T07:47:20.080004+00:00"^^xsd:dateTime ;
    rdfs:seeAlso <https://framework.amltrix.com/services-products/PS0013> ;
    skos:definition "A service provided by financial institutions that allows customers to conduct financial transactions and manage their accounts remotely via a dedicated mobile application or mobile-optimized website. This typically includes viewing balances, transferring funds, paying bills, and other account-related functionalities, offering convenience and real-time access to account information."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "PS0013" ;
    skos:prefLabel "Mobile Banking"@en ;
    amlo:isExploitedBy amx:T0011,
        amx:T0015,
        amx:T0015.003,
        amx:T0023.001,
        amx:T0075,
        amx:T0076 ;
    amlo:shortDescription "Mobile banking provides customers with real-time remote access to balances, transfers, bill payments, and other account services via mobile applications or websites. In AML/CFT adversarial threat modelling, it introduces heightened risk of rapid, potentially cross-border transactions, mandating robust security controls and vigilant monitoring to prevent illicit activity."@en ;
    amlo:stixId "products-service--b6aae617-d386-4830-9a5d-b6dcbb35c5ad" .

