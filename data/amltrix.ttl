    amlo:instrument amx:IN0038 ;
    amlo:technique amx:T0001 .

<https://example.org/amltrix/link/7ecffd62-4a32-4214-a132-185861f0593d> a amlo:ProductServiceLink ;
    dct:description """- Aggregate funds from multiple clients into a single account, obscuring direct links to sanctioned individuals.  
