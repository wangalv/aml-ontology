        amx:T0094.002,
        amx:T0101,
        amx:T0102,
        amx:T0111.001,
        amx:T0118,
        amx:T0136,
        amx:T0147.003 ;
    amlo:shortDescription "Brokers serve as intermediaries connecting buyers and sellers of financial instruments, often holding licenses and providing services such as trade execution, investment advice, and record-keeping. Their multifaceted role makes them a potential conduit for money laundering and terrorist financing, necessitating strong oversight and compliance measures to mitigate AML/CFT risks."@en ;
    amlo:stixId "x-amltrix-actor--b86ed4a3-56cd-44bd-b661-9b1be2e2a695" .

amx:AT0057 a amlo:Actor ;
    dct:created "2025-05-13T07:47:19.851848+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:19.851848+00:00"^^xsd:dateTime ;
    rdfs:seeAlso <https://framework.amltrix.com/actors/AT0057> ;
    skos:definition "A natural person (or persons) who ultimately owns, controls, or profits from an asset, business, or arrangement, whether directly or indirectly. Beneficial owners typically have the right to share in the entity’s profits or influence strategic decisions, even if not publicly disclosed."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "AT0057" ;
    skos:prefLabel "Beneficial Owner"@en ;
    amlo:engagesIn amx:T0001,
        amx:T0008,
        amx:T0010.002,
        amx:T0014.002,
        amx:T0014.003,
        amx:T0025,
        amx:T0038,
        amx:T0071,
        amx:T0088.002,
        amx:T0095,
        amx:T0101,
        amx:T0102,
        amx:T0130,
        amx:T0130.001 ;
    amlo:shortDescription "Beneficial owners are the ultimate decision-makers or profit recipients behind an entity, often obscured from public view, making them pivotal in adversarial threat scenarios. Their undisclosed leverage and control pose heightened AML/CFT risks by facilitating the concealment of illicit funds if not rigorously identified and monitored."@en ;
    amlo:stixId "x-amltrix-actor--4025aa40-8750-4e5b-9010-3feebc43acc7" .

amx:AT0064 a amlo:Actor ;
