    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Expense claims consistently exceeding typical amounts for similar roles, with limited or no justification provided."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02101" ;
    skos:prefLabel "IND02101"@en ;
    amlo:stixId "x-amltrix-indicator--06573f54-3b51-4eaf-b12e-23eb016cd528" .

