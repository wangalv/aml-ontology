    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Frequent cross-jurisdictional fund transfers in quick succession without documented business or operational purpose."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00761" ;
    skos:prefLabel "IND00761"@en ;
    amlo:stixId "x-amltrix-indicator--fb642b3c-264e-45fb-b5b1-42a6d4bcb374" .

