    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Third-party or intermediary payments for trade invoices where the payer has no direct relationship to the underlying goods or contracting parties."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01098" ;
    skos:prefLabel "IND01098"@en ;
    amlo:stixId "x-amltrix-indicator--4cfc8e9d-8be0-4d38-a024-c3f400879953" .

