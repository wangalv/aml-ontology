    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Use of nonexistent or fraudulent vendors by a public official or employee to channel public monies via false invoices into personal or third-party accounts."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02543" ;
    skos:prefLabel "IND02543"@en ;
    amlo:stixId "x-amltrix-indicator--e3433ead-6fc6-4bd9-8aee-cea2b8a650f4" .

