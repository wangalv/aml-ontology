    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Unusually large or frequent inbound transfers to an employee’s personal accounts from high-risk or unverified sources, temporally linked to approvals or overrides performed by the same employee."@en ;
