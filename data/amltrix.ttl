    skos:definition "Cryptocurrencies pegged to fiat currencies or commodities to reduce volatility, enabling more predictable value. Examples include USDT, USDC, and BUSD. They are commonly used for everyday transactions, cross-border remittances, and digital financial services."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IN0027" ;
    skos:prefLabel "Stablecoins"@en ;
