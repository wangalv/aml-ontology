    amlo:dataSource amx:DS0026 ;
    amlo:technique amx:T0144 .

<https://example.org/amltrix/link/b4030bf4-c5ac-443e-b78d-261a261974a3> a amlo:DataSourceLink ;
    dct:description """Databases containing official information on the licenses, certifications, and memberships of accounting or tax professionals. This data:

