    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Frequent execution of cash transactions with a cyclical deposit-to-withdrawal pattern, quickly channeling funds from compromised or third-party bank accounts into crypto ATMs."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01235" ;
    skos:prefLabel "IND01235"@en ;
    amlo:stixId "x-amltrix-indicator--0caf5c6e-9ebc-4e92-a50c-83253c28c907" .

