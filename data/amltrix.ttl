    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Recurrent transactions routed through professional service providers (e.g., attorneys, accountants, notaries) without full beneficial ownership disclosure, citing client confidentiality as justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00757" ;
    skos:prefLabel "IND00757"@en ;
    amlo:stixId "x-amltrix-indicator--4cc20182-6e53-4dd8-86d5-3ff1c7a49717" .

