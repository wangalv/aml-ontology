    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or contradictory device fingerprints (e.g., OS, time zone, language settings) across consecutive sessions, inconsistent with a single user's typical usage profile."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01108" ;
    skos:prefLabel "IND01108"@en ;
    amlo:stixId "x-amltrix-indicator--35b6a324-fb5e-4287-83b0-9d9e53e5f9f3" .

