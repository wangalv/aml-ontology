    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Structured cash deposits or multiple smurfed transactions referencing commodity trades but lacking associated trade documentation or plausible explanations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02985" ;
    skos:prefLabel "IND02985"@en ;
    amlo:stixId "x-amltrix-indicator--cbdec03f-be4c-4565-8345-323428ff4473" .

