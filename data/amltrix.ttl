    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Frequent invoice adjustments or credit notes issued among affiliated entities without transparent commercial justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00034" ;
    skos:prefLabel "IND00034"@en ;
    amlo:stixId "x-amltrix-indicator--a7a6fc65-7844-4d99-8f9f-bed1181eb938" .

