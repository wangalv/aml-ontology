    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Sudden surges in wrapped token transactions over a short timeframe without a legitimate economic rationale, indicating layering aimed at obscuring illicit funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01247" ;
    skos:prefLabel "IND01247"@en ;
    amlo:stixId "x-amltrix-indicator--2d31a20f-0d5a-493e-ac6b-a749dc3176f4" .

