    amlo:productService amx:PS0073 ;
    amlo:technique amx:T0099 .

<https://example.org/amltrix/link/77372968-16a7-435d-8aa1-4593ef69a302> a amlo:MitigationLink ;
    dct:description "Continuously monitor open-source intelligence, sports integrity databases, and media reports to identify known or suspected instances of match manipulation. Correlate suspicious transaction activity with publicly reported match-fixing events or indicted sports participants, ensuring that flagged accounts or bets receive immediate scrutiny. By leveraging external intelligence, institutions can rapidly confirm ties to rigged matches and take swift action to thwart illicit fund flows."@en ;
    amlo:mitigation amx:M0021 ;
    amlo:technique amx:T0107.005 .

<https://example.org/amltrix/link/773ca85b-b65a-4b60-93ca-bde9f599c388> a amlo:ProductServiceLink ;
    dct:description """- Criminals invest illicit proceeds in real estate portfolios or REITs, blending them with legitimate investor funds.
