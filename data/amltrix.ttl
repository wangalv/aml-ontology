    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Shipping documents devoid of critical identifying details, like vessel name, IMO number, or verifiable shipping route."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00745" ;
    skos:prefLabel "IND00745"@en ;
    amlo:stixId "x-amltrix-indicator--ec070331-7ab1-40f0-88d2-8d60ee5c1a6d" .

