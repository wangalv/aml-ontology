    amlo:dataSource amx:DS0039 ;
    amlo:technique amx:T0086 .

<https://example.org/amltrix/link/9a17ce8b-1a0d-434f-8a71-ce54a1f63f3d> a amlo:DataSourceLink ;
    dct:description """- Provides comprehensive details on trust structures, including beneficiaries, trustees, associated financial accounts, and transaction histories.
