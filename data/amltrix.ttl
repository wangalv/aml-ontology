    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Short time intervals between bank account cash deposits and withdrawals directed to crypto ATM use, reflecting an expedited layering process."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01240" ;
    skos:prefLabel "IND01240"@en ;
    amlo:stixId "x-amltrix-indicator--ba1f8952-ea91-4d5a-a6d4-2a6cbb32dcb5" .

