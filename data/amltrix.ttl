    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Use of non-traditional addresses (virtual offices, PO boxes, or shared facilities) lacking a verifiable standalone commercial location."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02590" ;
    skos:prefLabel "IND02590"@en ;
    amlo:stixId "x-amltrix-indicator--119758fc-723f-40f0-b1d5-f31af03eec66" .

