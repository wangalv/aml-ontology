    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Sudden surge in government disbursements labeled as unemployment benefits to an account with no prior payroll or unemployment-related transaction history."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00749" ;
    skos:prefLabel "IND00749"@en ;
    amlo:stixId "x-amltrix-indicator--0b29ea90-d4ed-4c69-89c8-bf56cf9eebe1" .

