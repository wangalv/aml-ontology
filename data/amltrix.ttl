    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Payments from rigged contracts are systematically structured with round amounts or split into smaller sums to evade detection and reporting thresholds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02567" ;
    skos:prefLabel "IND02567"@en ;
    amlo:stixId "x-amltrix-indicator--cc03a29d-53fe-4644-bbf5-7c129b1f6e57" .

