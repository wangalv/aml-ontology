    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Clients or entities exhibiting opaque beneficial ownership structures, particularly when their business activity is heavily concentrated in cross-border import transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01096" ;
    skos:prefLabel "IND01096"@en ;
    amlo:stixId "x-amltrix-indicator--6efdddf9-af5d-45e0-92b4-6d6266544221" .

