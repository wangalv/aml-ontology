    amlo:actor amx:AT0028 ;
    amlo:technique amx:T0066.002 .

<https://example.org/amltrix/link/12192049-9875-44cd-8668-2dba86e58815> a amlo:TacticLink ;
    dct:description "Money remittance splitting is used to introduce illicit funds into the financial system by keeping individual transfers below reporting thresholds and dispersing them under various sender identities. This reduces the direct detection risk as the proceeds enter legitimate channels."@en ;
    amlo:tactic amx:ML.TA0006 ;
    amlo:technique amx:T0016.003 .

<https://example.org/amltrix/link/121a050d-d5e3-448a-9f34-ed1618866655> a amlo:InstrumentLink ;
    dct:description """- Multi-Currency Swap involves converting illicit funds among various fiat currencies (USD, EUR, JPY, etc.) to break the transaction trail.
- Criminals exploit differential regulations or weaker AML enforcement in certain locations to repeatedly exchange one fiat currency for another.
