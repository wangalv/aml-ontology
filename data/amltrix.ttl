    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Invoice line items indicating higher quantities or inflated unit costs compared to corresponding shipping or delivery records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00029" ;
    skos:prefLabel "IND00029"@en ;
    amlo:stixId "x-amltrix-indicator--cda3eb56-54e0-4f39-935f-bb2b6455d9a2" .

