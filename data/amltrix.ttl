<https://example.org/amltrix/link/3130a77b-b0ca-4c42-8683-bc0788faf121> a amlo:ActorLink ;
    dct:description "Criminals use anonymity networks to access or operate darknet marketplaces that trade illicit goods or services, masking their real IP addresses from both financial institutions and law enforcement. This obfuscation hinders AML teams in tracing payment flows or identifying the individuals behind marketplace transactions, as layered routes and encryption complicate attribution efforts."@en ;
    amlo:actor amx:AT0040 ;
