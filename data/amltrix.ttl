    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Recurring patterns of fictitious sales or transactions designed to portray legitimate activity despite minimal genuine operations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02594" ;
    skos:prefLabel "IND02594"@en ;
    amlo:stixId "x-amltrix-indicator--c150216d-5c56-4a1e-bf68-16d8c4573296" .

