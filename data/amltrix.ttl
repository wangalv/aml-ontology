    amlo:shortDescription "Human traffickers illegally recruit, transport, and exploit individuals for forced labor or sexual exploitation, generating illicit proceeds that are funneled through sophisticated laundering schemes. Their activities pose heightened AML/CFT threats by obscuring transaction flows and necessitating robust detection, reporting, and monitoring frameworks."@en ;
    amlo:stixId "x-amltrix-actor--003a6596-d27c-43fd-a692-4c99e87fe9b1" .

amx:AT0055 a amlo:Actor ;
