    skos:definition "Frequent switching between geographically disparate public WiFi locations within short time spans, inconsistent with a customer's normal travel or daily patterns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02201" ;
    skos:prefLabel "IND02201"@en ;
    amlo:stixId "x-amltrix-indicator--ee0d3105-bde1-4c81-b7e8-65a65b15e92c" .

amx:IND02202 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Customer account registrations or modifications initiated from public WiFi networks accompanied by false or inconsistent personal identification details, raising doubts during the due diligence process."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02202" ;
    skos:prefLabel "IND02202"@en ;
    amlo:stixId "x-amltrix-indicator--07c4901e-aefd-4f40-baa7-2d51fa5a141a" .

amx:IND02203 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "High-value or rapid repeated fund transfers executed from unsecured public WiFi connections that deviate from the customer’s established transactional profile."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02203" ;
    skos:prefLabel "IND02203"@en ;
    amlo:stixId "x-amltrix-indicator--25fbd4f0-9d5b-42fc-923d-771a0c230d48" .

amx:IND02204 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Discrepancies between the geolocation data of the transaction origin (public hotspot) and the customer’s registered or declared address during the CDD process."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02204" ;
    skos:prefLabel "IND02204"@en ;
    amlo:stixId "x-amltrix-indicator--e681887f-a8ec-487e-b291-1708b37178f2" .

amx:IND02205 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Rapid changes in device fingerprints (e.g., browser signatures, device IDs) during sessions from public hotspots, reflecting potential deliberate obfuscation of the user’s identity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02205" ;
    skos:prefLabel "IND02205"@en ;
    amlo:stixId "x-amltrix-indicator--b75f13f5-2257-4143-9a4a-3b2fe22291f5" .

amx:IND02206 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Multiple session logs from distinct public WiFi networks accessing various customer accounts in a condensed timeframe, suggesting coordinated or systematic exploitation of public networks."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02206" ;
    skos:prefLabel "IND02206"@en ;
    amlo:stixId "x-amltrix-indicator--2eba3976-1523-46ed-a3cd-3ed7e6d5e41f" .

amx:IND02207 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Multiple new customer accounts created from the same public WiFi hotspot in a short timeframe, indicating potential coordinated account openings."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02207" ;
    skos:prefLabel "IND02207"@en ;
    amlo:stixId "x-amltrix-indicator--6326bccb-957c-4866-bfbe-dd2102c8f718" .

amx:IND02208 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Offshore transfer amounts or frequencies that significantly deviate from the account holder's historic transaction patterns and stated business profile."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02208" ;
    skos:prefLabel "IND02208"@en ;
    amlo:stixId "x-amltrix-indicator--197217e1-86b9-483d-a15c-127a46e113a4" .

amx:IND02209 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Transfer routes involving multiple intermediary or correspondent banks across different jurisdictions without a clear economic or commercial justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02209" ;
    skos:prefLabel "IND02209"@en ;
    amlo:stixId "x-amltrix-indicator--b5bc7bb1-7200-49da-9052-93ddc157ff2a" .

