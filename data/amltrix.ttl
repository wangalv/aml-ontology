<https://example.org/amltrix/link/6d509c2d-073d-48f1-b4b4-1a57f5989ba2> a amlo:ProductServiceLink ;
    dct:description """- Maintain undisclosed accounts or funds in offshore financial centers, bypassing domestic reporting requirements.  
