    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Multiple insurance policies purchased in short succession, using various insurers or jurisdictions, and surrendered early despite incurring substantial penalties."@en ;
