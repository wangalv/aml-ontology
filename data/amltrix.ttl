    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Frequent cross-chain transfers from transparent blockchains into privacy wallets or anonymity-focused cryptocurrencies, inconsistent with the user’s normal behavior or stated business purpose."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01094" ;
    skos:prefLabel "IND01094"@en ;
    amlo:stixId "x-amltrix-indicator--449018a1-64cd-4647-88f6-b170bedc3a69" .

