    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Abrupt increase or complexity in transaction volumes handled by a public official or employee with financial authority, lacking legitimate budgetary justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02536" ;
    skos:prefLabel "IND02536"@en ;
    amlo:stixId "x-amltrix-indicator--ac28728f-1a0d-4551-8808-4beca88702f2" .

