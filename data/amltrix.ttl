    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "High similarity in the structure, formatting, or technical content of bid proposals among different companies, suggesting coordinated preparation of bids."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02568" ;
    skos:prefLabel "IND02568"@en ;
    amlo:stixId "x-amltrix-indicator--d57f7bd9-83d6-40f3-bdd6-6677626a4207" .

