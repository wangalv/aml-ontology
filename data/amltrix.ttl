    amlo:productService amx:PS0070 ;
    amlo:technique amx:T0048.001 .

<https://example.org/amltrix/link/31a8a3e6-efb3-4db4-be55-9059f34a9255> a amlo:ProductServiceLink ;
    dct:description """- Criminals leverage multiple passports to register shell entities in jurisdictions with lax AML oversight.  
