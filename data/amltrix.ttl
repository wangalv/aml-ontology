    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Use of charitable foundations or NGOs to funnel agribusiness funds with no verifiable philanthropic or operational activities, obscuring beneficial ownership and fund flows."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00756" ;
    skos:prefLabel "IND00756"@en ;
    amlo:stixId "x-amltrix-indicator--89b5a87b-75e2-44a9-90d4-1fd2e4505abd" .

