    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Transactions routed through non-standard approval channels that skip multi-level sign-off processes."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01405" ;
    skos:prefLabel "IND01405"@en ;
    amlo:stixId "x-amltrix-indicator--67056dd4-4171-483c-8e5a-ec9e6510f089" .

