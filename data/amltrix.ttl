    dct:modified "2025-05-13T07:47:21.800681+00:00"^^xsd:dateTime ;
    skos:definition "Multiple newly formed or dormant corporations at the respondent bank funnel funds via the same correspondent route, lacking evidence of operational activity or legitimate commercial ties among them."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01411" ;
    skos:prefLabel "IND01411"@en ;
    amlo:stixId "x-amltrix-indicator--2f21c8df-e0a8-4782-9be2-df4d5c14f053" .

