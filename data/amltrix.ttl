    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Intentional splitting of transactions to avoid triggering reporting requirements (e.g., consistent deposits of just under the threshold)."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01058" ;
    skos:prefLabel "IND01058"@en ;
    amlo:stixId "x-amltrix-indicator--036ca15b-3090-4cd1-b5d4-0a16f615d3a1" .

