    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Frequent reimbursement requests supported by receipts from vendors that cannot be verified through open-source or official registries."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02102" ;
    skos:prefLabel "IND02102"@en ;
    amlo:stixId "x-amltrix-indicator--bfe095cc-3187-41d2-8a23-a17f920e21d4" .

