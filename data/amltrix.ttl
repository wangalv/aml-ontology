    rdfs:seeAlso <https://framework.amltrix.com/actors/AT0033> ;
    skos:definition "An enterprise or individual offering financial services such as currency exchange, money transmission, or check cashing outside traditional banking channels. These entities often serve customers with limited access to mainstream financial institutions by providing alternative or more flexible solutions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "AT0033" ;
    skos:prefLabel "Money Services Business"@en ;
