    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Employee repeatedly reclassifies personal expenses (e.g., electronics, clothing) as work-related costs in the accounting system."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02104" ;
    skos:prefLabel "IND02104"@en ;
    amlo:stixId "x-amltrix-indicator--1c40cac8-74e2-45f9-9de0-67de97354c7a" .

