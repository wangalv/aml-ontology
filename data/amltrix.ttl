    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "While checking trade documentation, repetitive shipments of the same or similar goods with drastically different pricing, unusual patterns in shipping routes or transit points, mismatched shipping quantity, weight, or type."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01097" ;
    skos:prefLabel "IND01097"@en ;
    amlo:stixId "x-amltrix-indicator--f8378fe0-4c1e-436a-95c8-a0b3e49e0c3b" .

