    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Financed amounts are disproportionately large relative to the company's historical or declared commercial activity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02094" ;
    skos:prefLabel "IND02094"@en ;
    amlo:stixId "x-amltrix-indicator--4e3d30a1-418d-4b0c-a9aa-bd4c82ba82c0" .

