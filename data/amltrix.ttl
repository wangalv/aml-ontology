    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Frequent revisions or multiple versions of invoices created shortly after the initial trade transaction."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01016" ;
    skos:prefLabel "IND01016"@en ;
    amlo:stixId "x-amltrix-indicator--f5436dc3-d5ce-4e48-8291-913de0f04b48" .

