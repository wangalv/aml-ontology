    dct:modified "2025-05-13T07:47:21.816822+00:00"^^xsd:dateTime ;
    skos:definition "Customers frequently request large remittance amounts but reduce the transfer significantly after compliance or documentation inquiries, without providing a consistent explanation."@en ;
