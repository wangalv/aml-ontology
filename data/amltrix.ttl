        amx:T0074,
        amx:T0103,
        amx:T0111 ;
    amlo:shortDescription "Supply Chain Financing optimizes buyer-supplier cash flows by extending buyers’ payment terms and offering early settlement to suppliers. In AML/CFT adversarial threat modelling, its complex transaction flows and reliance on invoicing can present opportunities for concealing illicit funds if not properly monitored."@en ;
    amlo:stixId "products-service--94b2e5d1-f622-412f-9e48-5d56a87f4819" .

amx:AT0002 a amlo:Actor ;
