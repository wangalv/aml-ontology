    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Transfers processed via foreign correspondent banks with historically limited compliance track records or beneficial owner disclosure."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02210" ;
    skos:prefLabel "IND02210"@en ;
    amlo:stixId "x-amltrix-indicator--8ce6cf23-0261-4882-be9d-22518f17f8b7" .

