    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Multiple cross-border transfers from or to jurisdictions known for lax controls on smuggled or illicit commodities, with no clear commercial rationale or supporting documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02984" ;
    skos:prefLabel "IND02984"@en ;
    amlo:stixId "x-amltrix-indicator--f044a278-e44a-41a1-aee1-c83908a97a6d" .

