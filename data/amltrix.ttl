    dct:modified "2025-05-13T07:47:21.790245+00:00"^^xsd:dateTime ;
    skos:definition "Material or repeated discrepancies between declared inter-company prices for goods or services and recognized industry benchmarks or external market data, lacking plausible commercial justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00505" ;
    skos:prefLabel "IND00505"@en ;
    amlo:stixId "x-amltrix-indicator--c544f720-9a11-4514-a223-030a0ed7c947" .

