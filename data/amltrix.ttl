    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Repetitive transactions involving round-number amounts that are quickly moved from bank accounts to crypto ATMs, structured to avoid detection thresholds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01239" ;
    skos:prefLabel "IND01239"@en ;
    amlo:stixId "x-amltrix-indicator--194bad45-865d-407e-93d4-f8eee0f9c97b" .

