    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Multiple invoices from the same vendor featuring round-figure amounts or amounts deviating significantly from typical market rates, consistent with fabricated invoicing."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01345" ;
    skos:prefLabel "IND01345"@en ;
    amlo:stixId "x-amltrix-indicator--414661c5-e163-40d5-bc38-0f420acf6492" .

amx:IND01346 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Discrepancies between vendor registration information and official business registries, such as inconsistent tax or registration numbers, indicating fraudulent vendor identity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01346" ;
    skos:prefLabel "IND01346"@en ;
    amlo:stixId "x-amltrix-indicator--1dc03e1d-d777-4e60-8f27-ed009351a03f" .

amx:IND01347 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Rapid creation and activation of vendor accounts, followed immediately by invoice submissions with no prior business history, consistent with intentional fake vendor setup."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01347" ;
    skos:prefLabel "IND01347"@en ;
    amlo:stixId "x-amltrix-indicator--77e0b2dc-d2b5-4165-8f77-6606654570b1" .

