    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Invoices for traded goods deviate significantly from known market rates without legitimate justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02099" ;
    skos:prefLabel "IND02099"@en ;
    amlo:stixId "x-amltrix-indicator--31d02617-8b17-4fda-a4e4-31b98145cb53" .

