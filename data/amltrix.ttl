    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "A rapid sequence where funds are withdrawn as cash from bank accounts and then quickly deposited into crypto ATMs, often within a very short timeframe."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01234" ;
    skos:prefLabel "IND01234"@en ;
    amlo:stixId "x-amltrix-indicator--0271a3a0-f833-47bc-a75d-3ceea0acd153" .

