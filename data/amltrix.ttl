    skos:definition "Organizations that specialize in moving or concealing illicit proceeds on behalf of criminal actors or enterprises, often operating in multiple regions or industries."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "AT0055" ;
    skos:prefLabel "Professional Money Laundering Networks"@en ;
