    skos:notation "IND00021" ;
    skos:prefLabel "IND00021"@en ;
    amlo:stixId "x-amltrix-indicator--b07d371c-524c-4b31-b25b-04537aa4b83c" .

amx:IND00022 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Repeated issuance of invoices with unit prices or overall costs that exceed established industry or market benchmarks, with no valid documentation to justify the markup."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00022" ;
    skos:prefLabel "IND00022"@en ;
    amlo:stixId "x-amltrix-indicator--ff64ed16-e766-49fd-99cd-a6bbd5b6aff3" .

amx:IND00023 a amlo:Indicator ;
