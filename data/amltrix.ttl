    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Transactions with volumes or amounts inconsistent with the legitimate operational capacity of the declared jewelry business."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02588" ;
    skos:prefLabel "IND02588"@en ;
    amlo:stixId "x-amltrix-indicator--dfafcb28-309e-46c9-afaa-050209a10d74" .

