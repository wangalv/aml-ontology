    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Repeated submission of the same invoice or shipping documents across multiple financing requests or trade transactions for a single shipment."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01021" ;
    skos:prefLabel "IND01021"@en ;
    amlo:stixId "x-amltrix-indicator--86916bfd-81ce-4c0f-bd39-f18521f2fd6e" .

