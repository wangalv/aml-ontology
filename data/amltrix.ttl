    dct:modified "2025-05-13T07:47:21.816822+00:00"^^xsd:dateTime ;
    skos:definition "Business registration information shows recent or suspiciously timed changes in ownership or scope of operations right before applying for a relief program."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02776" ;
    skos:prefLabel "IND02776"@en ;
    amlo:stixId "x-amltrix-indicator--f59d16cb-2f1a-4997-8d5b-b4c1cfa81426" .

