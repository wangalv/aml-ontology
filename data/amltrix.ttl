    dct:modified "2025-05-13T07:47:21.787374+00:00"^^xsd:dateTime ;
    skos:definition "Deposits coincide with normal inbound payment schedules but have amounts or splitting patterns that deviate from typical recurring payments."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00276" ;
