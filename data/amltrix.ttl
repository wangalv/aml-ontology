    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Customer repeatedly requests changes in disbursement methods or banking details for unemployment benefits without reasonable explanation, especially across multiple state programs."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00750" ;
    skos:prefLabel "IND00750"@en ;
    amlo:stixId "x-amltrix-indicator--6643acc0-aa94-4283-baaf-3c7a9e536ff5" .

