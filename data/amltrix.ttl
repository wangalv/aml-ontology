    dct:modified "2025-05-13T07:47:21.810936+00:00"^^xsd:dateTime ;
    skos:definition "Repeated transfers of high-value insurance policies to entities or individuals in jurisdictions with limited AML/CFT oversight."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02231" ;
    skos:prefLabel "IND02231"@en ;
    amlo:stixId "x-amltrix-indicator--b7499761-bb68-4cea-81a7-9427d8d8f9ed" .

