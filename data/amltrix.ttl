    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Frequent conversions of foreign currency to local currency with minimal gaming activity, followed by rapid chip redemption or cheque issuance."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01211" ;
    skos:prefLabel "IND01211"@en ;
