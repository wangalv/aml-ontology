    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Rapid, consecutive transactions with minimal holding periods in and out of privacy wallets indicate that funds are being quickly mixed and redistributed."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00023" ;
    skos:prefLabel "IND00023"@en ;
    amlo:stixId "x-amltrix-indicator--e1d9fd64-9e02-4db4-905e-917cf6d2d42a" .

amx:IND00024 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Multiple incoming transfers from unrelated external sources converging into a privacy wallet followed by dispersal to a variety of destinations signal the merging and shuffling of funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00024" ;
    skos:prefLabel "IND00024"@en ;
    amlo:stixId "x-amltrix-indicator--4e604a79-beed-4af3-9607-c7a3fbdb406b" .

amx:IND00025 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "High volumes of digital assets routed through addresses associated with coin mixers or tumblers that deviate from the customer’s typical transactional patterns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00025" ;
    skos:prefLabel "IND00025"@en ;
    amlo:stixId "x-amltrix-indicator--54370a3e-9a88-49f2-bd45-450497f22d70" .

amx:IND00026 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Repeated layering of transactions through privacy wallets, where funds are merged and re-distributed in multiple stages, creating complex patterns that obscure original sources and end recipients."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00026" ;
    skos:prefLabel "IND00026"@en ;
    amlo:stixId "x-amltrix-indicator--0ef18acb-a622-481b-b426-73ab363ddeb5" .

amx:IND00027 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.784118+00:00"^^xsd:dateTime ;
    skos:definition "Significant cash outflows described as wages remain unaligned with officially reported labor costs over the same period."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00027" ;
    skos:prefLabel "IND00027"@en ;
    amlo:stixId "x-amltrix-indicator--d4271e57-7dd0-478f-bfd3-3b06d6ee6ab8" .

