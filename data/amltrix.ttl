    amlo:technique amx:T0115.002 .

<https://example.org/amltrix/link/258977fd-f6d0-4ca6-b35a-e20ac58d85db> a amlo:DataSourceLink ;
    dct:description "Captures comprehensive records of financial transactions from newly opened or existing accounts. Sudden high-value or rapid transaction patterns linked to questionable identity documentation can be identified and flagged, helping to expose potentially manipulated or fraudulent account setups."@en ;
    amlo:dataSource amx:DS0019 ;
    amlo:technique amx:T0023 .

<https://example.org/amltrix/link/258c032a-fd1f-4750-827b-e69a556b1b77> a amlo:ProductServiceLink ;
    dct:description """- Criminals employ complicit accountants or auditors to falsify ledger entries, accruals, and other financial figures, masking the true source of illicit income.  
- Fabricated or backdated entries create a misleading financial narrative, obscuring suspicious cash flows from regulators and investigators."""@en ;
    amlo:productService amx:PS0116 ;
