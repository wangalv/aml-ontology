    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Minimal or inconsistent inventory or supply-related expenditures relative to reported sales or revenues, suggesting limited actual business activity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01091" ;
    skos:prefLabel "IND01091"@en ;
    amlo:stixId "x-amltrix-indicator--8395252c-9d10-45c9-bbca-977d97e1083d" .

