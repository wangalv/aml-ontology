    dct:modified "2025-05-13T07:47:20.137357+00:00"^^xsd:dateTime ;
    rdfs:seeAlso <https://framework.amltrix.com/instruments/IN0020> ;
    skos:definition "Applications or devices that store cryptographic keys and enable the management and transfer of virtual assets, including self-hosted and multi-signature configurations. They provide users with direct control of their digital holdings and facilitate secure transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IN0020" ;
    skos:prefLabel "Cryptocurrency Wallets"@en ;
