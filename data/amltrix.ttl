amx:DS0045 a amlo:DataSource ;
    dct:created "2025-05-13T07:47:20.014988+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:20.014988+00:00"^^xsd:dateTime ;
    rdfs:seeAlso <https://framework.amltrix.com/data-sources/DS0045> ;
    skos:definition "Comprehensive data from public blockchain ledgers and related analytics, including transaction IDs, timestamps, sender and receiver addresses, and amounts for digital asset transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "DS0045" ;
    skos:prefLabel "Blockchain and Cryptocurrency Data"@en ;
    amlo:shortDescription "This data source provides critical visibility into the flow of digital assets by capturing transaction IDs, timestamps, wallet addresses, and transaction amounts on public blockchain ledgers. It is essential for tracing illicit activities, identifying high-risk entities, and detecting patterns of money laundering or terrorist financing attempts involving cryptocurrencies."@en ;
    amlo:stixId "x-amltrix-data-source--17af3322-0746-4f7b-8e6a-63786b79e54c" .

amx:DS0027 a amlo:DataSource ;
    dct:created "2025-05-13T07:47:20.015597+00:00"^^xsd:dateTime ;
