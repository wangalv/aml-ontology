    amlo:dataSource amx:DS0047 ;
    amlo:technique amx:T0024.001 .

<https://example.org/amltrix/link/3d0fd17d-e762-4ded-9e88-646ec62dbf05> a amlo:DataSourceLink ;
    dct:description """- Contains records of individuals holding prominent public or political positions and their associated entities.
