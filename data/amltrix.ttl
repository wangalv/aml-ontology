    dct:created "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Refusal or avoidance by a public official or employee who handles government funds to take mandatory leave or rotation, potentially concealing ongoing misappropriation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02535" ;
    skos:prefLabel "IND02535"@en ;
    amlo:stixId "x-amltrix-indicator--c1f3269d-de3f-47fa-bf36-5f50dc1f3c93" .

