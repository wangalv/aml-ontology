    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Multiple online profiles with differing contact details or addresses for the same P2P exchanger, raising identity consistency concerns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01362" ;
    skos:prefLabel "IND01362"@en ;
    amlo:stixId "x-amltrix-indicator--09f1f62c-6d9d-4f6f-8cae-501d0e4ced0b" .

