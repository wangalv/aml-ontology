    amlo:productService amx:PS0017 ;
    amlo:technique amx:T0140 .

<https://example.org/amltrix/link/5e9ca2a0-9c98-4458-a5d6-18b411b3819b> a amlo:ProductServiceLink ;
    dct:description """- Aggregate diverse payment channels, potentially mixing illicit child exploitation revenues with legitimate transactions.
