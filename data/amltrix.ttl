    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Rapid in-and-out movement of funds through accounts controlled by a professional intermediary, lacking a legitimate commercial or settlement purpose, and deviating from their usual geographic coverage."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02228" ;
    skos:prefLabel "IND02228"@en ;
    amlo:stixId "x-amltrix-indicator--7021e240-dd51-4749-9c88-c3ef0fd24a81" .

