    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "A predominance of cash-based transactions or round-sum payments in a business sector that typically relies on secured, traceable payments."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02592" ;
    skos:prefLabel "IND02592"@en ;
    amlo:stixId "x-amltrix-indicator--36918fac-2035-474f-b9c5-dd1ed38afe50" .

