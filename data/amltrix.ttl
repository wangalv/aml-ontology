    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Inconsistent or suspiciously vague descriptions of goods in shipping documents."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00746" ;
    skos:prefLabel "IND00746"@en ;
    amlo:stixId "x-amltrix-indicator--e0af113e-45ad-40c6-8035-063c2f8a3f19" .

