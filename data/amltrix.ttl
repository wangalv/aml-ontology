    amlo:productService amx:PS0078 ;
    amlo:technique amx:T0094 .

<https://example.org/amltrix/link/b64af5ce-6570-4fa2-b4b6-531b0c991ce1> a amlo:MitigationLink ;
    dct:description "During onboarding and routine account reviews, confirm each customer's declared occupation, income sources, and purpose of the account. Cross-reference external data or OSINT to detect contradictions in background information that may arise when customers are recruited as money mules through fake job offers, romance scams, or other deceptive tactics."@en ;
    amlo:mitigation amx:M0003 ;
    amlo:technique amx:T0011 .

<https://example.org/amltrix/link/b653c729-9b50-41c7-b3c4-73b9d7fa517f> a amlo:ActorLink ;
    dct:description """Shipping and logistics companies, knowingly or unknowingly, move illegally sourced timber by:

