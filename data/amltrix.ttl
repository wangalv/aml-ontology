    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Recently opened accounts belonging to individuals recruited via suspicious job postings or social media offers to receive and transfer funds for a commission, consistent with money mule operations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
