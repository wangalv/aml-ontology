    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Bidding entities share overlapping beneficial ownership, directorship, or key stakeholder roles, indicating collusion."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02565" ;
    skos:prefLabel "IND02565"@en ;
    amlo:stixId "x-amltrix-indicator--1bfc3683-6b43-4954-b09c-b004c20f0edb" .

