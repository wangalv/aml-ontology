    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Access to mining pools is predominantly conducted through anonymizing tools such as VPNs or proxies, obscuring the true source location of the mining activity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01328" ;
    skos:prefLabel "IND01328"@en ;
    amlo:stixId "x-amltrix-indicator--218d57ff-58e6-4c61-b82d-8d81041fde8e" .

