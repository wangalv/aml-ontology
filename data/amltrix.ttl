    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "A customer's account frequently receives mining reward volumes that significantly exceed the yield expected from their declared mining capacity or usage data."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01325" ;
    skos:prefLabel "IND01325"@en ;
    amlo:stixId "x-amltrix-indicator--e9b1528c-5d6f-4c9b-9fb5-3bbc361bb8b9" .

amx:IND01326 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Mining rewards are rapidly liquidated into fiat or alternative cryptocurrencies soon after being credited, indicating a layering pattern."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01326" ;
    skos:prefLabel "IND01326"@en ;
    amlo:stixId "x-amltrix-indicator--ca27f5b7-e5d8-4031-9440-eafdd5c005e7" .

amx:IND01327 a amlo:Indicator ;
