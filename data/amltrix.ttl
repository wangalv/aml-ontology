    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Repeated logins or transaction requests from IP addresses recognized as Tor exit nodes, indicating usage of anonymizing networks to hide the user's true location."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01109" ;
    skos:prefLabel "IND01109"@en ;
    amlo:stixId "x-amltrix-indicator--418c20c7-8fd5-499a-8a86-bbb4578c9e32" .

amx:IND01110 a amlo:Indicator ;
