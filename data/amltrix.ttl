    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Invoiced amounts that are significantly misaligned with prevailing market prices for the stated goods or services reflect deliberate manipulation of invoice values."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01352" ;
    skos:prefLabel "IND01352"@en ;
    amlo:stixId "x-amltrix-indicator--e767f284-c850-4f3a-baf3-43b97f5fcb91" .

