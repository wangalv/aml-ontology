    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Provision of unverifiable or non-existent residential addresses (e.g., PO boxes, virtual offices, mail forwarding services) as part of identity documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
