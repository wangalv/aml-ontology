    dct:modified "2025-05-13T07:47:21.787374+00:00"^^xsd:dateTime ;
    skos:definition "Junket promoters or VIP clients refuse or fail to disclose ultimate beneficial ownership details when prompted by casino or regulators."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00278" ;
    skos:prefLabel "IND00278"@en ;
