    amlo:dataSource amx:DS0002 ;
    amlo:technique amx:T0111.001 .

<https://example.org/amltrix/link/3d14429f-4bfa-4472-9427-5b13bba81688> a amlo:ActorLink ;
    dct:description """Peer-to-peer exchange operators enable direct user-to-user cryptocurrency transactions by:

- Offering markets with minimal identity verification, allowing criminals to move funds quickly across multiple accounts.
