        amx:T0053,
        amx:T0083,
        amx:T0092,
        amx:T0105,
        amx:T0144.010 ;
    amlo:shortDescription "ATM services enable 24/7 access to a range of banking transactions, making them critical for customer convenience but also potentially susceptible to money laundering or terrorist financing risks if not properly monitored and controlled."@en ;
    amlo:stixId "products-service--c7400835-bf46-4063-bc92-8ea852521eb9" .

amx:PS0088 a amlo:ProductService ;
