    skos:definition "Customer or counterparty with a history of being involved in legal or regulatory issues related to trade."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02604" ;
    skos:prefLabel "IND02604"@en ;
