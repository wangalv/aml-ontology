    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Transactions routing funds through smart contract addresses known to function as decentralized mixers, where funds from multiple sources are pooled and then redistributed."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00758" ;
    skos:prefLabel "IND00758"@en ;
    amlo:stixId "x-amltrix-indicator--1d4d294f-2498-4894-b339-623e846b6968" .

