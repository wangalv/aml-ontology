    amlo:dataSource amx:DS0005 ;
    amlo:technique amx:T0107 .

<https://example.org/amltrix/link/095808ad-76f9-4318-99c6-67219f2cb84c> a amlo:DataSourceLink ;
    dct:description """- Provides complete records of deposits, withdrawals, and transfers, capturing timestamps, amounts, and IBAN references.
- Directly supports the detection of repeated usage of multiple virtual IBAN references, unusually short holding periods, and rapid fund layering outflows, enabling targeted AML investigations."""@en ;
