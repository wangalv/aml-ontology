    skos:definition "Significant discrepancies between a government agency’s official financial statements and actual cash flow or bank records, suggesting potential misappropriation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02539" ;
    skos:prefLabel "IND02539"@en ;
    amlo:stixId "x-amltrix-indicator--fbdb9898-2e74-48bb-b4da-8389ad09a2e2" .

