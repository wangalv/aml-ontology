    dct:modified "2025-05-13T07:47:21.797699+00:00"^^xsd:dateTime ;
    skos:definition "Frequent bridging or swapping of newly minted tokens or stablecoins via minimal-KYC or decentralized platforms immediately following burn events, complicating provenance tracing."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01179" ;
    skos:prefLabel "IND01179"@en ;
    amlo:stixId "x-amltrix-indicator--a8949558-f34f-4e9d-bd43-d0373b8725fb" .

