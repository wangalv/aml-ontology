        amx:T0015.002,
        amx:T0062.003,
        amx:T0111,
        amx:T0140,
        amx:T0149 ;
    amlo:shortDescription "Professional Money Laundering Networks are specialized, cross-border service providers that facilitate the layering, integration, and ultimate concealment of illicit proceeds on behalf of criminal enterprises, exploiting multi-jurisdictional vulnerabilities and diverse industry channels. Their sophisticated operations pose a high-level AML/CFT threat, circumventing regulatory controls through complex laundering methods, shell entities, and other evasive techniques."@en ;
    amlo:stixId "x-amltrix-actor--23109c27-d27e-421a-b843-a79d377b00ed" .

amx:AT0103 a amlo:Actor ;
