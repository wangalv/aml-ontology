    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Multiple unemployment benefit payments from different states or agencies deposited into the same account within a short timeframe, despite no employment history in those jurisdictions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00748" ;
    skos:prefLabel "IND00748"@en ;
    amlo:stixId "x-amltrix-indicator--f0a170f3-810f-4fdf-b07c-ef5981f01bca" .

