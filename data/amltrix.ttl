    dct:modified "2025-05-13T07:47:21.800681+00:00"^^xsd:dateTime ;
    skos:definition "Respondent bank repeatedly fails to respond to information requests or provide supporting documents for suspicious cross-border transactions, indicating lax internal AML controls."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01413" ;
    skos:prefLabel "IND01413"@en ;
    amlo:stixId "x-amltrix-indicator--5196a510-a4c1-4128-af71-2c3ec1e307f5" .

