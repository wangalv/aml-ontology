    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Rapid In/Out Movements: funds are deposited and then transferred out shortly thereafter, with little to no business rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01059" ;
    skos:prefLabel "IND01059"@en ;
    amlo:stixId "x-amltrix-indicator--ab08954a-b20f-442b-a8a7-d9c467090c8b" .

amx:IND01060 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Multiple small deposits (often below reporting thresholds) made into one account by different individuals, followed by large international transfers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01060" ;
    skos:prefLabel "IND01060"@en ;
    amlo:stixId "x-amltrix-indicator--244c83a6-69ea-4f01-8eef-96149ef3ddd6" .

