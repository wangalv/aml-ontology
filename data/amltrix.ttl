    amlo:instrument amx:IN0027 ;
    amlo:technique amx:T0100 .

<https://example.org/amltrix/link/9a470b7d-645f-4e0f-8b07-c4d4796a390b> a amlo:MitigationLink ;
    dct:description "Validate product certifications and documentation related to warehoused goods against recognized industry databases, public registries, and reputable third-party sources. Conduct spot-checks for forged or expired certificates (e.g., precious stones or commodities) and identify flags in adverse media that indicate warehouse-based smuggling or laundering schemes."@en ;
    amlo:mitigation amx:M0021 ;
