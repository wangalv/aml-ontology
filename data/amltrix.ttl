    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Multiple new accounts opened within a short timeframe by individuals with matching or highly similar addresses or nationalities, consistent with coordinated money mule recruitment."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01110" ;
    skos:prefLabel "IND01110"@en ;
    amlo:stixId "x-amltrix-indicator--c00d45d4-9d76-4df6-8fbb-78b4462682c4" .

