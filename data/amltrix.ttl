    amlo:productService amx:PS0089 ;
    amlo:technique amx:T0006 .

<https://example.org/amltrix/link/7ea7fe46-549d-4284-868d-232e2c0de77a> a amlo:DataSourceLink ;
    dct:description """- Includes official financial statements, tax filings, and payroll records for a given entity.
