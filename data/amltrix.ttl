    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "A large crypto deposit is immediately followed by numerous small, fragmented transfers that distribute the original amount into smaller sums."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01029" ;
    skos:prefLabel "IND01029"@en ;
    amlo:stixId "x-amltrix-indicator--361e4bba-42db-4a4a-a8a3-22ee50e0247e" .

