    amlo:instrument amx:IN0012 ;
    amlo:technique amx:T0066.002 .

<https://example.org/amltrix/link/318fca78-55a9-49eb-b16c-95da9a399c39> a amlo:ProductServiceLink ;
    dct:description """- Enables preparation and submission of shipping documents, invoices, and certificates, which criminals can falsify to conceal actual value or origin.  
