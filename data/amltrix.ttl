    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Customer openly references trust-based or familial networks to facilitate large cross-border transfers without formal contracts or documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01069" ;
    skos:prefLabel "IND01069"@en ;
