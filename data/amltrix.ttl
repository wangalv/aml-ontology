    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Currency exchange or settlement agreements at rates or terms significantly more advantageous than official channels, suggesting parallel market involvement."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01100" ;
    skos:prefLabel "IND01100"@en ;
    amlo:stixId "x-amltrix-indicator--d0fa1bca-69be-4b62-bf1e-0499d2b6891b" .

