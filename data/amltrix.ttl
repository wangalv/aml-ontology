    amlo:tactic amx:ML.TA0007 ;
    amlo:technique amx:T0079 .

<https://example.org/amltrix/link/3aed094a-ed30-46f3-b9e8-4c19eb2b91c3> a amlo:InstrumentLink ;
    dct:description """- Illicit proceeds from cryptojacking can be dispensed as physical cash via cryptocurrency ATMs or over-the-counter P2P trades with minimal or falsified ID checks.
