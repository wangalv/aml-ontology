<https://example.org/amltrix/link/a33cd689-f42e-4c93-9d2a-71cba976ff01> a amlo:ProductServiceLink ;
    dct:description """- Mules use debit cards linked to personal or newly opened accounts to receive and withdraw criminal proceeds.  
