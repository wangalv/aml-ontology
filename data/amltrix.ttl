    dct:modified "2025-05-13T07:47:21.794970+00:00"^^xsd:dateTime ;
    skos:definition "Partner outlets conduct transaction volumes far exceeding typical local business benchmarks with no proportional increase in supporting documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02129" ;
    skos:prefLabel "IND02129"@en ;
    amlo:stixId "x-amltrix-indicator--58732caa-fc54-4181-9f53-50d038276c7c" .

