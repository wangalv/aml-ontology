    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Multiple bank accounts exhibit similar patterns of immediate cash withdrawals followed by deposits into crypto ATMs, indicative of a coordinated network of mules."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01236" ;
    skos:prefLabel "IND01236"@en ;
    amlo:stixId "x-amltrix-indicator--c94ee872-38f7-4633-b9b0-351ed9a4ff93" .

