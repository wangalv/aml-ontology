    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Frequent large inbound wire transfers labeled as 'foreign capital injections' that substantially exceed the local entity’s typical business revenue or operational capacity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00772" ;
    skos:prefLabel "IND00772"@en ;
