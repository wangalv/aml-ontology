    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Professional intermediary advising or instructing clients to structure or conceal transactions in order to circumvent AML controls or reporting thresholds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02230" ;
    skos:prefLabel "IND02230"@en ;
    amlo:stixId "x-amltrix-indicator--c3ddb48d-dc37-463d-a734-2cffcd6addc5" .

