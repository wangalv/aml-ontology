    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "A sudden change in payment account details for a known vendor without prior notice or verification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02503" ;
    skos:prefLabel "IND02503"@en ;
    amlo:stixId "x-amltrix-indicator--45892f33-5c93-4828-b78e-355f34f6cf12" .

