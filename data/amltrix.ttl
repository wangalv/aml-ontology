    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Inconsistent or grouped intermediary-facilitated transactions featuring discrepancies in fees or beneficiary details, diverging from standard practices."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01084" ;
    skos:prefLabel "IND01084"@en ;
    amlo:stixId "x-amltrix-indicator--486723d2-b428-4b23-bfbf-864b7c8bcd7b" .

