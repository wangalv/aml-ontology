    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Newly generated blockchain addresses used for multiple sub-threshold deposits show no linkage to any verified individual or beneficial owner, contrary to known account relationships."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01338" ;
    skos:prefLabel "IND01338"@en ;
    amlo:stixId "x-amltrix-indicator--65fedde6-cd0b-4e73-b6d4-50c1205a0e57" .

