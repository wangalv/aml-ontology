    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Investment company engages in frequent buying and selling of assets with little or no economic rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00764" ;
    skos:prefLabel "IND00764"@en ;
    amlo:stixId "x-amltrix-indicator--67b077f7-41b6-4a8c-8d92-9ed957434fc4" .

amx:IND00765 a amlo:Indicator ;
