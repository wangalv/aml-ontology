    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Multiple third-party signatories or proxies authorized on accounts without credible evidence of a legitimate role or business affiliation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01085" ;
    skos:prefLabel "IND01085"@en ;
    amlo:stixId "x-amltrix-indicator--088a91b1-3712-4f60-9755-cf8a982b1298" .

