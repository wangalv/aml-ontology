        amx:T0061,
        amx:T0061.003,
        amx:T0144.017,
        amx:T0144.019 ;
    amlo:shortDescription "Collective Investment Schemes pool funds from diverse investors into professionally managed, diversified portfolios, which can inadvertently facilitate money laundering if ownership transparency or cross-border transaction controls are insufficient, underscoring the need for robust AML/CFT measures."@en ;
    amlo:stixId "products-service--96950876-1a6e-4392-b848-7b0c5a7cb067" .

