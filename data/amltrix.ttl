    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "A recurring association between specific bank employees and the authorization of flagged transactions across multiple customer accounts, without a clear mitigating rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01403" ;
    skos:prefLabel "IND01403"@en ;
    amlo:stixId "x-amltrix-indicator--e9a46bc4-95d0-4da5-a6ed-63a8fbcbe9d7" .

