    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Proceeds from smuggled goods used directly to purchase new illicit shipments abroad, bypassing standard trade financing or documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02585" ;
    skos:prefLabel "IND02585"@en ;
    amlo:stixId "x-amltrix-indicator--c6085697-6008-449b-b42e-64f0674b9af1" .

