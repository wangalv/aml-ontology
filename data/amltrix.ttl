<https://example.org/amltrix/link/7ddad93b-72b7-48ab-9767-6a6ffe4e66a9> a amlo:ProductServiceLink ;
    dct:description """- Criminals can falsify or manipulate import/export invoices and other underlying documents, disguising the true nature or recipient of funds.  
