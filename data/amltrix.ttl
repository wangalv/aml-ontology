amx:IND02576 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or rapid transfers among multiple MSB-controlled accounts with minimal holding periods and no clear business rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02576" ;
    skos:prefLabel "IND02576"@en ;
    amlo:stixId "x-amltrix-indicator--a1fafe5e-c15e-45af-9f46-e50f912e4823" .

amx:IND02577 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Fewer suspicious transaction reports filed than expected given the MSB’s high-risk transaction profile and clientele."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02577" ;
    skos:prefLabel "IND02577"@en ;
    amlo:stixId "x-amltrix-indicator--e40ce204-ef0c-430e-bc42-543b9fb49b7c" .

amx:IND02578 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "MSB ownership or directorship linked to high-risk individuals, PEPs, or offshore entities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02578" ;
    skos:prefLabel "IND02578"@en ;
    amlo:stixId "x-amltrix-indicator--c7e66d17-36e4-42bb-9701-f7f8733f7afb" .

amx:IND02579 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Repeated import and re-export patterns of the same goods or intangible services among related entities, indicating systematic exploitation of VAT refunds with minimal actual movement or service provision."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02579" ;
    skos:prefLabel "IND02579"@en ;
    amlo:stixId "x-amltrix-indicator--97343c5a-d0b6-4a84-9a4e-d231a3199dec" .

amx:IND02580 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Unrecorded or suspicious affiliations between the MSB and high-risk counterparties not documented in standard due diligence files."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02580" ;
    skos:prefLabel "IND02580"@en ;
    amlo:stixId "x-amltrix-indicator--acd49532-96c9-4b3e-9229-4a2414008802" .

amx:IND02581 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Repeated overrides or manual suppression of internal AML alerts by senior MSB staff without documented justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02581" ;
    skos:prefLabel "IND02581"@en ;
    amlo:stixId "x-amltrix-indicator--e2069db9-ce8f-40fd-b396-901bf1f0e027" .

amx:IND02582 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Combining unverified shipments with legitimate cargo in the same container or logistics batch, hindering clear identification of goods."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02582" ;
    skos:prefLabel "IND02582"@en ;
    amlo:stixId "x-amltrix-indicator--78df2a2d-c0b8-4e1f-9b3d-f7b1c701e429" .

amx:IND02583 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Excessive reliance on a widespread agent network having inconsistent record-keeping and incomplete KYC information."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02583" ;
    skos:prefLabel "IND02583"@en ;
    amlo:stixId "x-amltrix-indicator--38193f55-d4a0-484d-892a-c171e3ede92f" .

amx:IND02584 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Use of intermediary companies with minimal operational footprint or opaque ownership to handle shipments, obscuring the true nature and origin of the business."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02584" ;
    skos:prefLabel "IND02584"@en ;
    amlo:stixId "x-amltrix-indicator--7cda3b9b-e45f-4998-9022-e15d23e1c945" .

