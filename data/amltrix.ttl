    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Establishment or use of nested corporate entities or trusts with no apparent commercial or economic rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02226" ;
    skos:prefLabel "IND02226"@en ;
    amlo:stixId "x-amltrix-indicator--f8930771-add3-487c-afb8-8d8a94a86154" .

