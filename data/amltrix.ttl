    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Detection of unauthorized or forged signatures on expense forms, suggesting fabrication or misuse of approval authority."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02107" ;
    skos:prefLabel "IND02107"@en ;
    amlo:stixId "x-amltrix-indicator--144c94a0-cee5-42e8-ae6d-e94156a7c654" .

amx:IND02108 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Large or frequent subsidy deposits significantly exceeding typical production capacity or farmland size reported, as verified through official agricultural data."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02108" ;
    skos:prefLabel "IND02108"@en ;
    amlo:stixId "x-amltrix-indicator--bef19cbc-8663-4fbd-9bd1-eb66909213dc" .

amx:IND02109 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Repeated changes to farmland registration or yield information immediately prior to subsidy disbursements, without supporting documentation of actual operational expansion."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02109" ;
    skos:prefLabel "IND02109"@en ;
    amlo:stixId "x-amltrix-indicator--f9a58198-f962-4d1a-9e8f-c4013f433c0e" .

amx:IND02110 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Rapid transfer of newly deposited subsidy funds into multiple accounts not evidently linked to agricultural operations, suggesting commingling of funds from disparate sources."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02110" ;
    skos:prefLabel "IND02110"@en ;
    amlo:stixId "x-amltrix-indicator--a478cc82-ab19-4d31-9baa-13643e521888" .

amx:IND02111 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Declared production metrics on subsidy applications that differ markedly from subsequent product sales records or industry benchmarks for the same crop or region."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02111" ;
    skos:prefLabel "IND02111"@en ;
    amlo:stixId "x-amltrix-indicator--3f064e47-a5ec-43dd-ac4e-fe885b7244a4" .

amx:IND02112 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Multiple agribusiness entities applying for or receiving subsidies under the same beneficial owner or physical premises, lacking clear operational separation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02112" ;
    skos:prefLabel "IND02112"@en ;
    amlo:stixId "x-amltrix-indicator--7b7f21d1-79bc-4b01-96b1-389453d3d3ea" .

amx:IND02113 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Subsidy recipient located in an area with limited farmland or agricultural infrastructure, yet receiving consistent high-value subsidy payments above local norms."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02113" ;
    skos:prefLabel "IND02113"@en ;
    amlo:stixId "x-amltrix-indicator--52438636-dd19-4af8-b95e-c5bd02e7a555" .

amx:IND02114 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Fictitious or manipulated invoices or property records supporting subsidy applications, containing inconsistent details or referencing non-existent farmland or goods."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02114" ;
    skos:prefLabel "IND02114"@en ;
    amlo:stixId "x-amltrix-indicator--9dfbf700-ccd0-4e50-b003-29d2c947bb6c" .

amx:IND02115 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Concurrent or overlapping subsidy claims involving the same farmland or production submitted to multiple government agencies or programs."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02115" ;
    skos:prefLabel "IND02115"@en ;
    amlo:stixId "x-amltrix-indicator--7a120e8a-68be-43a0-8793-5ce6eb0838bc" .

amx:IND02116 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Significant increases in settlement payments compared to the merchant’s historical transaction volumes or industry benchmarks, lacking corresponding sales or invoice records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02116" ;
    skos:prefLabel "IND02116"@en ;
    amlo:stixId "x-amltrix-indicator--91040459-444b-41fd-a757-01f64dee9e34" .

amx:IND02117 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Sustained patterns of small, repetitive incoming transactions from numerous payer accounts with no legitimate business rationale, inconsistent with the merchant’s stated goods or services."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02117" ;
    skos:prefLabel "IND02117"@en ;
    amlo:stixId "x-amltrix-indicator--42f8c9e3-8766-4cd6-9f9d-a693d5b3f38c" .

amx:IND02118 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Merchant receives funds from payers not listed in any documented client, vendor, or partner records, reflecting absence of a lawful business relationship."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02118" ;
    skos:prefLabel "IND02118"@en ;
    amlo:stixId "x-amltrix-indicator--df59075f-1ee5-42fa-a3f0-2f52f6bfc161" .

amx:IND02119 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or abnormally high refunds or credits exceeding normal industry benchmarks, suggesting cyclical flow of funds in and out of the merchant’s account."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02119" ;
    skos:prefLabel "IND02119"@en ;
    amlo:stixId "x-amltrix-indicator--a3f4fb97-a09a-4176-a131-1f5928334eba" .

amx:IND02120 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "A merchant or payment processor account is opened using a merchant’s identity without the merchant’s knowledge or authorization, indicating potential identity misuse."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02120" ;
    skos:prefLabel "IND02120"@en ;
    amlo:stixId "x-amltrix-indicator--ea6fea1b-e517-404a-8bb9-a31a3b6d574b" .

amx:IND02121 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "High-volume consecutive transfers in batch mode across multiple accounts and digital currencies, consistent with automated transaction software usage."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02121" ;
    skos:prefLabel "IND02121"@en ;
    amlo:stixId "x-amltrix-indicator--fa60d2c9-2f67-4f85-8e6f-f8af32ada733" .

amx:IND02122 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Scheduled transactions at precise, uniform intervals, irrespective of market trends, aligning with automated or algorithmic trading patterns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02122" ;
    skos:prefLabel "IND02122"@en ;
    amlo:stixId "x-amltrix-indicator--88ce5421-ac05-4a32-a48b-cf3a560c1172" .

amx:IND02123 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Single aggregator or TPPP settlement account commingles transactions from multiple unrelated merchants, lacking clear sub-account separation to trace individual merchant proceeds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02123" ;
    skos:prefLabel "IND02123"@en ;
    amlo:stixId "x-amltrix-indicator--b144757c-79e0-4738-a82f-c59345847a63" .

amx:IND02124 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Multiple transfers routed through diverse financial and payment service providers without a clear economic rationale, consistent with automated layering to obscure fund origins."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02124" ;
    skos:prefLabel "IND02124"@en ;
    amlo:stixId "x-amltrix-indicator--a6627591-9c34-4132-b2bf-c836195a0b14" .

amx:IND02125 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Uniform transaction amounts and timing patterns not aligned with normal market or discretionary trading behaviors, consistent with algorithmically executed transfers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02125" ;
    skos:prefLabel "IND02125"@en ;
    amlo:stixId "x-amltrix-indicator--4bf23cb9-07cb-4845-b5a0-b15108bfb903" .

amx:IND02126 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Simultaneous or near-simultaneous currency conversion transactions involving multiple currency pairs that hinder traceability by obscuring the transaction flow."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02126" ;
    skos:prefLabel "IND02126"@en ;
    amlo:stixId "x-amltrix-indicator--4ad964bc-82e6-4c26-b55b-e1a638cef1f8" .

amx:IND02127 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "Rapid cycling of funds across multiple digital wallets or accounts via auto-generated transfers, aimed at obfuscating the money trail through layering."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02127" ;
    skos:prefLabel "IND02127"@en ;
    amlo:stixId "x-amltrix-indicator--0dfa5e76-3cea-48f9-bbfc-89a3571c2a10" .

amx:IND02128 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.790245+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.790245+00:00"^^xsd:dateTime ;
    skos:definition "Repeated transactions structured just below reporting thresholds, consistent with automated attempts to evade monitoring triggers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02128" ;
    skos:prefLabel "IND02128"@en ;
    amlo:stixId "x-amltrix-indicator--a81fe1ec-76e2-43e9-b16e-89f819c883f1" .

