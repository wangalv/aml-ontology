<https://example.org/amltrix/link/a3569b3b-488d-4e26-aa13-89e1eae122e7> a amlo:MitigationLink ;
    dct:description "Implement targeted monitoring scenarios for MSB accounts, focusing on large round-figure movements, negligible holding periods, and rapid fund layering across multiple agent locations. Compare actual transaction volumes against the MSB’s stated business model to detect discrepancies that may indicate covert criminal ownership or complicit staff enabling illicit transfers."@en ;
    amlo:mitigation amx:M0004 ;
