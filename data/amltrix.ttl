    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Evidence of user interaction with external grey-market or third-party websites that facilitate buying or selling in-game currency at unofficial exchange rates."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02981" ;
    skos:prefLabel "IND02981"@en ;
    amlo:stixId "x-amltrix-indicator--5e8caf27-7583-40e7-901e-acb5ca7bb97f" .

