    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "There is a discrepancy between the declared operational mining capacity (equipment, energy usage, etc.) and the actual volume of mining rewards received."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01329" ;
    skos:prefLabel "IND01329"@en ;
    amlo:stixId "x-amltrix-indicator--c2474c6c-7331-4a09-bbca-f912b40e70f6" .

amx:IND01330 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Multiple mining accounts or wallets are rapidly opened and then deactivated, leaving minimal operational history."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01330" ;
    skos:prefLabel "IND01330"@en ;
    amlo:stixId "x-amltrix-indicator--b3db46d9-344a-41ea-aef6-71e15c6ff244" .

