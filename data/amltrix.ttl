    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Anomalous account behavior where a client with routine identity verification suddenly conducts high-volume transactions contrary to their declared profile, consistent with money mule exploitation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01114" ;
    skos:prefLabel "IND01114"@en ;
    amlo:stixId "x-amltrix-indicator--d5743318-b14f-492f-9c9d-a68a2717ebfc" .

