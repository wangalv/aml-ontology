    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Vendor bank account details that match or are linked to high-risk or previously flagged entities indicate a direct association with known illicit networks."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01348" ;
    skos:prefLabel "IND01348"@en ;
    amlo:stixId "x-amltrix-indicator--5f8d13e6-4df0-4ec1-8171-eafa68d3b855" .

amx:IND01349 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Recurring patterns in invoice numbering or formatting that deviate from industry norms reflect automated or fraudulent invoice generation associated with a fake vendor."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01349" ;
    skos:prefLabel "IND01349"@en ;
    amlo:stixId "x-amltrix-indicator--538ed570-212e-4c49-ae63-5c1064387dc6" .

amx:IND01350 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "A high frequency of invoice issuances from a vendor, not aligned with realistic procurement cycles or actual business needs, reflects potential fake vendor activity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01350" ;
    skos:prefLabel "IND01350"@en ;
    amlo:stixId "x-amltrix-indicator--15bf9bb3-b8f2-49de-8ce4-64f690642b97" .

