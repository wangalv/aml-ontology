    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Excessive or atypical cash withdrawals executed by a public official or employee with access to government funds, lacking legitimate operational justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02545" ;
    skos:prefLabel "IND02545"@en ;
    amlo:stixId "x-amltrix-indicator--e012c21b-422c-469a-b690-9476c8bc2fbf" .

