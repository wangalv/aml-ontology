    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Large 'legal fees' or 'advisory fees' significantly above industry norms with no evidence of actual services rendered."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02223" ;
    skos:prefLabel "IND02223"@en ;
    amlo:stixId "x-amltrix-indicator--e315f14b-2ee9-450c-a052-e107bf269a2e" .

