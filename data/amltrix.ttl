    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Incomplete or inconsistent customer identification records for P2P exchange providers, indicating inadequate or bypassed KYC controls."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01360" ;
    skos:prefLabel "IND01360"@en ;
    amlo:stixId "x-amltrix-indicator--b949ea2e-639a-44fd-8117-71948ed69a5d" .

amx:IND01361 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Transactions initiated from geographically diverse locations that are inconsistent with the known profile of the account holder."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01361" ;
    skos:prefLabel "IND01361"@en ;
    amlo:stixId "x-amltrix-indicator--32c19701-6ca7-430e-89ab-2c2d3122c811" .

