    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Rapid succession of fund transfers among accounts linked to the same professional intermediary, accompanied by minimal or inconsistent supporting documentation."@en ;
