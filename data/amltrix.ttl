    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Invoices for goods or services with no corresponding purchase orders, shipping records, or delivery receipts, consistent with fictitious transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01344" ;
    skos:prefLabel "IND01344"@en ;
    amlo:stixId "x-amltrix-indicator--6f6bbca8-e775-4997-bc0a-a9b63af86e23" .

