    amlo:productService amx:PS0075 ;
    amlo:technique amx:T0143.003 .

<https://example.org/amltrix/link/5e5d3596-bb10-44eb-b4af-8a2908f133ce> a amlo:DataSourceLink ;
    dct:description "Performs automated checks on remotely submitted identification documents, reviewing document metadata, security features, and potential editing traces, to detect synthetic or falsified identities used in remote onboarding. This directly exposes attempts to evade standard face-to-face verification by forging or altering digital documents."@en ;
    amlo:dataSource amx:DS0027 ;
    amlo:technique amx:T0075.001 .

<https://example.org/amltrix/link/5e609631-fa73-496d-bead-88292a047b9f> a amlo:InstrumentLink ;
    dct:description """- By wrapping assets, criminals move ransom proceeds across otherwise incompatible blockchains. 
