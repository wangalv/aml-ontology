    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Multiple inconsistent or contradictory sets of accounting or shipping records for the same transactions, discovered through financial audits or official verifications."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02597" ;
    skos:prefLabel "IND02597"@en ;
    amlo:stixId "x-amltrix-indicator--65a69bbf-54de-48eb-aa50-22b18abf7083" .

