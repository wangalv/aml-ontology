    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Undeclared or misdeclared consignments of precious stones or other high-value commodities with minimal supporting documentation, inconsistent with typical market or customs records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02586" ;
    skos:prefLabel "IND02586"@en ;
    amlo:stixId "x-amltrix-indicator--f7ac1906-bd2e-455b-8ee8-364f63c67314" .

