    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Frequent partial refunds in cash or to personal accounts shortly after invoice payments, lacking official justification or supporting documentation, indicating diversion for bribery or illicit gain."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01353" ;
    skos:prefLabel "IND01353"@en ;
    amlo:stixId "x-amltrix-indicator--49a79309-6be6-4159-812a-aca7a9653dd0" .

amx:IND01358 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Rapid conversion of incoming funds into sell transactions, indicating quick movement and layering of funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01358" ;
    skos:prefLabel "IND01358"@en ;
    amlo:stixId "x-amltrix-indicator--e6021d0c-2363-4989-820b-b7176445c7bf" .

