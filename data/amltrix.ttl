    amlo:productService amx:PS0036 ;
    amlo:technique amx:T0094.002 .

<https://example.org/amltrix/link/9a547ef8-116c-4cca-8de7-1cf30f6cdc29> a amlo:DataSourceLink ;
    dct:description """- Monitors changes in an entity’s product or service lines to newly introduce offshore gambling.
