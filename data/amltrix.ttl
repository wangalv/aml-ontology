    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "A single customer receives a substantial amount of cryptoassets at an exchange, followed by evidence of 20 or more quick wallet hops in a short time (for example, within a few hours)."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01023" ;
    skos:prefLabel "IND01023"@en ;
    amlo:stixId "x-amltrix-indicator--072f44cb-a984-4cea-be1c-9a4d225394a7" .

amx:IND01024 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Repeated micro-transactions from newly created addresses occur within a short timeframe, often landing in the same block or separated by only a few blocks."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01024" ;
    skos:prefLabel "IND01024"@en ;
    amlo:stixId "x-amltrix-indicator--3e4f4ea1-dd81-4bda-aac2-bca11a5c9eac" .

