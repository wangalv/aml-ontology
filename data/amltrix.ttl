    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Sudden creation or usage of multiple new blockchain wallets dedicated to wrapped token transactions, inconsistent with the customer’s known profile, flagged for closer due diligence."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01244" ;
    skos:prefLabel "IND01244"@en ;
    amlo:stixId "x-amltrix-indicator--f60ec401-7142-4436-be12-7138a11b51f2" .

