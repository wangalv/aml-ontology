    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "Transactions exclusively handled by professional intermediaries providing minimal documentation and invoking legal confidentiality, resulting in opaque ownership structures."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00765" ;
    skos:prefLabel "IND00765"@en ;
    amlo:stixId "x-amltrix-indicator--44af0d10-0d1e-437c-82c0-5e964fb33300" .

