    amlo:dataSource amx:DS0039 ;
    amlo:technique amx:T0081 .

<https://example.org/amltrix/link/0a4f9810-052b-4155-b530-014f5129b2fa> a amlo:DataSourceLink ;
    dct:description "Aggregates risk profiles for countries and financial institutions, highlighting those with AML/CFT weaknesses or high corruption rates. Identifying multiple third-party payments originating from high-risk jurisdictions helps flag transactions that deviate from a customer’s usual geographic profile and may signal laundering attempts."@en ;
    amlo:dataSource amx:DS0005 ;
    amlo:technique amx:T0073 .

<https://example.org/amltrix/link/0a59bf63-7f36-471a-8e7d-1a78b900d1ce> a amlo:ActorLink ;
