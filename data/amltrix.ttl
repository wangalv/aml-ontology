    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Accounts with historically low or routine activity suddenly showing a spike in transactions, particularly cash withdrawals and subsequent deposits into crypto ATMs."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01238" ;
    skos:prefLabel "IND01238"@en ;
    amlo:stixId "x-amltrix-indicator--f2a5b24b-ccf3-4511-a443-08a1c0ec71d8" .

