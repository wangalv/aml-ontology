    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Frequent re-appraisals or inconsistent valuations of the same high-value assets beyond typical market fluctuations, used to justify wide price discrepancies across repeated buy-sell transactions."@en ;
