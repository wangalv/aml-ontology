    amlo:instrument amx:IN0054 ;
    amlo:technique amx:T0144.019 .

<https://example.org/amltrix/link/ca50a508-9426-4a6f-96bd-aedb63ad95f7> a amlo:ProductServiceLink ;
    dct:description """- Criminals can funnel illicit proceeds disguised as donations into fundraising campaigns or events.  
