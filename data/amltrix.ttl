    dct:modified "2025-05-13T07:47:21.790245+00:00"^^xsd:dateTime ;
    skos:definition "Unusually high insurance premiums paid to a captive insurance entity that exceed typical industry norms and are not justified by the risk assessment or coverage needs."@en ;
