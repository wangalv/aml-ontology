    amlo:productService amx:PS0075 ;
    amlo:technique amx:T0116 .

<https://example.org/amltrix/link/6c844289-95e0-47c4-a377-bcfcf6369054> a amlo:DataSourceLink ;
    dct:description """- Consolidates transaction details, user identifiers, and operational data from e-wallets or app-based remittance services.
