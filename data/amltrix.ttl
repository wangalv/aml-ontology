    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02529" ;
    skos:prefLabel "IND02529"@en ;
    amlo:stixId "x-amltrix-indicator--6a1aa19a-3077-4b38-b7f3-bad143389a88" .

