    amlo:dataSource amx:DS0007 ;
    amlo:technique amx:T0147.001 .

<https://example.org/amltrix/link/7ea9a1f9-4d6e-4b3d-ac72-e5c3d72378fc> a amlo:ProductServiceLink ;
    dct:description """- Fraudsters lure victims to purchase tokens promising extraordinary returns, exploiting complex or opaque listing processes.  
