    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Intentional or staged chip losses from one gambler to another followed by immediate cash redemption, suggesting contrived transfers rather than genuine gambling outcomes."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
