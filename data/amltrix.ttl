    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Repeated reliance on a single intermediary for multiple transactions inconsistent with a customer’s typical business profile, raising suspicion of layering."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01081" ;
    skos:prefLabel "IND01081"@en ;
    amlo:stixId "x-amltrix-indicator--b6f15ff3-3b66-496e-a1c8-7fd7f94bcc07" .

