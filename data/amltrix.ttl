    skos:definition "Frequent outflows recorded as payables to newly formed or unknown vendors lacking any legitimate business operations or verifiable contact details."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00770" ;
    skos:prefLabel "IND00770"@en ;
