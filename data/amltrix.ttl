    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Use of offset or alternative settlement methods, including trade-based exchanges, net-settlements, or cash pooling, instead of direct wire transfers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01063" ;
    skos:prefLabel "IND01063"@en ;
    amlo:stixId "x-amltrix-indicator--245b3015-e5da-4fb4-b63e-64749ca9103d" .

amx:IND01064 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Prolonged or irregular account-balancing cycles among multiple intermediaries that do not align with standard settlement practices."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01064" ;
    skos:prefLabel "IND01064"@en ;
    amlo:stixId "x-amltrix-indicator--0e823217-f363-4b3c-971f-9ed2feb19bbf" .

