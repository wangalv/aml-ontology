    amlo:dataSource amx:DS0004 ;
    amlo:technique amx:T0013.003 .

<https://example.org/amltrix/link/3d20815a-831d-41c9-920f-d4c3c59488ac> a amlo:InstrumentLink ;
    dct:description """- Criminals direct illicit capital into property development or infrastructure projects with inflated budgets to justify large incoming funds.  
