    amlo:dataSource amx:DS0004 ;
    amlo:technique amx:T0069.001 .

<https://example.org/amltrix/link/5e1e21bb-49d0-47e5-bbdf-5d9b30169f15> a amlo:DataSourceLink ;
    dct:description """- Provides official pricing, historical trends, and benchmarks for gold.
