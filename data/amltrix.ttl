    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02227" ;
    skos:prefLabel "IND02227"@en ;
    amlo:stixId "x-amltrix-indicator--490074c0-0a13-4ea9-b8de-7abc2f87132a" .

