        amx:T0144.002,
        amx:T0146 ;
    amlo:shortDescription "Money orders offer a secure, prepaid method for sending moderate amounts of funds to a specified recipient, but they can still be misused for layering illicit proceeds if sufficient due diligence and transaction monitoring are not in place."@en ;
    amlo:stixId "value-instruments--d57c0799-12b1-47e4-b0ef-91bdb09613ba" .

