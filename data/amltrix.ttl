    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01105" ;
    skos:prefLabel "IND01105"@en ;
    amlo:stixId "x-amltrix-indicator--1d6b4a60-ca54-45e3-87b4-5676d69326ad" .

