    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "The company’s official address is a virtual office or mailbox service, lacking any physical presence or operational facilities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01055" ;
    skos:prefLabel "IND01055"@en ;
    amlo:stixId "x-amltrix-indicator--79a6a715-180e-49a3-aae0-582cd43ff7c5" .

amx:IND01056 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Accounts receiving or sending funds on behalf of multiple, seemingly unrelated parties, without a clear explanation or documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01056" ;
    skos:prefLabel "IND01056"@en ;
    amlo:stixId "x-amltrix-indicator--fa0c47cd-b325-4c3c-89b9-dff7136bd7cf" .

amx:IND01057 a amlo:Indicator ;
