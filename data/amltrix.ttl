<https://example.org/amltrix/link/6a3a1394-b63a-4df2-bc45-684eef35e4b1> a amlo:MitigationLink ;
    dct:description "For clients or transactions flagged as higher risk due to complex trade routes or significant price discrepancies, perform deeper verification of bills of lading, customs documentation, and declared values. Engage third-party inspectors or commodity experts if necessary to confirm the authenticity and market-consistent pricing of shipped goods."@en ;
    amlo:mitigation amx:M0002 ;
