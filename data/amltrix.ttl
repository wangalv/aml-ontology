    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "The initial source of funds is tied to known illicit activity (e.g., dark web marketplaces or ransomware) before peel chain transfers begin."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01028" ;
    skos:prefLabel "IND01028"@en ;
    amlo:stixId "x-amltrix-indicator--1c99e183-9cfb-4094-bcef-2a52d42bc4ad" .

