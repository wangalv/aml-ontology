    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "High volumes of inbound or outbound transactions from addresses associated with mixing services."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01099" ;
    skos:prefLabel "IND01099"@en ;
    amlo:stixId "x-amltrix-indicator--ce8c58e4-21e8-490c-b483-a25529a68f09" .

