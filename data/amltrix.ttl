    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Frequent account logins from IP addresses associated with known proxy services or suspicious short-term hosting providers, indicating possible obfuscation of the user’s true location."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
