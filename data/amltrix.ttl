    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Frequent involvement of individuals with no prior gambling history who abruptly begin repeated cash-to-chip and chip-to-cheque transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01208" ;
    skos:prefLabel "IND01208"@en ;
    amlo:stixId "x-amltrix-indicator--829ed818-b095-44b6-9e48-7d8ceb762594" .

