    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Bids repeatedly revised with abrupt pricing changes immediately before contract awards, signaling potential collusive coordination."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02566" ;
    skos:prefLabel "IND02566"@en ;
    amlo:stixId "x-amltrix-indicator--47cf7dda-51a4-42fb-951c-a631027511ef" .

