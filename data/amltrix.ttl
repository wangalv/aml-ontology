    dct:modified "2025-05-13T07:47:21.810936+00:00"^^xsd:dateTime ;
    skos:definition "Frequent pass-through wire transfers where incoming funds are rapidly forwarded to one or more external accounts, leaving little or no residual balance."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02314" ;
    skos:prefLabel "IND02314"@en ;
    amlo:stixId "x-amltrix-indicator--f8ba020d-dd93-4cf2-88ed-4027c7b9e40f" .

