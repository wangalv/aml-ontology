    dct:modified "2025-05-13T07:47:21.792777+00:00"^^xsd:dateTime ;
    skos:definition "An account with historically low or stable activity that suddenly shows numerous small, structured transactions inconsistent with the account profile."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND00767" ;
    skos:prefLabel "IND00767"@en ;
    amlo:stixId "x-amltrix-indicator--693216f6-ed1d-4d22-805d-3c6305598e1b" .

