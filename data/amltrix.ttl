    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Sudden initiation of high-value trade transactions by an entity with limited or no prior trading history, where invoice values do not match the entity’s known business activity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01018" ;
    skos:prefLabel "IND01018"@en ;
    amlo:stixId "x-amltrix-indicator--f7ee3639-c7d3-490c-95b1-62a35d9fbab1" .

