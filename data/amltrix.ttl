    dct:created "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "The customer consistently uses mining pools or platforms known for minimal KYC procedures, reducing the traceability of associated transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01331" ;
    skos:prefLabel "IND01331"@en ;
    amlo:stixId "x-amltrix-indicator--8b9f935c-1fe2-4841-8285-462b3108ac0b" .

amx:IND01332 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Mining rewards are credited in large batches or at irregular intervals, inconsistent with typical mining reward issuance patterns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01332" ;
    skos:prefLabel "IND01332"@en ;
    amlo:stixId "x-amltrix-indicator--e955df9c-fac1-4fbb-bc3c-47cfb129957a" .

amx:IND01333 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Mining activities are initiated from residential addresses or jurisdictions not typically associated with large-scale mining operations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01333" ;
    skos:prefLabel "IND01333"@en ;
    amlo:stixId "x-amltrix-indicator--87466ba7-0380-493c-a4b8-7526b0fb3345" .

