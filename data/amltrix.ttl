    skos:definition "Involvement of shell companies registered in jurisdictions known for secrecy or weak AML controls."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02095" ;
    skos:prefLabel "IND02095"@en ;
    amlo:stixId "x-amltrix-indicator--5aff6216-6538-4abb-8a4e-c3c7fea9b229" .

