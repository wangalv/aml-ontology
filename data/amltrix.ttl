    amlo:instrument amx:IN0017 ;
    amlo:technique amx:T0012 .

<https://example.org/amltrix/link/7d90d717-08be-42da-afa2-8f29a5f887a4> a amlo:ProductServiceLink ;
    dct:description """- Criminals generate and process counterfeit or inflated invoices for farm supplies or outputs to justify enlarged subsidy claims.  
