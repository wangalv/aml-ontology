    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Use of synthetic or assumed identities across multiple accounts, where personal details (address, contact information, identification numbers) recur with minor variations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
