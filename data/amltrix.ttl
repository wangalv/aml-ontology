    amlo:dataSource amx:DS0020 ;
    amlo:technique amx:T0147.004 .

<https://example.org/amltrix/link/7d3b709a-cc37-426a-acc8-6eb966f5d72b> a amlo:DataSourceLink ;
    dct:description """- Tracks when, how often, and by whom safe deposit boxes are accessed.
