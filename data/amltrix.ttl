    skos:definition "Frequent usage of lesser-regulated or unlicensed money service businesses for currency exchange transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02137" ;
    skos:prefLabel "IND02137"@en ;
    amlo:stixId "x-amltrix-indicator--520bf4a7-0e42-4988-aa3c-555e2ac4d19f" .

