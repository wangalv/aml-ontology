<https://example.org/amltrix/link/ecdd40a3-663e-4655-90ce-e3cd7d93f928> a amlo:ProductServiceLink ;
    dct:description """- Criminals transfer tokens among multiple blockchain networks, breaking transaction continuity and obscuring fund flows.  
