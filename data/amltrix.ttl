    amlo:productService amx:PS0130 ;
    amlo:technique amx:T0130.001 .

<https://example.org/amltrix/link/683bef2f-3cf6-49d6-a01f-572bbf08ec6d> a amlo:DataSourceLink ;
    dct:description """- Contains user account information, wallet addresses, transaction details, and trading activities within cryptocurrency exchanges.
- Highlights suspicious transfers to unregulated exchanges or mixers linked to sanctioned addresses, aiding in sanctions evasion investigations."""@en ;
