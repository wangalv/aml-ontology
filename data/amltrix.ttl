    skos:definition "A service that manages and safeguards art collections on behalf of clients, including storage, maintenance, and transportation of artworks."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "PS0125" ;
    skos:prefLabel "Art Custodial Services"@en ;
