    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "The business or its representatives consistently refuse or delay providing requested financial documentation without a credible explanation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01090" ;
    skos:prefLabel "IND01090"@en ;
    amlo:stixId "x-amltrix-indicator--9d4c6205-b304-4027-83b1-1e17ad611aff" .

