    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Opaque beneficial ownership structures or frequent ownership changes that prevent definitive identification of ultimate controllers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02591" ;
    skos:prefLabel "IND02591"@en ;
    amlo:stixId "x-amltrix-indicator--51b78e26-b9b2-4291-8348-7a90ce8df341" .

