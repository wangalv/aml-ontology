    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Transactions initiated from publicly listed proxy IP addresses, indicating an attempt to route financial flows through anonymizing intermediaries."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01102" ;
