    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Operating margins or geographic coverage that is inconsistent with typical norms of the declared business sector."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01088" ;
    skos:prefLabel "IND01088"@en ;
    amlo:stixId "x-amltrix-indicator--546efffb-d023-47b0-8a0c-4c3dba7c9b1b" .

