    skos:definition "Shipping documents reflecting mismatched consignee details or shipping routes that deviate from the declared route without justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02914" ;
    skos:prefLabel "IND02914"@en ;
    amlo:stixId "x-amltrix-indicator--7b4cde16-f623-4061-b5d8-9faebe8ab7f2" .

amx:IND02915 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Recurring use of documents against payment (D/P) or documents against acceptance (D/A) arrangements with minimal variation or repetitive patterns in shipping details."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02915" ;
    skos:prefLabel "IND02915"@en ;
    amlo:stixId "x-amltrix-indicator--4737e5be-9368-4cc6-bffa-97ae6abc4629" .

amx:IND02916 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Shipping documents missing standard authenticity or security features, or displaying signs of alteration or tampering."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02916" ;
    skos:prefLabel "IND02916"@en ;
    amlo:stixId "x-amltrix-indicator--ce7f0315-3ba0-42c7-8711-2e9663481516" .

amx:IND02917 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Parties or principals with a documented history of suspicious activity or links to high-risk jurisdictions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02917" ;
    skos:prefLabel "IND02917"@en ;
    amlo:stixId "x-amltrix-indicator--696b6de1-c74c-4935-900f-643c8319c84c" .

amx:IND02918 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Shipping documents consistently declaring goods of abnormally low value or using generic descriptions that do not correspond to the buyer's known business activities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02918" ;
    skos:prefLabel "IND02918"@en ;
    amlo:stixId "x-amltrix-indicator--9eb55c0d-58c7-4d43-b1fa-56c2e98aaae0" .

amx:IND02919 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Rapid or immediate turnover of large shipments on paper without a proportional increase in the company’s operational capacity or infrastructure."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02919" ;
    skos:prefLabel "IND02919"@en ;
    amlo:stixId "x-amltrix-indicator--20c2a74d-f2be-4fb5-9004-567a621f4efb" .

amx:IND02920 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Repeated or substantial trade flows between countries lacking any established economic ties or historical trade relationships."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02920" ;
    skos:prefLabel "IND02920"@en ;
    amlo:stixId "x-amltrix-indicator--4c5d85ca-c3ac-4d6a-9983-d075962b04f7" .

amx:IND02921 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Frequent amendments or corrections to shipping documents after initial presentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02921" ;
    skos:prefLabel "IND02921"@en ;
    amlo:stixId "x-amltrix-indicator--b1977003-baad-4b44-b768-7030e36f9df9" .

amx:IND02922 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Engagement of newly formed or dormant entities with unverified beneficial ownership in the transaction chain."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02922" ;
    skos:prefLabel "IND02922"@en ;
    amlo:stixId "x-amltrix-indicator--352f9d0e-a55f-425e-bbf6-3d2afad04ea6" .

amx:IND02923 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Repeated transactions involving the same parties where goods are purportedly shipped but there is no corresponding evidence of actual shipping activity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02923" ;
    skos:prefLabel "IND02923"@en ;
    amlo:stixId "x-amltrix-indicator--84d1299f-0fc4-4b57-8e69-fb2b636dd6f2" .

amx:IND02924 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Unusual routing of shipping documents through multiple banks or financial institutions without clear justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02924" ;
    skos:prefLabel "IND02924"@en ;
    amlo:stixId "x-amltrix-indicator--ca0187e8-6862-4bac-9f13-2020a0a86164" .

amx:IND02925 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "No legitimate business rationale or commercial justification for the transaction or the relationships among the involved parties."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02925" ;
    skos:prefLabel "IND02925"@en ;
    amlo:stixId "x-amltrix-indicator--71087207-ad02-44db-877c-ea381b891570" .

amx:IND02926 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Use of newly established entities with no prior transaction history for large documentary collection transactions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02926" ;
    skos:prefLabel "IND02926"@en ;
    amlo:stixId "x-amltrix-indicator--a60fa0e1-5189-45c6-b8da-c4ba2dc1719c" .

amx:IND02927 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Cargo tracking references a vessel or carrier that does not match official maritime or shipping records, suggesting a nonexistent or falsely documented shipment."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02927" ;
    skos:prefLabel "IND02927"@en ;
    amlo:stixId "x-amltrix-indicator--b4069b93-955a-4d9b-a8cb-6f053d86ecee" .

amx:IND02928 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Significant undervaluation or overvaluation of goods on invoices relative to prevailing market prices, indicating misrepresentation of shipment value."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02928" ;
    skos:prefLabel "IND02928"@en ;
    amlo:stixId "x-amltrix-indicator--b65311f0-3428-4fcf-9555-29d22fabfa05" .

amx:IND02929 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Shipping documents describe goods in ways that differ from actual physical characteristics discovered in inspections, reflecting potential mislabeling or concealment."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02929" ;
    skos:prefLabel "IND02929"@en ;
    amlo:stixId "x-amltrix-indicator--cb9b5ab8-965e-49f4-92e1-52d8e03391b8" .

amx:IND02930 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Beneficial owners or senior management of businesses lack documented experience or qualifications in the specific commodity industry, raising legitimacy concerns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02930" ;
    skos:prefLabel "IND02930"@en ;
    amlo:stixId "x-amltrix-indicator--0b96b2f0-5fa5-40b6-8351-07bff265acf7" .

amx:IND02931 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Repeated routing of payments linked to trade through multiple high-risk jurisdictions with known AML deficiencies to obscure transaction origins."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02931" ;
    skos:prefLabel "IND02931"@en ;
    amlo:stixId "x-amltrix-indicator--c75cebdf-8a5a-4168-8a83-ce2a5c0c2cf1" .

amx:IND02932 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Multiple cross-border shipments of regulated commodities, e.g. tobacco, with declared volumes or values just below regulatory reporting thresholds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02932" ;
    skos:prefLabel "IND02932"@en ;
    amlo:stixId "x-amltrix-indicator--9ef4513e-798a-4f3e-b7b9-51e8e926fb67" .

amx:IND02933 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Registration addresses for companies engaged in trade are located in high-risk jurisdictions or tax havens that do not align with their operational footprints."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02933" ;
    skos:prefLabel "IND02933"@en ;
    amlo:stixId "x-amltrix-indicator--d02dcb12-050c-47de-afe6-8fa468800deb" .

amx:IND02934 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Frequent, unexplained changes in the shipping routes, including transit through high-risk or non-traditional regions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02934" ;
    skos:prefLabel "IND02934"@en ;
    amlo:stixId "x-amltrix-indicator--a3277dab-42b1-4260-b7a1-e91c22cf6809" .

amx:IND02935 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.817904+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.817904+00:00"^^xsd:dateTime ;
    skos:definition "Consistent discrepancies between the weight or volume of shipped goods and their declared value compared to industry benchmarks."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02935" ;
    skos:prefLabel "IND02935"@en ;
    amlo:stixId "x-amltrix-indicator--f3d48cf3-1e40-4f8a-9468-4f086241c656" .

amx:IND02936 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "A high frequency of micro-transactions that, when aggregated over a short period, reveal substantial fund movements despite each transaction appearing inconsequential on its own."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02936" ;
    skos:prefLabel "IND02936"@en ;
    amlo:stixId "x-amltrix-indicator--08727e30-4a54-496f-8a9e-9865e18216bb" .

amx:IND02937 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "A sudden or unusual surge in small, frequent transactions that deviates significantly from the customer’s typical activity profile."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02937" ;
    skos:prefLabel "IND02937"@en ;
    amlo:stixId "x-amltrix-indicator--355cd36a-f257-42bd-9560-f4602ef6bad8" .

amx:IND02938 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Repeated micro-transactions lacking a verifiable business or personal justification, inconsistent with the account's stated purpose or typical financial profile."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02938" ;
    skos:prefLabel "IND02938"@en ;
    amlo:stixId "x-amltrix-indicator--e07000df-8fad-433c-94a2-bd268125da12" .

amx:IND02939 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Multiple depositors or payors from diverse locations repeatedly sending micro-amounts into a single account within a short timeframe."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02939" ;
    skos:prefLabel "IND02939"@en ;
    amlo:stixId "x-amltrix-indicator--0892f92f-785a-4f75-94d1-ef03748baff3" .

amx:IND02940 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Frequent small ATM withdrawals across multiple institutions or foreign ATMs over a short period, consistent with layering or micro-structuring tactics."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02940" ;
    skos:prefLabel "IND02940"@en ;
    amlo:stixId "x-amltrix-indicator--0bb8b562-e47b-4233-85b9-a05d8d024b89" .

amx:IND02941 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Frequent micro-transactions channeled through multiple e-wallets or digital platforms (including cryptocurrency), collectively forming substantial sums within brief intervals."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02941" ;
    skos:prefLabel "IND02941"@en ;
    amlo:stixId "x-amltrix-indicator--2e42da71-0780-4dfe-ad97-8547fcd9c305" .

amx:IND02942 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Online or social media job advertisements promising easy income for minimal or no experience, emphasizing tasks related to receiving and transferring funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02942" ;
    skos:prefLabel "IND02942"@en ;
    amlo:stixId "x-amltrix-indicator--9164d4df-1be3-47f3-a7ac-2d32230fe27a" .

amx:IND02943 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Frequent incoming transfers from disparate, unconnected parties followed by immediate or near-immediate onward transfers or withdrawals."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02943" ;
    skos:prefLabel "IND02943"@en ;
    amlo:stixId "x-amltrix-indicator--1d4fe0ca-20ca-47a2-9ba1-6dc32d9793e8" .

amx:IND02944 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "A sudden increase in new accounts opened by individuals with minimal local or employment history, closely matching known or suspected recruitment campaigns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02944" ;
    skos:prefLabel "IND02944"@en ;
    amlo:stixId "x-amltrix-indicator--2249c88f-d94a-49a5-962c-f9487af4bc2f" .

amx:IND02945 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Transaction volumes or frequencies that significantly exceed the stated occupation or typical financial profile, especially if the individual is a student, unemployed, or newly arrived to the country."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02945" ;
    skos:prefLabel "IND02945"@en ;
    amlo:stixId "x-amltrix-indicator--d972ef87-62ad-4b2d-b840-ba016fff39da" .

amx:IND02946 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Communication records reveal instructions to account holders on how to move funds or references to commission-based payments for receiving and forwarding money."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02946" ;
    skos:prefLabel "IND02946"@en ;
    amlo:stixId "x-amltrix-indicator--6f8ec495-0ff1-442b-83c5-0f3f228857f2" .

amx:IND02947 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Rapid shifts in user geolocation across multiple sessions within short time intervals, inconsistent with normal travel or operational patterns."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02947" ;
    skos:prefLabel "IND02947"@en ;
    amlo:stixId "x-amltrix-indicator--1d89d6a4-eef5-4c4e-b2ea-770381ff3550" .

amx:IND02948 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.817904+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.817904+00:00"^^xsd:dateTime ;
    skos:definition "Account opening or management activities consistently conducted via IP addresses masked by VPN services, lacking reasonable explanation in KYC records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02948" ;
    skos:prefLabel "IND02948"@en ;
    amlo:stixId "x-amltrix-indicator--bfd0f6ef-d8b4-461d-b30e-151db56b7272" .

amx:IND02949 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Initiation of high-value or structured transactions from IP addresses flagged as VPN endpoints, particularly in the layering stage."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02949" ;
    skos:prefLabel "IND02949"@en ;
    amlo:stixId "x-amltrix-indicator--1edb8d63-53e9-4017-b6cf-6b8a79454923" .

amx:IND02950 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Multiple cross-border transactions with sanctioned or high-risk jurisdictions routed through intermediary accounts in regions with limited AML enforcement."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02950" ;
    skos:prefLabel "IND02950"@en ;
    amlo:stixId "x-amltrix-indicator--1d0663e6-a1fe-4ef3-a270-b09528ff36d6" .

amx:IND02951 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Abrupt changes in trade routes or final destinations for goods, inconsistent with declared commercial activities and linked to sanctioned or high-risk jurisdictions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02951" ;
    skos:prefLabel "IND02951"@en ;
    amlo:stixId "x-amltrix-indicator--92bd640f-d797-46a4-8f93-c1bb9dac2f30" .

amx:IND02952 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Consistent over- or under-invoicing of goods and services in cross-border trade without valid commercial justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02952" ;
    skos:prefLabel "IND02952"@en ;
    amlo:stixId "x-amltrix-indicator--0ea062aa-9b31-4e46-8815-d5ebcc8a2036" .

amx:IND02953 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Unusually layered corporate ownership structures featuring newly registered or dormant entities in jurisdictions associated with sanctioned parties."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02953" ;
    skos:prefLabel "IND02953"@en ;
    amlo:stixId "x-amltrix-indicator--bf2f13d9-27e8-4a13-8081-3890627b3e41" .

amx:IND02954 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Inconsistent or missing beneficial ownership details in corporate filings for cross-border transactions involving sanctioned or high-risk jurisdictions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02954" ;
    skos:prefLabel "IND02954"@en ;
    amlo:stixId "x-amltrix-indicator--d3c11e43-5b67-4be1-838f-44b0804446de" .

amx:IND02955 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Usage of cryptocurrency mixers or unregulated exchanges to transfer digital assets to or from addresses linked to sanctioned entities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02955" ;
    skos:prefLabel "IND02955"@en ;
    amlo:stixId "x-amltrix-indicator--17d28f05-d804-47fc-b60a-94d03563fff0" .

amx:IND02956 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Use of specialized service providers (lawyers, accountants, trust companies) to facilitate cross-border transfers tied to sanctioned or high-risk parties outside normal business scope."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02956" ;
    skos:prefLabel "IND02956"@en ;
    amlo:stixId "x-amltrix-indicator--65d190ae-beb3-4724-9c43-821d239a3209" .

amx:IND02957 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Acquisition of real estate or high-value assets through corporate vehicles in jurisdictions with limited AML controls, obscuring connections to sanctioned individuals."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02957" ;
    skos:prefLabel "IND02957"@en ;
    amlo:stixId "x-amltrix-indicator--cf3e2093-24e3-4da5-b8d5-b85df24797d3" .

amx:IND02958 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Numerous frequent small-value cash deposits or credits inconsistent with personal or business profiles, often lacking any clear source of legitimate income."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02958" ;
    skos:prefLabel "IND02958"@en ;
    amlo:stixId "x-amltrix-indicator--3a6c1337-a8d5-484f-88df-a56ef3ae4a99" .

amx:IND02959 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Rapid escalation in reported cash revenue at a cash-intensive business without a corresponding increase in operational factors, such as foot traffic or product sales."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02959" ;
    skos:prefLabel "IND02959"@en ;
    amlo:stixId "x-amltrix-indicator--37ca7d36-1b51-4846-8b62-da207ab51663" .

amx:IND02960 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Frequent small peer-to-peer payments that collectively reach substantial amounts, lacking any clear personal or commercial rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02960" ;
    skos:prefLabel "IND02960"@en ;
    amlo:stixId "x-amltrix-indicator--8a7fafc7-79a1-48b5-87a1-0001d462cdfc" .

amx:IND02961 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Account holders or beneficial owners with documented minor crime or gang affiliations who set up newly formed or low-activity businesses recording unexpected spikes in cash revenue."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02961" ;
    skos:prefLabel "IND02961"@en ;
    amlo:stixId "x-amltrix-indicator--7346d2b4-6de0-43c7-86b0-c95d6c4910c2" .

amx:IND02962 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Multiple related individuals conducting consecutive sub-threshold cash deposits at the same branch on the same day, indicating potential structuring."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02962" ;
    skos:prefLabel "IND02962"@en ;
    amlo:stixId "x-amltrix-indicator--3bb5e8a1-1632-4f67-aaaa-ac87fdca4d63" .

amx:IND02963 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Repeated use of unlicensed or informal money transfer services for small-sum remittances without valid documentation or stated purpose."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02963" ;
    skos:prefLabel "IND02963"@en ;
    amlo:stixId "x-amltrix-indicator--74476ce6-5568-4ad0-bb62-6605512035f0" .

amx:IND02964 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Account holders or employees repeatedly disclaim or provide contradictory statements about the broader business context behind their specific transaction responsibilities or roles."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02964" ;
    skos:prefLabel "IND02964"@en ;
    amlo:stixId "x-amltrix-indicator--72a1184e-b13c-4d24-8e5c-93d1bff4752a" .

amx:IND02965 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Multiple departments or service providers are sequentially used for a single transaction chain, with each lacking documentation or reference to preceding or subsequent steps."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02965" ;
    skos:prefLabel "IND02965"@en ;
    amlo:stixId "x-amltrix-indicator--6b16838b-0b1e-48b1-8a19-7e35b91932b4" .

amx:IND02966 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Clients or related entities maintain separate accounts across various institutions or jurisdictions, each reflecting partial transaction patterns that do not reveal the complete flow of funds when viewed in isolation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02966" ;
    skos:prefLabel "IND02966"@en ;
    amlo:stixId "x-amltrix-indicator--ebb3685e-8f4f-4e08-88e9-2e8ab9ccdee7" .

amx:IND02967 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.818499+00:00"^^xsd:dateTime ;
    skos:definition "Different segments of an organization hold only partial financial or legal documentation, indicating no single department or individual has a comprehensive overview of operations or agreements."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02967" ;
    skos:prefLabel "IND02967"@en ;
    amlo:stixId "x-amltrix-indicator--208e16fe-57e8-4c80-a249-cc832b20c504" .

amx:IND02968 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Frequent reassignments or rapid turnover of individuals responsible for specific account or operational tasks, with minimal transfer of historical records or knowledge."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02968" ;
    skos:prefLabel "IND02968"@en ;
    amlo:stixId "x-amltrix-indicator--ae3ac17f-115d-49a1-858f-676914270335" .

amx:IND02969 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or large-value transfers to or from unregulated real-money trading (RMT) platforms across multiple gaming ecosystems, with no corresponding legitimate gaming or business rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02969" ;
    skos:prefLabel "IND02969"@en ;
    amlo:stixId "x-amltrix-indicator--e016c93f-f256-43c1-a07f-72d565d424d5" .

amx:IND02970 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Repeated buy-sell transactions of high-value in-game assets or currency across different virtual worlds, with minimal or no in-game activity indicating actual usage."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02970" ;
    skos:prefLabel "IND02970"@en ;
    amlo:stixId "x-amltrix-indicator--abab99be-7623-474c-bb88-acdf912eba6a" .

amx:IND02971 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Multiple ownership transfers or 'gifting' of game accounts or rare items among closely linked entities or IP addresses, with minimal customer due diligence or identity verification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02971" ;
    skos:prefLabel "IND02971"@en ;
    amlo:stixId "x-amltrix-indicator--168daa0d-b4f2-4612-8954-a655fdb885fc" .

amx:IND02972 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Use of blockchain-based cross-game bridging services to move digital tokens or assets between gaming ecosystems, bypassing official channels or identity verification measures."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02972" ;
    skos:prefLabel "IND02972"@en ;
    amlo:stixId "x-amltrix-indicator--9972b7c8-90dc-4c30-a09e-4f215108a96d" .

amx:IND02973 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Abrupt influx of in-game currency or assets followed by immediate liquidation through third-party brokers or online marketplaces with lax AML procedures."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02973" ;
    skos:prefLabel "IND02973"@en ;
    amlo:stixId "x-amltrix-indicator--49f50cb7-de30-46b5-b497-52b7deedd13a" .

amx:IND02974 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Multiple or large-value in-game currency purchases from stolen or unverified payment methods, quickly converted back into real currency or cryptocurrency."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02974" ;
    skos:prefLabel "IND02974"@en ;
    amlo:stixId "x-amltrix-indicator--631d2a20-cf03-4132-ad9a-01d29d18aa57" .

amx:IND02975 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Excessive microtransactions between multiple player accounts lacking normal gameplay correlations, fragmenting large sums into smaller transfers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02975" ;
    skos:prefLabel "IND02975"@en ;
    amlo:stixId "x-amltrix-indicator--afa19dc8-9b3f-41c8-9f21-26a306d6597e" .

amx:IND02976 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Rapid withdrawals of in-game currency or virtual items to external marketplaces or unregulated exchanges immediately after large in-game deposits."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02976" ;
    skos:prefLabel "IND02976"@en ;
    amlo:stixId "x-amltrix-indicator--5b6c1310-62af-4169-a442-5694a56ce228" .

amx:IND02977 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "In-game asset trades at inflated or manipulated prices with little to no gameplay activity supporting valuation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02977" ;
    skos:prefLabel "IND02977"@en ;
    amlo:stixId "x-amltrix-indicator--778d3c0a-6975-415b-b5ea-2d60839bba38" .

amx:IND02978 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Accounts with minimal legitimate gaming activity but high-frequency buying and selling of in-game currency or items in large volumes."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02978" ;
    skos:prefLabel "IND02978"@en ;
    amlo:stixId "x-amltrix-indicator--6346186a-29fd-4434-a7b2-80833ee30483" .

amx:IND02979 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "Clusters of related player accounts frequently transferring in-game currency amongst themselves, sharing common IP addresses or device fingerprints."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02979" ;
    skos:prefLabel "IND02979"@en ;
    amlo:stixId "x-amltrix-indicator--f6fddb89-5e5a-40ca-af41-fea1a8ca25c3" .

amx:IND02980 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.819109+00:00"^^xsd:dateTime ;
    skos:definition "High-volume cross-border in-game currency transactions involving jurisdictions known for lax AML regulations, without any clear gaming or business rationale."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02980" ;
    skos:prefLabel "IND02980"@en ;
    amlo:stixId "x-amltrix-indicator--4c9d1bff-652a-42c1-a72c-8410703a1586" .

amx:IND02981 a amlo:Indicator ;
