    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Repeated usage of the same crypto wallet address by multiple unrelated individuals at different crypto ATM terminals, indicating a funneling arrangement for aggregated illicit funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01242" ;
    skos:prefLabel "IND01242"@en ;
    amlo:stixId "x-amltrix-indicator--4347f33c-afc3-4ddd-9767-e605d313c2f9" .

