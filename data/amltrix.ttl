    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Submission of identification documents that display signs of forgery or tampering (e.g., unusual fonts, missing watermarks, altered holograms, mismatched formatting) during the account opening or due diligence process."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
