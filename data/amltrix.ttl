    dct:modified "2025-05-13T07:47:21.794970+00:00"^^xsd:dateTime ;
    skos:definition "A lack of a coherent business rationale or strategic alignment between the merging entities, suggesting no legitimate operational synergy from the M&A deal."@en ;
