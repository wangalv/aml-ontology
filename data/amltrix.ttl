    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or large transactions to or from jurisdictions associated with hawala networks, without legitimate business or personal ties."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01065" ;
    skos:prefLabel "IND01065"@en ;
    amlo:stixId "x-amltrix-indicator--6ac0757d-6cb5-4c42-8869-87118b9b753c" .

