    amlo:actor amx:AT0057 ;
    amlo:technique amx:T0014.002 .

<https://example.org/amltrix/link/3b673305-fc7e-404e-9d44-8412011998b7> a amlo:ProductServiceLink ;
    dct:description """- Users connect to DeFi protocols from unsecured public hotspots, layering multiple transactions to blur on-chain provenance.  
