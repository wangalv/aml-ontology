    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "A concentration of override decisions and expedited approvals by a small group of employees, particularly those with prior compliance issues or disciplinary actions."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
