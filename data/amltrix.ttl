    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Multiple individuals deposit small cash amounts into the same account at different ATMs, each remaining below reporting thresholds within short intervals."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01076" ;
    skos:prefLabel "IND01076"@en ;
    amlo:stixId "x-amltrix-indicator--b365670e-f054-44d6-a3c0-6803750ac321" .

