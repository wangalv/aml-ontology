    amlo:productService amx:PS0008 ;
    amlo:technique amx:T0015.003 .

<https://example.org/amltrix/link/3b709aff-37a8-446a-bd5a-ea15f02bb3fe> a amlo:RiskLink ;
    dct:description "Daigou networks primarily exploit mismatched regulatory regimes and capital controls across borders. By leveraging differences in AML enforcement and import restrictions between jurisdictions, they obscure beneficial ownership and conceal cross-border value transfers. This core cross-border vulnerability is central to their operations."@en ;
