    dct:modified "2025-05-13T07:47:21.799469+00:00"^^xsd:dateTime ;
    skos:definition "Material inconsistencies arise in a customer's profile when multiple sub-threshold transactions flow into ephemeral addresses rather than their declared, verified accounts."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01339" ;
    skos:prefLabel "IND01339"@en ;
    amlo:stixId "x-amltrix-indicator--9defeac8-066c-4b2a-8b7e-5d9be93e8387" .

