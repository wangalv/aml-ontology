    skos:definition "Digital accounts maintained on online gambling platforms, allowing users to deposit funds, engage in betting and gaming, and withdraw winnings. Recognized as a convenient means of storing and transferring value for recreational purposes."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IN0006" ;
    skos:prefLabel "Online Gambling Accounts"@en ;
