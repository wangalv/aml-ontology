    skos:notation "IND01790" ;
    skos:prefLabel "IND01790"@en ;
    amlo:stixId "x-amltrix-indicator--e3d9ee04-d368-471a-86a6-beeac4e4d7b2" .

amx:IND01791 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Invoking diplomatic immunity or official privileges to resist routine AML inquiries or audits beyond standard protocol requirements."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01791" ;
    skos:prefLabel "IND01791"@en ;
    amlo:stixId "x-amltrix-indicator--b5d27542-22f9-43d3-ab0d-202620a9f95d" .

amx:IND01792 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Use of multiple individuals traveling together, each carrying amounts of cash just below the declaration threshold."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01792" ;
    skos:prefLabel "IND01792"@en ;
    amlo:stixId "x-amltrix-indicator--e533ed00-8a61-4faa-97b0-bb5045a2397a" .

amx:IND01793 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Frequent changes to travel itineraries, including last-minute flight bookings or re-routing to avoid certain border crossings, particularly into or out of jurisdictions with weak AML controls."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01793" ;
    skos:prefLabel "IND01793"@en ;
    amlo:stixId "x-amltrix-indicator--b849ae4a-6c71-461a-90c4-be10e9c15328" .

amx:IND01794 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Involvement of individuals with a history of minor criminal offenses or financial difficulties, indicating vulnerability to recruitment as cash mules."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01794" ;
    skos:prefLabel "IND01794"@en ;
    amlo:stixId "x-amltrix-indicator--b608323f-780f-4426-840b-034b76e893ba" .

amx:IND01795 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Transactions where similar assets are sold at markedly different prices, indicating a non-standard, subjective pricing approach inconsistent with established market practices."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01795" ;
    skos:prefLabel "IND01795"@en ;
    amlo:stixId "x-amltrix-indicator--39415248-efe2-44fa-8755-473e1251141c" .

amx:IND01796 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or high-value currency exchange transactions that exceed the individual's known income or business activities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01796" ;
    skos:prefLabel "IND01796"@en ;
    amlo:stixId "x-amltrix-indicator--e658c42e-4821-415f-8269-79e050919a61" .

amx:IND01797 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Consistent use of specific border points known for lax enforcement or corruption issues."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01797" ;
    skos:prefLabel "IND01797"@en ;
    amlo:stixId "x-amltrix-indicator--55c42671-a8c4-4d78-96d4-b041353034eb" .

amx:IND01798 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.794427+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.794427+00:00"^^xsd:dateTime ;
    skos:definition "Connections to underground foreign exchange networks or informal value transfer systems."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01798" ;
    skos:prefLabel "IND01798"@en ;
    amlo:stixId "x-amltrix-indicator--935fa85a-2115-47aa-b1f2-d842109edb2d" .

amx:IND01799 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Reports of cash physically concealed in personal luggage or on the person."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01799" ;
    skos:prefLabel "IND01799"@en ;
    amlo:stixId "x-amltrix-indicator--1fd3d8af-19f1-4d27-8ae4-91e6660a6f29" .

amx:IND01800 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Individuals with no prior history of international travel who are now engaging in frequent cross-border trips."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01800" ;
    skos:prefLabel "IND01800"@en ;
    amlo:stixId "x-amltrix-indicator--7470a157-453c-48c3-a436-c5ee855aff70" .

amx:IND01801 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Travelers using indirect or circuitous routes that are not typical for their stated destination."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01801" ;
    skos:prefLabel "IND01801"@en ;
    amlo:stixId "x-amltrix-indicator--eb6d4070-0bae-4eee-88fa-7cc023892e04" .

amx:IND01802 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Discrepancies between the traveler's declared purpose of travel and their financial capacity or employment status."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01802" ;
    skos:prefLabel "IND01802"@en ;
    amlo:stixId "x-amltrix-indicator--081efb73-981c-4db7-aeec-944189790d96" .

amx:IND01803 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Travelers using multiple passports or identities to cross borders."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01803" ;
    skos:prefLabel "IND01803"@en ;
    amlo:stixId "x-amltrix-indicator--bee04ae5-4a1b-4de2-92b6-f2c5984c9217" .

amx:IND01804 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Abrupt or consistently waived customs inspections for travelers carrying substantial cash, suggesting potential collusion with border officials."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01804" ;
    skos:prefLabel "IND01804"@en ;
    amlo:stixId "x-amltrix-indicator--16d8bea6-d394-4da7-9aba-a0548f475a4f" .

amx:IND01805 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Asset transactions that show declared prices significantly deviating from recognized market benchmarks or industry standard valuations, such as artworks or luxury goods priced at multiples above or below typical market values."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01805" ;
    skos:prefLabel "IND01805"@en ;
    amlo:stixId "x-amltrix-indicator--4e90a988-4549-45a5-a39b-b6a433b83ff4" .

amx:IND01806 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Transactions where the asset’s value is based solely on seller or intermediary subjective assessments without any independent third-party appraisal or objective valuation documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01806" ;
    skos:prefLabel "IND01806"@en ;
    amlo:stixId "x-amltrix-indicator--a0cb3901-315a-414d-9a75-6ab3669cdb5c" .

amx:IND01807 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Repeated occurrences of price distortions in transactions involving high-value, intangible assets (e.g., art, luxury items) suggesting a deliberate pattern of inflating or deflating asset values."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01807" ;
    skos:prefLabel "IND01807"@en ;
    amlo:stixId "x-amltrix-indicator--00617160-91c2-4098-8e0e-452a8590de89" .

amx:IND01808 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Inconsistencies between the asset valuation stated in transaction documents and external indicators such as auction results or recognized appraisal reports."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01808" ;
    skos:prefLabel "IND01808"@en ;
    amlo:stixId "x-amltrix-indicator--8b1b8e8f-eb09-4f12-a474-2750b733e446" .

amx:IND01809 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Frequent, unexplained adjustments or revisions in asset values within a short period, lacking clear market-based justification, which may indicate opportunistic manipulation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01809" ;
    skos:prefLabel "IND01809"@en ;
    amlo:stixId "x-amltrix-indicator--fef031dc-ab8d-4b9b-ad83-1e8c805be782" .

amx:IND01810 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Inconsistent customer information provided during the chargeback process compared to previous records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01810" ;
    skos:prefLabel "IND01810"@en ;
    amlo:stixId "x-amltrix-indicator--6db313af-a5de-4406-8345-746738610a0f" .

amx:IND01811 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Recurring digital asset trades among related parties at artificially high or low prices, indicating wash trading or collusive manipulation of token or NFT valuations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01811" ;
    skos:prefLabel "IND01811"@en ;
    amlo:stixId "x-amltrix-indicator--905c9330-36a0-44cb-961e-ec1ad9b98166" .

amx:IND01812 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Entities with the same beneficial owners appear at multiple points in the commodity trade chain without a clear commercial rationale for shared control."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01812" ;
    skos:prefLabel "IND01812"@en ;
    amlo:stixId "x-amltrix-indicator--36286068-8552-4314-b1c3-f3bf228b3db4" .

amx:IND01813 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Use of multiple layers of intermediary companies in high-risk or offshore jurisdictions to handle a single commodity transaction, lacking transparent economic purpose."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01813" ;
    skos:prefLabel "IND01813"@en ;
    amlo:stixId "x-amltrix-indicator--ea169a3a-64e6-4e20-8ecc-105d6036a945" .

amx:IND01814 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Repeated amendments to declared quantities on trade documents, resulting in discrepancies between initial purchase orders and final shipment details."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01814" ;
    skos:prefLabel "IND01814"@en ;
    amlo:stixId "x-amltrix-indicator--bfa25d8e-7f7d-4e9f-9d88-2cc872ba39c9" .

amx:IND01815 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Payments for commodity trades made by or received from third parties not listed on official shipping or contract documentation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01815" ;
    skos:prefLabel "IND01815"@en ;
    amlo:stixId "x-amltrix-indicator--b51e503d-b0f6-4c40-9c3d-70818af0795c" .

amx:IND01816 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Frequent or last-minute amendments to letters of credit or other trade finance instruments with no credible explanation, particularly altering commodity type, quantity, or routing details."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01816" ;
    skos:prefLabel "IND01816"@en ;
    amlo:stixId "x-amltrix-indicator--fee28695-4c5b-4a83-8529-8b4cba4e696e" .

amx:IND01817 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Frequent reconfiguration of ultimate beneficial ownership through multiple entities without documented business rationale for the changes."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01817" ;
    skos:prefLabel "IND01817"@en ;
    amlo:stixId "x-amltrix-indicator--15a4276d-526b-41b7-a3f5-eafe119aacf5" .

amx:IND01818 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Frequent inter-company transactions among multiple layered subsidiaries or affiliated companies lacking clear economic justification, used to obscure the original source or final destination of funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01818" ;
    skos:prefLabel "IND01818"@en ;
    amlo:stixId "x-amltrix-indicator--fc0956a4-1994-4d7e-8133-39a819ebc440" .

amx:IND01819 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Routing of shipments through free trade zones known for lax enforcement or incomplete documentation, lacking legitimate business reasons for such detours."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01819" ;
    skos:prefLabel "IND01819"@en ;
    amlo:stixId "x-amltrix-indicator--9a5e9493-2267-4460-bc6a-25a1484abe00" .

amx:IND01820 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Company registered in a jurisdiction with limited corporate disclosure requirements yet conducting the majority of its transactions in higher-regulation markets."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01820" ;
    skos:prefLabel "IND01820"@en ;
    amlo:stixId "x-amltrix-indicator--4b3b07c3-a6e8-454b-88eb-50e5fd898a43" .

amx:IND01821 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Repeated formation and dissolution of related corporate entities within short periods, with no clear documentation of legitimate business transitions in corporate records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01821" ;
    skos:prefLabel "IND01821"@en ;
    amlo:stixId "x-amltrix-indicator--7f66f214-8a03-4848-9ddf-437284d61f8d" .

amx:IND01822 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Frequent use of inflated or falsified invoices among affiliated corporate entities, without corresponding delivery of goods or services."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01822" ;
    skos:prefLabel "IND01822"@en ;
    amlo:stixId "x-amltrix-indicator--3acf3ce9-b7ee-45dc-a777-d0af91bb8bbf" .

amx:IND01823 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "Significant or frequent revisions to financial statements reflecting manipulated fair value assessments, lacking independent or objective support."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01823" ;
    skos:prefLabel "IND01823"@en ;
    amlo:stixId "x-amltrix-indicator--d08a1c0f-5608-41c3-b1d7-9bb1a122d3ae" .

amx:IND01824 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "The entity repeatedly promotes guaranteed or significantly above-market returns in marketing materials without providing independently verifiable performance reports."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01824" ;
    skos:prefLabel "IND01824"@en ;
    amlo:stixId "x-amltrix-indicator--5228fa47-08be-4a0b-8c3d-74932e53e7e8" .

amx:IND01825 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "The purported investment firm is not listed or registered with regulatory agencies despite soliciting funds from the public."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01825" ;
    skos:prefLabel "IND01825"@en ;
    amlo:stixId "x-amltrix-indicator--a249c78b-ea74-4533-aab4-934781a66dc6" .

amx:IND01826 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.805833+00:00"^^xsd:dateTime ;
    skos:definition "The same beneficial owner controls several entities offering nearly identical investment opportunities under different brand names without clear business justification."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01826" ;
    skos:prefLabel "IND01826"@en ;
    amlo:stixId "x-amltrix-indicator--e0f75fff-535e-43c4-995f-dcebb9ee816d" .

