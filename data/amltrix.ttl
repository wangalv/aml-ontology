    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Repeated attempts by a customer to alter or update personal identity details after account opening, potentially indicating efforts to obfuscate their true identity."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
