<https://example.org/amltrix/link/3153124d-5f66-4eb3-ba3d-053210a20be0> a amlo:MitigationLink ;
    dct:description "Implement focused scenario-based and rules-driven monitoring for complex inter-company transactions spanning layered corporate entities. Pay special attention to circular fund flows, repeated re-routing of funds to the same ultimate beneficiaries, and transaction volumes or frequencies that deviate from stated business profiles. Escalate any unusual layering patterns for further investigative review."@en ;
    amlo:mitigation amx:M0004 ;
