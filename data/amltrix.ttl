    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Discrepancies between declared business activities and the actual flow of funds, where money derived from cryptojacking activities is integrated into financial accounts without a clear operational purpose."@en ;
