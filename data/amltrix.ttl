    amlo:productService amx:PS0075 ;
    amlo:technique amx:T0016 .

<https://example.org/amltrix/link/b49322b5-4d68-4b27-92be-3e617829ad39> a amlo:RiskLink ;
    dct:description "Offenders misrepresent themselves as charitable or nonprofit entities, funneling proceeds into personal or newly opened bank accounts with no legitimate nonprofit affiliation. By obscuring their true identities and the genuine nature of these accounts, criminals exploit vulnerabilities in customer onboarding and monitoring. This hinders the ability of financial institutions to detect suspicious activity tied to fraudulent fundraising."@en ;
    amlo:riskType amx:RS0001 ;
