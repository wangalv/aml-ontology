    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Detected alterations, irregularities, or signs of forgery in documentation prepared by professional intermediaries, such as contracts, incorporation documents, or notarized papers."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
