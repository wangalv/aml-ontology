    dct:modified "2025-05-13T07:47:21.796579+00:00"^^xsd:dateTime ;
    skos:definition "Intermediaries operating from or connected to high-risk or non-cooperative jurisdictions flagged by due diligence checks."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01082" ;
    skos:prefLabel "IND01082"@en ;
    amlo:stixId "x-amltrix-indicator--6b8312fc-6d92-4f49-a4f0-afeab18dc7f8" .

