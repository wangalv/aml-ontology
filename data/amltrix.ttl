    dct:modified "2025-05-13T07:47:21.797118+00:00"^^xsd:dateTime ;
    skos:definition "Multiple sequential transactions rapidly moving funds in and out of accounts, fragmenting the funds’ flow and obscuring their origin, consistent with layering tactics in money mule operations."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01113" ;
    skos:prefLabel "IND01113"@en ;
    amlo:stixId "x-amltrix-indicator--a0025539-5780-459e-8416-9030887eff98" .

