    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "The originating wallet initiates a high frequency of micro-transfers to numerous newly generated addresses within a short timeframe."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01030" ;
    skos:prefLabel "IND01030"@en ;
    amlo:stixId "x-amltrix-indicator--4911d47b-498e-4e3d-8820-120916b65570" .

