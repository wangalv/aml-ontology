    skos:definition "Use of complex cross-border or offshore private equity or real estate investment vehicles in jurisdictions with minimal beneficial ownership disclosure to direct investments into the business."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02502" ;
    skos:prefLabel "IND02502"@en ;
    amlo:stixId "x-amltrix-indicator--8094b94e-1338-4a75-9ed8-9db95f64333d" .

