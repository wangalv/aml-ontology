    dct:modified "2025-05-13T07:47:21.809702+00:00"^^xsd:dateTime ;
    skos:definition "An unusually high volume or frequency of currency conversion transactions that is inconsistent with the customer's documented financial profile or declared business activities."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02138" ;
    skos:prefLabel "IND02138"@en ;
    amlo:stixId "x-amltrix-indicator--74ec92a9-dfa4-4e36-9ecc-807dbe901837" .

