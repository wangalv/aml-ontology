    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Multiple mules exhibiting similar transaction timings and amounts, indicating central orchestration in the use of crypto ATMs to move illicit funds into crypto wallets."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01241" ;
    skos:prefLabel "IND01241"@en ;
    amlo:stixId "x-amltrix-indicator--dad0dc5d-35c7-4e96-9464-4adac72ff721" .

