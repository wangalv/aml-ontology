    dct:modified "2025-05-13T07:47:21.817364+00:00"^^xsd:dateTime ;
    skos:definition "A customer with minimal prior trading experience abruptly initiates frequent, high-value securities transactions timed around internal corporate events of their employer or associated entity."@en ;
