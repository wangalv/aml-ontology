    dct:modified "2025-05-13T07:47:21.816822+00:00"^^xsd:dateTime ;
    skos:definition "Large-volume trades in a specific company's stock immediately preceding material, market-moving announcements, followed by rapid liquidation of those positions post-announcement."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
