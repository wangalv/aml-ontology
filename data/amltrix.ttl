    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02397" ;
    skos:prefLabel "IND02397"@en ;
    amlo:stixId "x-amltrix-indicator--2a2b1493-a743-48c9-b6b5-1e3f7af4b2a5" .

