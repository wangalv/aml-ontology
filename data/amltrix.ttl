    dct:modified "2025-05-13T07:47:21.794970+00:00"^^xsd:dateTime ;
    skos:definition "Immediate layering of funds post-merger/acquisition, characterized by swift transfers through multiple accounts with no discernible commercial purpose."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
