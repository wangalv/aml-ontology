    dct:created "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Recently established jewelry business with minimal or unverifiable physical premises or inventory records."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02589" ;
    skos:prefLabel "IND02589"@en ;
    amlo:stixId "x-amltrix-indicator--a13adc9f-9947-47a4-a787-9e968dac0be2" .

