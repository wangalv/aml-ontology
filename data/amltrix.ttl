    dct:modified "2025-05-13T07:47:21.798290+00:00"^^xsd:dateTime ;
    skos:definition "Use of multiple trusts or private interest foundations in different secretive jurisdictions to hold a single high-value asset, making it difficult to determine the ultimate beneficial owner."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01204" ;
    skos:prefLabel "IND01204"@en ;
    amlo:stixId "x-amltrix-indicator--204f9bc9-9009-4496-a626-6257e4de0a98" .

