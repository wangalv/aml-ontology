    skos:definition "Involvement of goods or services that are difficult to value or verify, such as intellectual property or consulting services."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02605" ;
    skos:prefLabel "IND02605"@en ;
