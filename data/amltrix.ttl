    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02562" ;
    skos:prefLabel "IND02562"@en ;
    amlo:stixId "x-amltrix-indicator--824dbf0c-5aad-449e-9558-1a2e7283791d" .

