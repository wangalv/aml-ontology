    dct:modified "2025-05-13T07:47:21.809087+00:00"^^xsd:dateTime ;
    skos:definition "Employee repeatedly alters or backdates officially submitted expense reports, resulting in increased reimbursement amounts."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
