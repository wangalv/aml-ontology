    dct:modified "2025-05-13T07:47:21.810329+00:00"^^xsd:dateTime ;
    skos:definition "Transactions accompanied by inconsistent or insufficient documentation regarding the purpose and beneficiary details, particularly when offshore entities are involved."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02211" ;
    skos:prefLabel "IND02211"@en ;
    amlo:stixId "x-amltrix-indicator--586c05cb-d764-4dbb-82e2-064a1799c816" .

