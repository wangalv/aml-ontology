    dct:modified "2025-05-13T07:47:21.816822+00:00"^^xsd:dateTime ;
    skos:definition "Relief funds are rapidly transferred to unrelated accounts or offshore jurisdictions shortly after receipt, with no logical economic explanation."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02770" ;
    skos:prefLabel "IND02770"@en ;
    amlo:stixId "x-amltrix-indicator--257d7565-64cc-441c-9e43-dfe149ee7f97" .

