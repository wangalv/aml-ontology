    skos:definition "Frequent trade transactions with jurisdictions known for weak regulatory oversight or high levels of financial secrecy."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02600" ;
    skos:prefLabel "IND02600"@en ;
    amlo:stixId "x-amltrix-indicator--259a2a76-12f7-4b67-acad-ef87d7e4a83c" .

