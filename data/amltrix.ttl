    dct:modified "2025-05-13T07:47:21.816822+00:00"^^xsd:dateTime ;
    skos:definition "Multiple applications for relief funds across various shell or newly formed entities all traced back to the same ultimate beneficial owner."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02769" ;
    skos:prefLabel "IND02769"@en ;
    amlo:stixId "x-amltrix-indicator--086f138a-767f-42b8-8a77-5660f23343e5" .

