    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Suspicious cryptocurrency activity begins immediately following a publicly reported crypto exchange hack or large-scale theft incident."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01025" ;
    skos:prefLabel "IND01025"@en ;
    amlo:stixId "x-amltrix-indicator--4c569e9d-1799-4096-9813-4a2e4e98b245" .

amx:IND01026 a amlo:Indicator ;
    dct:created "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.796043+00:00"^^xsd:dateTime ;
    skos:definition "Transaction records show continuous transfers to newly generated addresses, with no address re-use, indicating systematic layering of funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01026" ;
    skos:prefLabel "IND01026"@en ;
    amlo:stixId "x-amltrix-indicator--f217beb3-a674-4f1c-a2e0-414f647a7560" .

