    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Absence or breakdown of mandatory internal controls, audits, or segregation of duties in government financial operations, enabling potential diversion of public funds."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02542" ;
    skos:prefLabel "IND02542"@en ;
    amlo:stixId "x-amltrix-indicator--8c87f39d-4873-4de2-a3a1-82d1b965bb39" .

