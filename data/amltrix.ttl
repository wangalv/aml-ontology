    dct:modified "2025-05-13T07:47:21.813861+00:00"^^xsd:dateTime ;
    skos:definition "Accounts appear to be controlled by third parties across diverse regions, with coerced or forced depositors providing funds followed by immediate withdrawals."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02530" ;
    skos:prefLabel "IND02530"@en ;
    amlo:stixId "x-amltrix-indicator--ada34331-36e7-4cd3-be02-17b0ff1036cf" .

