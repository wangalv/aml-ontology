    dct:modified "2025-05-13T07:47:21.798877+00:00"^^xsd:dateTime ;
    skos:definition "Use of multiple custodial platforms or decentralized exchanges with lax AML controls when conducting wrapped token transactions, indicating exploitation of regulatory gaps."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01246" ;
    skos:prefLabel "IND01246"@en ;
    amlo:stixId "x-amltrix-indicator--70fc8878-21be-4341-99d2-7966382f040e" .

