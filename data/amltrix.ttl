<https://example.org/amltrix/link/31482b57-2cb7-4d9b-a875-5d67c5157f56> a amlo:ProductServiceLink ;
    dct:description """- Traffickers employ wire transfers, sometimes layering funds through intermediary banks and fictitious recipients, to move large sums across borders.  
