    dct:modified "2025-05-13T07:47:21.800065+00:00"^^xsd:dateTime ;
    skos:definition "Multiple sub-agents operate from addresses or premises not recorded in official registration or licensing documents."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02130" ;
    skos:prefLabel "IND02130"@en ;
    amlo:stixId "x-amltrix-indicator--82efe400-07e9-49ef-8b73-1e0df057b4ef" .

