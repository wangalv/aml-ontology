        amx:T0134.001,
        amx:T0141,
        amx:T0144.013 ;
    amlo:shortDescription "Stablecoins, which are pegged to fiat currencies or commodities for reduced volatility, enable convenient cross-border transactions and everyday usage, but may also pose AML/CFT risks when used to obscure the origin or destination of funds if proper regulatory oversight is lacking."@en ;
    amlo:stixId "value-instruments--78617827-8e66-48fe-b699-2e7e2b55f8f9" .

