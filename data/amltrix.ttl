    dct:created "2025-05-13T07:47:21.793333+00:00"^^xsd:dateTime ;
    dct:modified "2025-05-13T07:47:21.793333+00:00"^^xsd:dateTime ;
    skos:definition "Rapid outbound transfers from recently opened personal accounts to external institutions or cryptoasset exchanges, reflecting early-stage money mule placement and integration."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND01112" ;
    skos:prefLabel "IND01112"@en ;
    amlo:stixId "x-amltrix-indicator--22daade9-6f8e-4eed-90ea-e481fa43a1ec" .

