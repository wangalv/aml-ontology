    dct:modified "2025-05-13T07:47:21.814377+00:00"^^xsd:dateTime ;
    skos:definition "Frequent use of intermediary companies by bidders to conceal true ownership and facilitate illicit fund flows."@en ;
    skos:inScheme <https://example.org/amltrix/scheme/amltrix-ml> ;
    skos:notation "IND02569" ;
    skos:prefLabel "IND02569"@en ;
    amlo:stixId "x-amltrix-indicator--590d48b1-fe73-41ff-8d13-9c6322c8675e" .

