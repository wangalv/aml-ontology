    amlo:productService amx:PS0111 ;
    amlo:technique amx:T0015.001 .

<https://example.org/amltrix/link/6897c769-8f54-48b9-810f-7d36d387d80f> a amlo:DataSourceLink ;
    dct:description """- Provides official corporate registration data, including shareholders, directors, and beneficial ownership details.
